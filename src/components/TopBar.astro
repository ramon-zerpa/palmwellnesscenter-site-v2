---
import type { Lang } from "../i18n/ui";
import { useTranslations, getAltUrl, PHONE_TEL } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const altUrl = getAltUrl(Astro.url.pathname, lang);
const altLabel = lang === "en" ? "Español" : "English";

const ic = "h-3.5 w-3.5 shrink-0";
---

<div class="bg-blue-deep">
  <div class="container flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-2 text-[12.5px] text-blue-tint">
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-1">
      <li class="flex items-center gap-1.5">
        <svg class={ic} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>{t("top.address")}</span>
      </li>
      <li class="hidden items-center gap-1.5 sm:flex">
        <svg class={ic} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>{t("top.hours").replace(/\n/g, " · ")}</span>
      </li>
    </ul>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
      <span class="hidden items-center gap-1.5 lg:flex">
        <svg class={ic} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>{t("top.licenses")}</span>
      </span>
      <a href={altUrl} class="flex items-center gap-1.5 text-blue-tint transition-colors hover:text-white" hreflang={lang === "en" ? "es" : "en"}>
        <strong class="font-bold text-white">{lang === "en" ? "EN" : "ES"}</strong>
        <span aria-hidden="true">/</span>
        <span>{altLabel}</span>
      </a>
      <a href={PHONE_TEL} class="flex items-center gap-1.5 font-semibold text-white transition-colors hover:text-blue-tint">
        <svg class={ic} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{t("cta.phone")}</span>
      </a>
    </div>
  </div>
</div>
