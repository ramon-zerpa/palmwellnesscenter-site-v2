---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const ic = "h-3.5 w-3.5 shrink-0";
---

<div class="bg-blue-deep">
  <div class="shell flex items-center justify-center py-2 text-center text-[12.5px] text-blue-tint xl:grid xl:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] xl:gap-4 xl:text-left">
    <span class="flex items-center justify-center gap-1.5 xl:justify-self-start">
      <Icon name="map-pin" class={ic} />
      <span>{t("top.address")}</span>
    </span>
    <span class="hidden items-center justify-center gap-1.5 xl:flex xl:justify-self-center">
      <Icon name="clock" class={ic} />
      <span>{t("top.hours").replace(/\n/g, " · ")}</span>
    </span>
    <span class="hidden items-center justify-center gap-1.5 xl:flex xl:justify-self-end">
      <Icon name="shield-check" class={ic} />
      <span>{t("top.licenses")}</span>
    </span>
  </div>
</div>
