---
import Icon from "./Icon.astro";
export interface Block { t: string; text?: string; html?: string; items?: any[]; buttons?: any[]; src?: string; alt?: string; rows?: string[][]; embed?: string; title?: string; }
interface Props { blocks: Block[]; }
const { blocks } = Astro.props;

function btnClass(kind: string) {
  if (kind === "phone") return "inline-flex items-center gap-2 rounded-full border-2 border-blue px-6 py-2.5 font-bold text-blue transition-colors hover:bg-blue hover:text-white";
  return "inline-flex items-center gap-2 rounded-full bg-green px-6 py-3 font-bold text-white transition-colors hover:bg-green-dark";
}
---
{blocks.map((b) => {
  if (b.t === "p") return <p class="leading-relaxed text-body [&_a]:underline [&_a]:underline-offset-2" set:html={b.html} />;
  if (b.t === "h3") return <h3 class="mt-6 text-xl text-blue">{b.text}</h3>;
  if (b.t === "h4") return <h4 class="mt-4 text-lg text-blue">{b.text}</h4>;
  if (b.t === "ul") return (
    <ul class="space-y-2">
      {b.items!.map((it: string) => (
        <li class="flex items-start gap-2.5 text-[15px] text-body"><span class="mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-green/15 text-green"><Icon name="check" class="h-3 w-3" /></span><span class="[&_a]:underline [&_a]:underline-offset-2" set:html={it} /></li>
      ))}
    </ul>
  );
  if (b.t === "ol") return (
    <ol class="ml-5 list-decimal space-y-2 text-[15px] text-body marker:font-bold marker:text-blue">
      {b.items!.map((it: string) => <li class="[&_a]:underline [&_a]:underline-offset-2" set:html={it} />)}
    </ol>
  );
  if (b.t === "badges") return (
    <div class="grid gap-x-6 gap-y-2.5 sm:grid-cols-2">
      {b.items!.map((it: string) => (
        <span class="flex items-start gap-2.5 text-[15px] text-body"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-green" />{it}</span>
      ))}
    </div>
  );
  if (b.t === "img") return <img src={b.src} alt={b.alt} width="900" height="500" loading="lazy" decoding="async" class="w-full rounded-lg object-cover" />;
  if (b.t === "cta") return (
    <div class="rich-cta flex flex-wrap items-center gap-3 pt-2">
      {b.buttons!.map((bn: any) => (
        <a href={bn.href} target={bn.href.startsWith("http") ? "_blank" : undefined} rel={bn.href.startsWith("http") ? "noopener" : undefined} class={btnClass(bn.kind)}>
          {bn.kind === "phone" && <Icon name="phone" class="h-4 w-4" />}{bn.label}
        </a>
      ))}
    </div>
  );
  if (b.t === "table" && b.rows && b.rows.length) return (
    <div class="overflow-x-auto rounded-lg border border-line bg-white shadow-[0_8px_20px_rgba(42,103,177,0.08)]">
      <table class="w-full border-collapse text-left text-[15px]">
        <thead><tr>{b.rows[0].map((c: string) => <th class="border-b border-line bg-blue/10 px-5 py-3 font-semibold text-blue [&_a]:underline [&_a]:underline-offset-2" set:html={c} />)}</tr></thead>
        <tbody>{b.rows.slice(1).map((row: string[], i: number) => <tr class={i % 2 === 0 ? "bg-white" : "bg-bg-alt/55"}>{row.map((c: string) => <td class="border-t border-line/70 px-5 py-3 align-top text-body [&_a]:underline [&_a]:underline-offset-2" set:html={c} />)}</tr>)}</tbody>
      </table>
    </div>
  );
  if (b.t === "embed" && b.embed) return (
    <div class="aspect-[4/3] w-full overflow-hidden rounded-lg border border-line shadow-sm sm:aspect-video [&>div]:h-full [&_iframe]:block [&_iframe]:h-full [&_iframe]:w-full">
      <div set:html={b.embed}></div>
    </div>
  );
  return null;
})}
