---
// Legacy entry point: interior rich pages still pass Font Awesome names
// ("user-md", "check-square-o", "heartbeat", …). They are resolved through the
// alias table in src/lib/lucide.ts, so everything renders from the one Lucide
// family. New code should import Icon directly.
import Icon from "./Icon.astro";

interface Props { name: string; class?: string; }
const { name, class: cls = "h-5 w-5" } = Astro.props;
---
<Icon name={name} class={cls} />
