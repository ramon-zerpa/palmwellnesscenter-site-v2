---
import type { Lang } from "../i18n/ui";
import { APPOINTMENT_URL, PHONE_TEL } from "../i18n/utils";
import Icon from "./Icon.astro";
import type { ServiceContent } from "../data/servicePages";

interface Props { lang: Lang; content: ServiceContent; }
const { lang, content: c } = Astro.props;
const bookLabel = lang === "es" ? "Reservar cita" : "Book Appointment";
const bookAttrs = { target: "_blank", rel: "noopener" } as const;
---

<!-- HERO -->
<section class="bg-bg-alt">
  <div class="container grid items-center gap-10 py-14 lg:grid-cols-2 lg:py-20">
    <div class="flex flex-col items-start gap-5">
      <span class="inline-flex rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{c.hero.eyebrow}</span>
      <h1 class="text-4xl leading-[1.1] text-ink sm:text-5xl">{c.hero.title}</h1>
      <p class="max-w-xl text-[18px] leading-relaxed text-body">{c.hero.lead}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {c.hero.badges.map((b) => (
          <li class="flex items-center gap-2 text-[14px] font-semibold text-ink">
            <span class="grid h-[30px] w-[30px] shrink-0 place-items-center rounded-full bg-blue-pale text-blue-deep"><Icon name="badge-check" class="h-4 w-4" /></span>
            {b}
          </li>
        ))}
      </ul>
      <div class="flex flex-wrap gap-3">
        <a href={APPOINTMENT_URL} {...bookAttrs} class="inline-flex items-center gap-2 rounded-md bg-blue px-6 py-3.5 font-bold text-white transition-colors hover:bg-blue-deep">
          <Icon name="calendar-check" class="h-[18px] w-[18px]" />{bookLabel}
        </a>
        <a href={PHONE_TEL} class="inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue bg-white px-6 py-3.5 font-bold text-blue transition-colors hover:bg-blue-pale">
          <Icon name="phone" class="h-[18px] w-[18px]" />(813) 443-5370
        </a>
      </div>
      <p class="text-[13px] text-muted">{c.hero.note}</p>
    </div>
    <div>
      <img src={c.hero.image} width="560" height="440" alt={c.hero.imageAlt} fetchpriority="high" decoding="async" class="h-full max-h-[460px] w-full rounded-lg object-cover" />
    </div>
  </div>
</section>

<!-- INTRO -->
<section class="bg-white">
  <div class="container flex flex-col items-center py-16">
    <div class="flex max-w-[820px] flex-col gap-4">
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{c.intro.heading}</h2>
      {c.intro.paras.map((p) => <p class="text-[17px] leading-relaxed text-body">{p}</p>)}
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="bg-bg-alt">
  <div class="container flex flex-col items-center gap-11 py-16">
    <div class="flex max-w-[760px] flex-col items-center gap-3 text-center">
      <span class="rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{c.services.eyebrow}</span>
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{c.services.title}</h2>
      <p class="text-[17px] leading-relaxed text-body">{c.services.lead}</p>
    </div>
    <div class="grid w-full gap-6 md:grid-cols-2 lg:grid-cols-3">
      {c.services.cards.map((s) => (
        <article class="flex flex-col gap-4 rounded-lg border border-line bg-white p-7">
          <span class="grid h-[52px] w-[52px] place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={s.icon} class="h-7 w-7" /></span>
          <h3 class="text-[22px] text-ink">{s.title}</h3>
          <p class="text-[15px] leading-relaxed text-body">{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- PROGRAM -->
<section class="bg-white">
  <div class="container grid items-center gap-12 py-16 lg:grid-cols-2">
    <div class="flex flex-col items-start gap-4">
      <span class="rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{c.program.eyebrow}</span>
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{c.program.title}</h2>
      <p class="text-[17px] leading-relaxed text-body">{c.program.body}</p>
      <p class="text-[13px] leading-relaxed text-muted">{c.program.note}</p>
    </div>
    <article class="flex flex-col gap-5 rounded-lg border border-blue-deep bg-blue-deep p-8 text-blue-tint">
      <p class="flex items-end gap-2 text-blue-tint">
        <strong class="text-[44px] leading-none text-white">{c.program.price}</strong>
        <span class="text-[15px] pb-1">{c.program.cadence}</span>
      </p>
      <ul class="grid gap-3 text-[14px] sm:grid-cols-2">
        {c.program.bullets.map((b) => (
          <li class="flex items-start gap-2.5">
            <Icon name="check" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-green-bright" />{b}
          </li>
        ))}
      </ul>
      <a href={APPOINTMENT_URL} {...bookAttrs} class="inline-flex items-center justify-center gap-2 rounded-md bg-white px-5 py-3 text-[15px] font-bold text-blue-deep transition-colors hover:bg-blue-pale">
        <Icon name="calendar-check" class="h-[18px] w-[18px]" />{bookLabel}
      </a>
    </article>
  </div>
</section>

<!-- INTEGRATED -->
<section class="bg-bg-alt">
  <div class="container flex flex-col items-center gap-11 py-16">
    <div class="flex max-w-[760px] flex-col items-center gap-3 text-center">
      <span class="rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{c.integrated.eyebrow}</span>
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{c.integrated.title}</h2>
      <p class="text-[17px] leading-relaxed text-body">{c.integrated.lead}</p>
    </div>
    <div class="grid w-full gap-6 md:grid-cols-2 lg:grid-cols-3">
      {c.integrated.cards.map((s) => (
        <article class="flex flex-col gap-4 rounded-lg border border-line bg-white p-7">
          <span class="grid h-[52px] w-[52px] place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={s.icon} class="h-7 w-7" /></span>
          <h3 class="text-[22px] text-ink">{s.title}</h3>
          <p class="text-[15px] leading-relaxed text-body">{s.body}</p>
          {s.href && (
            <a href={s.href} aria-label={`${lang === "es" ? "Ver más sobre" : "Learn more about"} ${s.title}`} class="mt-auto inline-flex items-center gap-1.5 text-[14px] font-bold text-blue hover:text-blue-deep">
              {lang === "es" ? "Ver más sobre" : "Learn more about"} {s.title} <Icon name="arrow" class="h-4 w-4" />
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<!-- WHY -->
<section class="bg-white">
  <div class="container grid items-center gap-12 py-16 lg:grid-cols-2">
    <img src="/images/why-integrated-care-matters.webp" width="560" height="460" alt={c.why.title} loading="lazy" decoding="async" class="h-full max-h-[480px] w-full rounded-lg object-cover" />
    <div class="flex flex-col items-start gap-5">
      <span class="rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{c.why.eyebrow}</span>
      <h2 class="text-3xl text-ink sm:text-[2rem]">{c.why.title}</h2>
      <p class="text-[16px] leading-relaxed text-body">{c.why.lead}</p>
      <ul class="flex flex-col gap-5">
        {c.why.features.map((f) => (
          <li class="flex items-start gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={f.icon} class="h-6 w-6" /></span>
            <span>
              <strong class="block text-[18px] text-ink">{f.title}</strong>
              <span class="block text-[15px] text-body">{f.body}</span>
            </span>
          </li>
        ))}
      </ul>
      <ul class="mt-1 flex flex-wrap gap-2.5">
        {c.why.points.map((p) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-bg-alt px-3.5 py-2 text-[13.5px] font-medium text-ink">
            <Icon name="check" class="h-4 w-4 text-green-dark" />{p}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- TEAM -->
<section class="bg-bg-alt">
  <div class="container flex flex-col items-center gap-11 py-16">
    <div class="flex max-w-[760px] flex-col items-center gap-3 text-center">
      <span class="rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{c.team.eyebrow}</span>
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{c.team.title}</h2>
      <p class="text-[17px] leading-relaxed text-body">{c.team.lead}</p>
    </div>
    <div class="grid w-full max-w-[900px] gap-6 md:grid-cols-2">
      {c.team.members.map((m) => (
        <article class="flex flex-col items-center gap-3 rounded-lg border border-line bg-white p-7 text-center">
          <span class="grid h-[76px] w-[76px] place-items-center rounded-full bg-blue-pale text-[26px] font-bold text-blue-deep">{m.name.charAt(0)}</span>
          <h3 class="text-[19px] text-ink">{m.name}</h3>
          <p class="text-[13px] font-semibold text-blue">{m.cred}</p>
          <p class="text-[14px] text-body">{m.bio}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- STEPS -->
<section class="bg-white">
  <div class="container flex flex-col items-center gap-11 py-16">
    <div class="flex max-w-[760px] flex-col items-center gap-3 text-center">
      <span class="rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{c.steps.eyebrow}</span>
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{c.steps.title}</h2>
    </div>
    <div class="grid w-full gap-6 md:grid-cols-3">
      {c.steps.items.map((s, i) => (
        <article class="flex flex-col gap-4 rounded-lg border border-line bg-bg-alt p-7">
          <span class="grid h-11 w-11 place-items-center rounded-full bg-blue text-[18px] font-bold text-white">{i + 1}</span>
          <h3 class="text-[20px] text-ink">{s.title}</h3>
          <p class="text-[15px] leading-relaxed text-body">{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="bg-bg-alt">
  <div class="container flex flex-col items-center gap-10 py-16">
    <div class="flex flex-col items-center gap-3 text-center">
      <span class="rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{c.faq.eyebrow}</span>
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{c.faq.title}</h2>
    </div>
    <div class="flex w-full max-w-[900px] flex-col gap-3">
      {c.faq.items.map((item) => (
        <details class="group rounded-md bg-white">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-[17px] font-semibold text-ink">
            <span>{item.q}</span>
            <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-blue transition-transform group-open:rotate-180" />
          </summary>
          <p class="px-6 pb-5 text-body">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- SERVICE AREA -->
<section class="bg-white">
  <div class="container flex flex-col items-center gap-10 py-16">
    <div class="flex max-w-[760px] flex-col items-center gap-3 text-center">
      <span class="rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{c.area.eyebrow}</span>
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{c.area.title}</h2>
      <p class="text-[17px] leading-relaxed text-body">{c.area.lead}</p>
    </div>
    <ul class="flex flex-wrap justify-center gap-3.5">
      {c.area.places.map((p) => (
        <li class="inline-flex items-center gap-2 rounded-full border border-line bg-bg-alt px-4 py-2.5 text-[15px] font-medium text-ink">
          <Icon name="map-pin" class="h-4 w-4 text-blue" />{p}
        </li>
      ))}
    </ul>
    <div class="grid w-full max-w-[1100px] items-center overflow-hidden rounded-lg bg-bg-alt lg:grid-cols-[400px_1fr]">
      <img src="/images/car-transportation-assistance.webp" width="400" height="250" alt={c.area.transportAlt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
      <div class="flex flex-col gap-3 p-8">
        <h3 class="text-[22px] text-ink">{c.area.transportTitle}</h3>
        <p class="text-[15px] leading-relaxed text-body">{c.area.transportBody}</p>
      </div>
    </div>
  </div>
</section>

<!-- RELATED -->
<section class="bg-bg-alt">
  <div class="container flex flex-col items-center gap-8 py-14">
    <h2 class="text-[22px] text-ink">{c.related.title}</h2>
    <ul class="flex flex-wrap justify-center gap-3">
      {c.related.links.map((l) => (
        <li>
          <a href={l.href} class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2.5 text-[15px] font-semibold text-blue transition-colors hover:bg-blue-pale hover:text-blue-deep">
            {l.label} <Icon name="arrow" class="h-4 w-4" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- FINAL CTA -->
<section class="bg-blue-deep">
  <div class="container flex flex-col items-center gap-4 py-16 text-center">
    <h2 class="max-w-[800px] text-3xl text-white sm:text-[2.1rem]">{c.cta.title}</h2>
    <p class="max-w-[640px] text-[17px] leading-relaxed text-blue-tint">{c.cta.lead}</p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      <a href={APPOINTMENT_URL} {...bookAttrs} class="inline-flex items-center gap-2 rounded-md bg-white px-7 py-3.5 font-bold text-blue-deep transition-colors hover:bg-blue-pale">
        <Icon name="calendar-check" class="h-[18px] w-[18px]" />{bookLabel}
      </a>
      <a href={PHONE_TEL} class="inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue-tint px-6 py-3.5 font-bold text-white transition-colors hover:bg-white/10">
        <Icon name="phone" class="h-[18px] w-[18px]" />(813) 443-5370
      </a>
    </div>
  </div>
</section>
