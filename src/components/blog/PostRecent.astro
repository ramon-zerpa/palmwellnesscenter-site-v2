---
import Icon from "../Icon.astro";

interface RecentPost {
  title: string;
  url: string;
  description?: string;
  heroImage?: string;
}

interface Props {
  posts: ReadonlyArray<RecentPost>;
  heading: string;
  readMore: string;
}

const { posts, heading, readMore } = Astro.props;

function excerpt(text?: string): string {
  const value = text || "";
  return value.length > 110 ? value.slice(0, 107) + "…" : value;
}
---

{
  posts.length > 0 && (
    <section class="rounded-lg bg-bg-alt p-6 lg:sticky lg:top-[100px]">
      <h2 class="border-b-2 border-line pb-2 font-titles text-[20px] font-bold text-ink">{heading}</h2>
      <ul class="mt-5 flex flex-col gap-6">
        {posts.map((post) => (
          <li class="flex flex-col gap-2.5">
            {post.heroImage && (
              <a href={post.url} class="block overflow-hidden rounded-md" tabindex="-1" aria-hidden="true">
                <img
                  src={post.heroImage}
                  alt={post.title}
                  width="320"
                  height="200"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/10] w-full object-cover"
                />
              </a>
            )}
            <h3 class="font-titles text-[16px] font-bold leading-[1.3] text-ink">
              <a href={post.url} class="hover:text-blue">{post.title}</a>
            </h3>
            {excerpt(post.description) && (
              <p class="text-[13.5px] leading-[1.55] text-body">{excerpt(post.description)}</p>
            )}
            <a
              href={post.url}
              class="inline-flex items-center gap-1.5 text-[13px] font-bold text-blue hover:text-green-dark"
            >
              {readMore}<Icon name="arrow" class="h-3.5 w-3.5" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
