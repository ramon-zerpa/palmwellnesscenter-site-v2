      lead: "Ubicados en el corazón de Tampa en 1004 W Linebaugh Ave, atendemos a pacientes de pérdida de peso médica de todo el condado de Hillsborough y comunidades cercanas.",
      places: ["Seminole Heights", "Forest Hills", "Carrollwood", "Town 'N' Country", "Temple Terrace", "Brandon", "Westchase"],
      note: "El transporte gratuito está disponible para pacientes elegibles en toda el área de Tampa Bay, lo que facilita asistir a tus visitas, seguimientos y servicios de bienestar relacionados.",
    },
    related: {
      heading: "Servicios relacionados",
      links: [
        { label: "Atención Primaria", href: "/es/atencion-primaria/" },
        { label: "Fisioterapia", href: "/es/fisioterapia/" },
        { label: "Quiropráctica", href: "/es/quiropractico/" },
        { label: "Terapia IV", href: "/es/terapia-iv/" },
        { label: "Rehabilitación por Accidente de Auto", href: "/es/rehabilitacion-de-accidentes-automovilisticos/" },
        { label: "Ejercicios Terapéuticos", href: "/es/ejercicios-terapeuticos/" },
      ],
    },
    cta: {
      title: "¿Listo para el siguiente paso en tu plan de pérdida de peso?",
      lead: "Mantente acompañado más allá de la primera visita con orientación médica continua, responsabilidad y ajustes adaptados a tu progreso.",
    },
    labels: { book: "Reservar cita", call: "(813) 443-5370", learn: "Ver más sobre" },
  },
}[lang];

const bookAttrs = { target: "_blank", rel: "noopener" } as const;
const l = content.labels;

const media = {
  intro: "/images/how-medical-weight-loss-fits-into-primary-care-ft-img.webp",
  services: "/images/how-medical-weight-loss-fits-into-primary-care-inner-img-1.webp",
  safety: "/images/how-medical-weight-loss-fits-into-primary-care-inner-img-2.webp",
  program: "/images/why-patients-choose-medical-weight-loss.webp",
  integrated: [
    "/images/our-primary-care-services.webp",
    "/images/doctor-helping-patient-with-physical-therapy.webp",
    "/images/chiropractor-helping-his-patient.webp",
    "/images/placeholders/iv-therapy.svg",
  ],
  trust: "/images/why-choose-palm-wellness-center-in-tampa.webp",
  choose: "/images/medical-weight-loss-program.webp",
  team: "/images/placeholders/care-team.svg",
  area: "/images/things-to-do-in-tampa-min.webp",
};
---

<!-- HERO (text left / image right) -->
<section class="bg-bg-alt">
  <div class="container grid items-center gap-10 py-14 lg:grid-cols-2 lg:py-20">
    <div class="flex flex-col items-start gap-5">
      <span class="inline-flex rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{content.hero.eyebrow}</span>
      <h1 class="text-4xl leading-[1.08] text-ink sm:text-5xl">{content.hero.title}</h1>
      <p class="max-w-xl text-[18px] leading-relaxed text-body">{content.hero.lead}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {content.hero.badges.map((b) => (
          <li class="flex items-center gap-2 text-[13.5px] font-semibold text-ink">
            <Icon name="check" class="h-4 w-4 shrink-0 text-green-dark" />{b}
          </li>
        ))}
      </ul>
      <div class="flex flex-wrap gap-3">
        <a href={APPOINTMENT_URL} {...bookAttrs} class="inline-flex items-center gap-2 rounded-md bg-blue px-6 py-3.5 font-bold text-white transition-colors hover:bg-blue-deep">
          <Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}
        </a>
        <a href={PHONE_TEL} class="inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue bg-white px-6 py-3.5 font-bold text-blue transition-colors hover:bg-blue-pale">
          <Icon name="phone" class="h-[18px] w-[18px]" />{l.call}
        </a>
      </div>
      <p class="text-[13px] text-muted">{content.hero.note}</p>
    </div>
    <div>
      <img src={content.hero.image} width="560" height="440" alt={content.hero.imageAlt} fetchpriority="high" decoding="async" class="h-[460px] w-full rounded-lg object-cover" />
    </div>
  </div>
</section>

<!-- INTRO -->
<section class="bg-white">
  <div class="container grid gap-10 py-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
    <div class="flex flex-col gap-5">
      <h2 class="text-3xl leading-tight text-ink sm:text-[2.3rem]">{content.intro.heading}</h2>
      {content.intro.paras.map((p) => <p class="max-w-[68ch] text-[17px] leading-relaxed text-body">{p}</p>)}
    </div>
    <div class="flex flex-col gap-5">
      <img src={media.intro} width="560" height="340" alt={content.intro.heading} loading="lazy" decoding="async" class="h-[340px] w-full rounded-lg object-cover" />
      <aside class="flex items-start gap-4 rounded-lg border border-line bg-bg-alt p-7">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name="activity" class="h-6 w-6" /></span>
        <p class="text-[16px] font-medium leading-relaxed text-ink">{content.intro.highlight}</p>
      </aside>
    </div>
  </div>
</section>

<!-- SERVICES (accordion) -->
<section class="bg-bg-alt">
  <div class="container grid gap-10 py-16 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
    <div class="flex flex-col gap-5 lg:sticky lg:top-32 lg:self-start">
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{content.services.heading}</h2>
      <p class="max-w-[40ch] text-[16px] leading-relaxed text-body">{content.services.lead}</p>
      <img src={media.services} width="440" height="340" alt={content.services.heading} loading="lazy" decoding="async" class="h-[340px] w-full rounded-lg object-cover" />
    </div>
    <div class="flex flex-col">
      {content.services.items.map((s) => (
        <details class="group border-t border-line py-6" open={false}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
            <span class="flex items-center gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-white text-blue-deep"><Icon name={s.icon} class="h-6 w-6" /></span>
              <span class="text-[20px] font-semibold text-ink">{s.title}</span>
            </span>
            <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-blue transition-transform group-open:rotate-180" />
          </summary>
          <div class="flex flex-col gap-4 pt-4 pl-0 lg:pl-[60px]">
            <p class="max-w-[62ch] text-[15px] leading-relaxed text-body">{s.body}</p>
            {s.bullets.length > 0 && (
              <ul class="flex flex-col gap-2.5">
                {s.bullets.map((b) => (
                  <li class="flex items-start gap-2.5 text-[14.5px] text-ink"><Icon name="check" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-green-dark" />{b}</li>
                ))}
              </ul>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- SAFETY -->
<section class="bg-white">
  <div class="container py-16">
    <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-stretch lg:gap-12">
      <img src={media.safety} width="480" height="460" alt={content.safety.heading} loading="lazy" decoding="async" class="h-[520px] w-full rounded-lg object-cover" />
      <div class="flex flex-col gap-6 rounded-lg border border-line bg-bg-alt p-8 lg:p-10">
        <div class="flex items-center gap-3">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blue text-white"><Icon name="shield" class="h-6 w-6" /></span>
          <h2 class="text-[24px] text-ink">{content.safety.heading}</h2>
        </div>
        <p class="max-w-[80ch] text-[15.5px] leading-relaxed text-body">{content.safety.lead}</p>
        <div class="grid gap-8 border-t border-line pt-6 md:grid-cols-2">
          <div class="flex flex-col gap-3">
            <h3 class="text-[13px] font-bold uppercase tracking-wide text-blue-deep">{content.safety.commonTitle}</h3>
            <ul class="flex flex-col gap-2.5">
              {content.safety.common.map((c) => <li class="flex items-start gap-2.5 text-[14.5px] text-ink"><Icon name="check" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-green-dark" />{c}</li>)}
            </ul>
          </div>
          <div class="flex flex-col gap-3">
            <h3 class="text-[13px] font-bold uppercase tracking-wide text-blue-deep">{content.safety.seriousTitle}</h3>
            <ul class="flex flex-col gap-2.5">
              {content.safety.serious.map((c) => <li class="flex items-start gap-2.5 text-[14.5px] text-ink"><Icon name="badge-check" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-blue" />{c}</li>)}
            </ul>
          </div>
        </div>
        <p class="text-[13.5px] leading-relaxed text-muted">{content.safety.note}</p>
      </div>
    </div>
  </div>
</section>

<!-- PROGRAM -->
<section class="bg-bg-alt">
  <div class="container grid items-center gap-12 py-16 lg:grid-cols-2">
    <div class="flex flex-col gap-5">
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{content.program.heading}</h2>
      <p class="max-w-[62ch] text-[17px] leading-relaxed text-body">{content.program.body}</p>
      <p class="max-w-[62ch] text-[13.5px] leading-relaxed text-muted">{content.program.note}</p>
      <img src={media.program} width="560" height="320" alt={content.program.heading} loading="lazy" decoding="async" class="mt-1 h-[320px] w-full rounded-lg object-cover" />
    </div>
    <article class="flex flex-col gap-6 rounded-lg bg-blue-deep p-8 text-blue-tint">
      <p class="flex items-end gap-2">
        <strong class="text-[46px] leading-none text-white">{content.program.price}</strong>
        <span class="pb-1.5 text-[15px]">{content.program.cadence}</span>
      </p>
      <ul class="flex flex-col gap-3 text-[14.5px]">
        {content.program.benefits.map((b) => (
          <li class="flex items-start gap-2.5"><Icon name="check" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-green-bright" />{b}</li>
        ))}
      </ul>
      <a href={APPOINTMENT_URL} {...bookAttrs} class="inline-flex items-center justify-center gap-2 rounded-md bg-white px-5 py-3 text-[15px] font-bold text-blue-deep transition-colors hover:bg-blue-pale">
        <Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}
      </a>
    </article>
  </div>
</section>

<!-- INTEGRATED (4-up) -->
<section class="bg-white">
  <div class="container flex flex-col gap-10 py-16">
    <div class="flex max-w-[720px] flex-col gap-3">
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{content.integrated.heading}</h2>
      <p class="text-[17px] leading-relaxed text-body">{content.integrated.lead}</p>
    </div>
    <div class="grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {content.integrated.items.map((s, i) => (
        <a href={s.href} class="group flex flex-col bg-white transition-colors hover:bg-bg-alt">
          <img src={media.integrated[i]} alt={s.title} loading="lazy" decoding="async" class="h-[170px] w-full object-cover" />
          <span class="flex flex-1 flex-col gap-3 p-6">
            <span class="grid h-11 w-11 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={s.icon} class="h-6 w-6" /></span>
            <h3 class="text-[17px] text-ink">{s.title}</h3>
            <p class="text-[14px] leading-relaxed text-body">{s.body}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-1 text-[13.5px] font-bold text-blue group-hover:text-blue-deep">{l.learn} <Icon name="arrow" class="h-4 w-4" /></span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- WHY -->
<section class="bg-bg-alt">
  <div class="container grid items-center gap-12 py-16 lg:grid-cols-2">
    <div class="flex flex-col gap-5">
      <h2 class="text-3xl text-ink sm:text-[2rem]">{content.why.heading}</h2>
      <p class="text-[16px] leading-relaxed text-body">{content.why.lead}</p>
      <ul class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
        {content.why.points.map((p) => (
          <li class="flex items-start gap-2.5 text-[14.5px] text-ink"><Icon name="check" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-green-dark" />{p}</li>
        ))}
      </ul>
      <p class="text-[15px] leading-relaxed text-body">{content.why.closing}</p>
    </div>
    <img src={content.why.image} width="560" height="460" alt={content.why.imageAlt} loading="lazy" decoding="async" class="h-[480px] w-full rounded-lg object-cover" />
  </div>
</section>

<!-- TRUST + HOURS -->
<section class="bg-white">
  <div class="container grid gap-10 py-16 lg:grid-cols-[1.3fr_0.7fr] lg:gap-14">
    <div class="flex flex-col gap-5">
      <h2 class="text-3xl text-ink sm:text-[2rem]">{content.trust.heading}</h2>
      {content.trust.paras.map((p) => <p class="max-w-[68ch] text-[16px] leading-relaxed text-body">{p}</p>)}
      <img src={media.trust} width="560" height="320" alt={content.trust.heading} loading="lazy" decoding="async" class="mt-1 h-[320px] w-full rounded-lg object-cover" />
    </div>
    <div class="flex h-fit flex-col gap-4 rounded-lg border border-line bg-bg-alt p-7">
      <p class="flex items-center gap-2 text-[13px] font-bold uppercase tracking-wide text-blue-deep">
        <Icon name="clock" class="h-4 w-4" />{content.trust.hoursLabel}
      </p>
      <ul class="flex flex-col divide-y divide-line">
        {content.trust.hours.map((h) => (
          <li class="flex items-center justify-between gap-4 py-3 text-[15px]">
            <span class="text-body">{h.day}</span>
            <span class="font-semibold text-ink">{h.time}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- TRANSPORT -->
<section class="bg-bg-alt">
  <div class="container grid items-center gap-10 py-16 lg:grid-cols-2">
    <div class="flex flex-col gap-4">
      <h2 class="text-3xl text-ink sm:text-[2rem]">{content.transport.title}</h2>
      <p class="max-w-[62ch] text-[16px] leading-relaxed text-body">{content.transport.body}</p>
      <a href={PHONE_TEL} class="inline-flex w-fit items-center gap-2 rounded-md bg-blue px-6 py-3.5 font-bold text-white transition-colors hover:bg-blue-deep">
        <Icon name="phone" class="h-[18px] w-[18px]" />{l.call}
      </a>
    </div>
    <img src={content.transport.image} width="560" height="360" alt={content.transport.imageAlt} loading="lazy" decoding="async" class="h-[380px] w-full rounded-lg object-cover" />
  </div>
</section>

<!-- WHY PATIENTS CHOOSE -->
<section class="bg-white">
  <div class="container grid gap-10 py-16 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div class="flex flex-col gap-5">
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{content.choose.heading}</h2>
      <p class="max-w-[46ch] text-[16px] leading-relaxed text-body">{content.choose.lead}</p>
      <img src={media.choose} width="480" height="300" alt={content.choose.heading} loading="lazy" decoding="async" class="h-[300px] w-full rounded-lg object-cover" />
    </div>
    <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
      {content.choose.items.map((it) => (
        <li class="flex items-start gap-3 text-[15.5px] text-ink">
          <Icon name="badge-check" class="mt-0.5 h-5 w-5 shrink-0 text-blue" />{it}
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- TEAM -->
<section class="bg-bg-alt">
  <div class="container grid gap-10 py-16 lg:grid-cols-[0.6fr_1.4fr] lg:gap-14">
    <div class="flex flex-col items-start gap-4">
      <img src={media.team} width="280" height="220" alt={content.team.name} loading="lazy" decoding="async" class="h-[220px] w-full max-w-[280px] rounded-lg object-cover" />
      <div>
        <h2 class="text-[24px] text-ink">{content.team.name}</h2>
        <p class="mt-1 text-[14px] font-semibold text-blue">{content.team.cred}</p>
      </div>
    </div>
    <div class="flex flex-col gap-5">
      <h3 class="text-[13px] font-bold uppercase tracking-wide text-muted">{content.team.heading}</h3>
      {content.team.bio.map((p) => <p class="max-w-[68ch] text-[16px] leading-relaxed text-body">{p}</p>)}
      <blockquote class="border-t border-line pt-6 text-[19px] font-medium leading-relaxed text-blue-deep">"{content.team.quote}"</blockquote>
    </div>
  </div>
</section>

<!-- STEPS -->
<section class="bg-white">
  <div class="container flex flex-col gap-10 py-16">
    <h2 class="text-3xl text-ink sm:text-[2.1rem]">{content.steps.heading}</h2>
    <ol class="grid gap-6 md:grid-cols-3">
      {content.steps.items.map((s, i) => (
        <li class="flex flex-col gap-3 rounded-lg border border-line bg-bg-alt p-7">
          <span class="text-[13px] font-bold uppercase tracking-wide text-blue-deep">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="text-[20px] text-ink">{s.title}</h3>
          <p class="text-[15px] leading-relaxed text-body">{s.body}</p>
        </li>
      ))}
    </ol>
    <p class="text-[13px] text-muted">{content.steps.note}</p>
  </div>
</section>

<!-- FAQ (2 cols) -->
<section class="bg-bg-alt">
  <div class="container flex flex-col gap-10 py-16">
    <h2 class="text-3xl text-ink sm:text-[2.1rem]">{content.faq.heading}</h2>
    <div class="grid gap-x-14 gap-y-1 md:grid-cols-2">
      {content.faq.items.map((item) => (
        <details class="group border-t border-line py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-semibold text-ink">
            <span>{item.q}</span>
            <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-blue transition-transform group-open:rotate-180" />
          </summary>
          <p class="pt-3 text-[14.5px] leading-relaxed text-body">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- AREA -->
<section class="bg-white">
  <div class="container grid gap-10 py-16 lg:grid-cols-2 lg:gap-14">
    <div class="flex flex-col gap-4">
      <h2 class="text-3xl text-ink sm:text-[2rem]">{content.area.heading}</h2>
      <p class="max-w-[60ch] text-[16px] leading-relaxed text-body">{content.area.lead}</p>
      <p class="max-w-[60ch] text-[15px] leading-relaxed text-body">{content.area.note}</p>
    </div>
    <div class="flex flex-col gap-5">
      <ul class="flex flex-wrap content-start gap-3">
        {content.area.places.map((p) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-bg-alt px-4 py-2.5 text-[15px] font-medium text-ink">
            <Icon name="map-pin" class="h-4 w-4 text-blue" />{p}
          </li>
        ))}
      </ul>
      <img src={media.area} width="560" height="260" alt={content.area.heading} loading="lazy" decoding="async" class="h-[260px] w-full rounded-lg object-cover" />
    </div>
  </div>
</section>

<!-- RELATED -->
<section class="bg-bg-alt">
  <div class="container flex flex-col items-center gap-8 py-14">
    <h2 class="text-[22px] text-ink">{content.related.heading}</h2>
    <ul class="flex flex-wrap justify-center gap-3">
      {content.related.links.map((lk) => (
        <li>
          <a href={lk.href} class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2.5 text-[15px] font-semibold text-blue transition-colors hover:bg-blue-pale hover:text-blue-deep">
            {lk.label} <Icon name="arrow" class="h-4 w-4" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- FINAL CTA -->
<section class="bg-blue-deep">
  <div class="container flex flex-col items-center gap-4 py-16 text-center">
    <h2 class="max-w-[820px] text-3xl text-white sm:text-[2.1rem]">{content.cta.title}</h2>
    <p class="max-w-[640px] text-[17px] leading-relaxed text-blue-tint">{content.cta.lead}</p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      <a href={APPOINTMENT_URL} {...bookAttrs} class="inline-flex items-center gap-2 rounded-md bg-white px-7 py-3.5 font-bold text-blue-deep transition-colors hover:bg-blue-pale">
        <Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}
      </a>
      <a href={PHONE_TEL} class="inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue-tint px-6 py-3.5 font-bold text-white transition-colors hover:bg-white/10">
        <Icon name="phone" class="h-[18px] w-[18px]" />{l.call}
      </a>
    </div>
  </div>
</section>
