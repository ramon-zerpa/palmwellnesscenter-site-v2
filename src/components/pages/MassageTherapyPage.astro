    faq: {
      heading: "Preguntas frecuentes",
      note: "¿Aún tiene preguntas? Llámenos al (813) 443-5370 y nuestro equipo le explicará sus opciones y qué esperar.",
      items: [
        { q: "¿Para qué se usa la terapia de masaje?", a: "La terapia de masaje se usa comúnmente durante la rehabilitación para dolor muscular, rigidez, irritación de tejidos blandos y recuperación después de una lesión. También puede apoyar un mejor movimiento y comodidad diaria." },
        { q: "¿La terapia de masaje puede ayudar después de un accidente de auto?", a: "Sí. La terapia de masaje puede ayudar a reducir la tensión muscular, el dolor y la rigidez después de un accidente de auto cuando forma parte de un plan de recuperación coordinado." },
        { q: "¿La terapia de masaje es lo mismo que un masaje de relajación?", a: "No. El masaje terapéutico en un entorno de rehabilitación se enfoca en la función, la movilidad, la recuperación de tejidos blandos y la reducción del dolor, no solo en la relajación." },
        { q: "¿Cuántas sesiones necesitaré?", a: "La cantidad de sesiones depende de sus síntomas, su condición y su progreso. Algunos pacientes sienten alivio temprano, mientras que otros necesitan atención continua como parte de un plan más amplio." },
        { q: "¿La terapia de masaje puede combinarse con atención quiropráctica o rehabilitación?", a: "Sí. La terapia de masaje suele combinarse con atención quiropráctica, rehabilitación física, ejercicios terapéuticos o terapia de ultrasonido según sus necesidades." },
        { q: "¿Cuándo debo comenzar el tratamiento después de una lesión?", a: "Lo mejor es evaluarse tan pronto como comiencen los síntomas. La atención temprana puede ayudar a identificar problemas, apoyar la recuperación y evitar que las molestias empeoren." },
      ],
    },
    area: {
      eyebrow: "Área de Servicio",
      heading: "Sirviendo con orgullo a Tampa y vecindarios cercanos",
      lead: "Palm Wellness Center está ubicado en Tampa, FL, pero nuestros pacientes vienen de toda el área circundante. Regularmente ayudamos a los pacientes a mejorar su movilidad, reducir molestias y recuperarse de lesiones mediante servicios coordinados de rehabilitación.",
      places: ["Seminole Heights", "Forest Hills", "Carrollwood", "North Tampa", "Comunidades del área de Tampa Bay"],
      note: "¿Necesita indicaciones o transporte? Llame al (813) 443-5370 y nuestro equipo le ayudará a planificar su visita.",
      contactNote: "Transporte gratis para pacientes elegibles - pregúntelo al reservar.",
    },
    cta: {
      title: "¿Listo para moverse con menos dolor y tensión?",
      lead: "Si la tensión muscular, el dolor, la rigidez o la incomodidad de los tejidos blandos le dificultan el movimiento diario, la terapia de masaje puede apoyar su recuperación.",
    },
    labels: { book: "Reservar cita", call: "(813) 443-5370", learn: "Ver más", onThisPage: "En esta página" },
  },
}[lang];

const bookAttrs = { target: "_blank", rel: "noopener" } as const;
const l = content.labels;

const backToTop = lang === "es" ? "Volver arriba" : "Back to top";

const hover = "hover-lift";

const eyebrowCls = "inline-flex w-fit items-center gap-1.5 rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep";
const eyebrowDarkCls = "inline-flex w-fit items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-tint";
const h2Cls = "font-titles text-[26px] leading-[1.15] text-ink sm:text-[30px] lg:text-[34px]";
const leadCls = "text-[16px] leading-[1.6] text-body sm:text-[17px]";
const btnBookCls = `inline-flex items-center gap-2 rounded-md bg-blue px-6 py-3.5 font-bold text-white hover:bg-blue-deep ${hover}`;
const btnCallCls = `inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue bg-white px-6 py-3.5 font-bold text-blue hover:bg-blue-pale ${hover}`;
---

<!-- HERO -->
<section class="relative isolate overflow-hidden bg-bg-alt">
  <div class="hero-ambient" aria-hidden="true">
    <span class="hero-pulse"></span>
  </div>
  <div class="shell relative flex flex-col gap-10 pt-12 pb-26 lg:gap-12 lg:pt-16 lg:pb-32">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_560px] lg:gap-12">
      <div class="flex flex-col items-start gap-5">
        <span class={eyebrowCls}><Icon name="hand" class="h-3.5 w-3.5" />{content.hero.eyebrow}</span>
        <h1 class="font-titles text-[32px] leading-[1.08] text-ink sm:text-[38px] lg:text-[46px]">{content.hero.title}</h1>
        <p class="max-w-xl text-[17px] leading-[1.6] text-body sm:text-[18px]">{content.hero.lead}</p>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-3">
          {content.hero.chips.map((c) => (
            <li class="flex items-center gap-2">
              <span class="grid h-[30px] w-[30px] shrink-0 place-items-center rounded-full bg-blue-pale text-blue-deep"><Icon name={c.icon} class="h-4 w-4" /></span>
              <span class="text-[14px] font-semibold text-ink">{c.label}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-3.5">
          <a href={APPOINTMENT_URL} {...bookAttrs} class={btnBookCls}><Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}</a>
          <a href={PHONE_TEL} class={btnCallCls}><Icon name="phone" class="h-[18px] w-[18px]" />{l.call}</a>
        </div>
        <p class="text-[13px] text-muted">{content.hero.note}</p>
      </div>
      <div class="hero-media-frame h-[280px] sm:h-[380px] lg:h-[440px]">
        <div class="hero-media">
          <img src={content.hero.image} width="560" height="440" alt={content.hero.imageAlt} fetchpriority="high" decoding="async" class="hero-media__img object-center" />
          <span class="hero-heart h-12 w-12 lg:h-14 lg:w-14" aria-hidden="true">
            <Icon name="heart-pulse" solid class="h-5 w-5 lg:h-6 lg:w-6" />
          </span>
        </div>
      </div>
    </div>
    <dl class={`grid gap-8 rounded-lg border border-line bg-white px-7 py-7 sm:grid-cols-3 lg:px-10 ${hover}`}>
      {content.hero.rail.map((r) => (
        <div class="flex flex-col gap-1">
          <dt class="font-titles text-[24px] font-bold leading-none text-blue-deep lg:text-[28px]">{r.value}</dt>
          <dd class="text-[13px] text-muted">{r.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- ANCHOR NAV -->
<AnchorNav label={l.onThisPage} items={content.subnav} />

<!-- WHY -->
<section id="why" class="scroll-mt-24 lg:scroll-mt-[184px] bg-white">
  <div class="shell grid items-center gap-10 py-16 lg:grid-cols-[460px_1fr] lg:gap-16 lg:py-20">
    <img src={content.why.image} width="460" height="460" alt={content.why.imageAlt} loading="lazy" decoding="async" class="h-[280px] w-full rounded-lg object-cover sm:h-[380px] lg:h-[440px]" />
    <div class="flex flex-col gap-5">
      <span class={eyebrowCls}><Icon name="badge-check" class="h-3.5 w-3.5" />{content.why.eyebrow}</span>
      <h2 class={h2Cls}>{content.why.heading}</h2>
      <p class={leadCls}>{content.why.lead}</p>
      <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.why.pointsLabel}</p>
      <ul class="grid gap-3 sm:grid-cols-2">
        {content.why.points.map((p) => (
          <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="check" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-green-dark" />{p}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- HELPS -->
<section id="helps" class="scroll-mt-24 lg:scroll-mt-[184px] bg-bg-alt">
  <div class="shell flex flex-col gap-9 py-16 lg:py-20">
    <div class="grid gap-6 lg:grid-cols-[1fr_420px] lg:items-end lg:gap-12">
      <div class="flex flex-col gap-4">
        <span class={eyebrowCls}><Icon name="hand" class="h-3.5 w-3.5" />{content.helps.eyebrow}</span>
        <h2 class={h2Cls}>{content.helps.heading}</h2>
      </div>
      <p class={leadCls}>{content.helps.lead}</p>
    </div>
    <div class={`flex flex-col gap-5 rounded-lg border border-line bg-white p-7 lg:p-8 ${hover}`}>
      <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.helps.itemsLabel}</p>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {content.helps.items.map((it) => (
          <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="circle-check" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-blue" />{it}</li>
        ))}
      </ul>
    </div>
    <p class="max-w-[80ch] text-[15px] leading-[1.6] text-muted">{content.helps.note}</p>
  </div>
</section>

<!-- SIGNS (table) -->
<section class="bg-white">
  <div class="shell flex flex-col gap-9 py-16 lg:py-20">
    <div class="grid gap-6 lg:grid-cols-[1fr_420px] lg:items-end lg:gap-12">
      <div class="flex flex-col gap-4">
        <span class={eyebrowCls}><Icon name="activity" class="h-3.5 w-3.5" />{lang === "es" ? "Señales" : "Signs"}</span>
        <h2 class={h2Cls}>{content.signs.heading}</h2>
      </div>
      <div class="flex flex-col gap-3">
        {content.signs.paras.map((p) => <p class="text-[15px] leading-[1.6] text-body">{p}</p>)}
      </div>
    </div>
    <div class="overflow-hidden rounded-lg border border-line">
      <div class="hidden grid-cols-2 bg-blue-deep sm:grid">
        {content.signs.head.map((h, i) => (
          <div class={`px-6 py-4 text-[12px] font-bold uppercase tracking-[0.08em] text-white ${i > 0 ? "border-l border-white/20" : ""}`}>{h}</div>
        ))}
      </div>
      {content.signs.rows.map((r, i) => (
        <div class={`grid gap-1.5 sm:grid-cols-2 sm:gap-0 ${i > 0 ? "border-t border-line" : ""}`}>
          <div class="px-6 pt-5 font-semibold text-ink sm:py-5">{r[0]}</div>
          <div class="px-6 pb-5 text-[15px] leading-[1.55] text-body sm:border-l sm:border-line sm:py-5">{r[1]}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- REHAB (dark band) -->
<section class="bg-blue-deep">
  <div class="shell grid items-start gap-10 py-16 lg:grid-cols-[1fr_440px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-5">
      <span class={eyebrowDarkCls}>{content.rehab.eyebrow}</span>
      <h2 class="font-titles text-[26px] leading-[1.15] text-white sm:text-[30px] lg:text-[34px]">{content.rehab.heading}</h2>
      <p class="max-w-[62ch] text-[16px] leading-[1.62] text-blue-tint">{content.rehab.lead}</p>
      <p class="max-w-[62ch] text-[15px] leading-[1.62] text-blue-tint">{content.rehab.para}</p>
      <p class="max-w-[62ch] text-[14px] leading-[1.6] text-blue-tint/90">{content.rehab.note}</p>
      <div class="mt-1 flex flex-wrap gap-3">
        <a href={APPOINTMENT_URL} {...bookAttrs} class={`inline-flex items-center gap-2 rounded-md bg-white px-6 py-3.5 font-bold text-blue-deep hover:bg-blue-pale ${hover}`}><Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}</a>
        <a href={PHONE_TEL} class={`inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue-tint px-6 py-3.5 font-bold text-white hover:bg-white/10 ${hover}`}><Icon name="phone" class="h-[18px] w-[18px]" />{l.call}</a>
      </div>
    </div>
    <ul class="flex flex-col gap-4 rounded-lg border border-white/15 bg-white/5 p-7 lg:p-8">
      <li class="text-[13px] font-bold uppercase tracking-[0.1em] text-blue-tint">{content.rehab.pointsLabel}</li>
      {content.rehab.points.map((p) => (
        <li class="flex items-start gap-3 text-[15px] leading-[1.55] text-blue-tint"><Icon name="check" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-green-bright" />{p}</li>
      ))}
    </ul>
  </div>
</section>

<!-- CAR ACCIDENT -->
<section class="bg-white">
  <div class="shell grid items-center gap-10 py-16 lg:grid-cols-[1fr_460px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-5">
      <span class={eyebrowCls}><Icon name="car" class="h-3.5 w-3.5" />{content.accident.eyebrow}</span>
      <h2 class={h2Cls}>{content.accident.heading}</h2>
      {content.accident.paras.map((p) => <p class="max-w-[62ch] text-[16px] leading-[1.62] text-body">{p}</p>)}
      <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.accident.itemsLabel}</p>
      <ul class="grid gap-3 sm:grid-cols-2">
        {content.accident.items.map((it) => (
          <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="check" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-green-dark" />{it}</li>
        ))}
      </ul>
      <p class="max-w-[62ch] text-[15px] leading-[1.6] text-muted">{content.accident.note}</p>
      <div class="flex flex-wrap gap-3 pt-1">
        {content.accident.related.map((r) => (
          <a href={r.href} class={`inline-flex items-center gap-2 rounded-full border border-line bg-bg-alt px-4 py-2.5 text-[14px] font-semibold text-ink hover:text-blue-deep ${hover}`}>{r.label}<Icon name="arrow" class="h-4 w-4 text-blue" /></a>
        ))}
      </div>
    </div>
    <img src={content.accident.image} width="460" height="460" alt={content.accident.imageAlt} loading="lazy" decoding="async" class="h-[280px] w-full rounded-lg object-cover sm:h-[380px] lg:h-[440px]" />
  </div>
</section>

<!-- WHAT TO EXPECT -->
<section id="expect" class="scroll-mt-24 lg:scroll-mt-[184px] bg-bg-alt">
  <div class="shell flex flex-col gap-9 py-16 lg:py-20">
    <div class="grid gap-6 lg:grid-cols-[1fr_420px] lg:items-end lg:gap-12">
      <h2 class={h2Cls}>{content.expect.heading}</h2>
      <div class="flex flex-col gap-3">
        {content.expect.paras.map((p) => <p class="text-[15px] leading-[1.6] text-body">{p}</p>)}
      </div>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      <div class={`flex flex-col gap-4 rounded-lg border border-line bg-white p-7 lg:p-8 ${hover}`}>
        <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.expect.techniquesLabel}</p>
        <ul class="flex flex-col gap-3">
          {content.expect.techniques.map((t) => (
            <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="circle-check" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-blue" />{t}</li>
          ))}
        </ul>
      </div>
      <div class={`flex flex-col gap-4 rounded-lg border border-line bg-white p-7 lg:p-8 ${hover}`}>
        <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.expect.describeLabel}</p>
        <ul class="flex flex-col gap-3">
          {content.expect.describe.map((t) => (
            <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="circle-check" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-blue" />{t}</li>
          ))}
        </ul>
      </div>
    </div>
    <p class="max-w-[80ch] text-[15px] leading-[1.6] text-muted">{content.expect.note}</p>
  </div>
</section>

<!-- COMBINED -->
<section id="combined" class="scroll-mt-24 lg:scroll-mt-[184px] bg-white">
  <div class="shell flex flex-col gap-10 py-16 lg:py-20">
    <div class="grid gap-6 lg:grid-cols-[1fr_420px] lg:items-end lg:gap-12">
      <div class="flex flex-col gap-4">
        <span class={eyebrowCls}><Icon name="users" class="h-3.5 w-3.5" />{content.combined.eyebrow}</span>
        <h2 class={h2Cls}>{content.combined.heading}</h2>
      </div>
      <p class={leadCls}>{content.combined.lead}</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {content.combined.items.map((s) => (
        <a href={s.href} class={`group flex flex-col gap-3 rounded-lg border border-line bg-bg-alt p-6 lg:p-7 ${hover}`}>
          <span class="grid h-12 w-12 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={s.icon} class="h-[22px] w-[22px]" /></span>
          <h3 class="font-titles text-[19px] leading-[1.25] text-ink">{s.title}</h3>
          <p class="text-[15px] leading-[1.6] text-body">{s.body}</p>
          <span class="mt-auto inline-flex items-center gap-2 pt-1 text-[14px] font-bold text-blue">{l.learn}<Icon name="arrow" class="h-[15px] w-[15px] transition-transform group-hover:translate-x-0.5" /></span>
        </a>
      ))}
    </div>
    <p class="max-w-[80ch] text-[15px] leading-[1.6] text-muted">{content.combined.note}</p>
  </div>
</section>

<!-- TEAM (dark band) -->
<section id="team" class="scroll-mt-24 lg:scroll-mt-[184px] bg-blue-deep">
  <div class="shell flex flex-col gap-10 py-16 lg:py-20">
    <div class="flex max-w-[720px] flex-col gap-4">
      <span class={eyebrowDarkCls}>{content.team.eyebrow}</span>
      <h2 class="font-titles text-[26px] leading-[1.15] text-white sm:text-[30px] lg:text-[34px]">{content.team.heading}</h2>
      <p class="text-[16px] leading-[1.6] text-blue-tint sm:text-[17px]">{content.team.lead}</p>
    </div>
    <ul class="grid gap-6 md:grid-cols-3">
      {content.team.members.map((m) => (
        <li class={`flex flex-col gap-4 rounded-lg border border-white/15 bg-white/5 p-7 lg:p-8 ${hover}`}>
          <span class="grid h-[74px] w-[74px] place-items-center rounded-full bg-white/10 font-titles text-[26px] font-bold text-white">{m.initials}</span>
          <div class="flex flex-col gap-1">
            <h3 class="font-titles text-[19px] font-bold leading-[1.2] text-white lg:text-[20px]">{m.name}</h3>
            <p class="text-[13px] font-semibold leading-[1.4] text-green-bright">{m.cred}</p>
          </div>
          <p class="text-[15px] leading-[1.6] text-blue-tint">{m.bio}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- TRUST + HOURS -->
<section class="bg-bg-alt">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[1fr_400px] lg:gap-14 lg:py-20">
    <div class="flex flex-col gap-4">
      <h2 class="font-titles text-[26px] leading-[1.15] text-ink sm:text-[28px] lg:text-[32px]">{content.trust.heading}</h2>
      {content.trust.paras.map((p) => <p class="max-w-[68ch] text-[16px] leading-[1.62] text-body">{p}</p>)}
      <img src={content.trust.image} width="560" height="320" alt={content.trust.imageAlt} loading="lazy" decoding="async" class="mt-2 h-[240px] w-full rounded-lg object-cover object-top lg:h-[300px]" />
    </div>
    <div class="flex flex-col gap-5">
      <div class={`flex flex-col gap-4 rounded-lg border border-line bg-white p-7 ${hover}`}>
        <p class="flex items-center gap-2 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep">
          <Icon name="clock" class="h-4 w-4" />{content.trust.hoursLabel}
        </p>
        <ul class="flex flex-col">
          {content.trust.hours.map((h, i) => (
            <li class={`flex items-center justify-between gap-4 py-3.5 text-[15px] ${i > 0 ? "border-t border-line" : ""}`}>
              <span class="text-body">{h.day}</span>
              <span class="text-right font-semibold text-ink">{h.time}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class={`flex flex-col gap-3 rounded-lg bg-blue-deep p-7 ${hover}`}>
        <p class="text-[12px] font-bold uppercase tracking-[0.1em] text-blue-tint">{content.trust.locationLabel}</p>
        <p class="whitespace-pre-line text-[16px] font-semibold leading-[1.5] text-white">{content.trust.address}</p>
        <a href={PHONE_TEL} class="font-titles text-[22px] font-bold text-white underline-offset-4 transition-all duration-200 hover:-translate-y-0.5 hover:text-blue-tint">{l.call}</a>
      </div>
    </div>
  </div>
</section>

<!-- TRANSPORT -->
<section class="bg-white">
  <div class="shell grid items-center gap-10 py-16 lg:grid-cols-[560px_1fr] lg:gap-16 lg:py-20">
    <img src={content.transport.image} width="560" height="400" alt={content.transport.imageAlt} loading="lazy" decoding="async" class="h-[240px] w-full rounded-lg object-cover sm:h-[320px] lg:h-[400px]" />
    <div class="flex flex-col items-start gap-5">
      <h2 class={h2Cls}>{content.transport.title}</h2>
      <p class="max-w-[62ch] text-[16px] leading-[1.6] text-body sm:text-[17px]">{content.transport.body}</p>
      <a href={PHONE_TEL} class={btnBookCls}><Icon name="phone" class="h-[18px] w-[18px]" />{l.call}</a>
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="scroll-mt-24 lg:scroll-mt-[184px] bg-bg-alt">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[400px_1fr] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-4">
      <span class={eyebrowCls}>{lang === "es" ? "Preguntas" : "FAQ"}</span>
      <h2 class={h2Cls}>{content.faq.heading}</h2>
      <p class="text-[15px] leading-[1.6] text-body">{content.faq.note}</p>
    </div>
    <div class="flex flex-col">
      {content.faq.items.map((item, i) => (
        <details class={`group ${i > 0 ? "border-t border-line" : ""}`} {...(i === 0 ? { open: true } : {})}>
          <summary class="-mx-4 flex cursor-pointer list-none items-center justify-between gap-4 rounded-md px-4 py-5 text-[17px] font-bold text-ink transition-colors hover:bg-white [&::-webkit-details-marker]:hidden">
            <span>{item.q}</span>
            <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-blue transition-transform group-open:rotate-180" />
          </summary>
          <p class="max-w-[62ch] pb-5 text-[15px] leading-[1.6] text-body">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- SERVICE AREA -->
<section class="bg-white">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[1fr_560px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-4">
      <span class={eyebrowCls}>{content.area.eyebrow}</span>
      <h2 class="font-titles text-[26px] leading-[1.15] text-ink sm:text-[28px] lg:text-[32px]">{content.area.heading}</h2>
      <p class="max-w-[60ch] text-[16px] leading-[1.62] text-body">{content.area.lead}</p>
      <p class="max-w-[60ch] text-[15px] leading-[1.6] text-muted">{content.area.note}</p>
    </div>
    <div class={`flex flex-col gap-6 rounded-lg border border-line bg-bg-alt p-7 lg:p-8 ${hover}`}>
      <ul class="flex flex-wrap gap-2.5">
        {content.area.places.map((p) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2.5 text-[14px] font-semibold text-ink">
            <Icon name="map-pin" class="h-4 w-4 text-blue" />{p}
          </li>
        ))}
      </ul>
      <div class="flex items-center gap-3 border-t border-line pt-5">
        <Icon name="car" class="h-5 w-5 shrink-0 text-green-dark" />
        <p class="text-[14px] font-semibold text-body">{content.area.contactNote}</p>
      </div>
    </div>
  </div>
</section>

<!-- BACK TO TOP -->
<div class="bg-white">
  <div class="shell flex justify-end py-6">
    <a href="#main" class="inline-flex items-center gap-2 text-[14px] font-semibold text-blue transition-colors hover:text-blue-deep">
      <Icon name="chevron-down" class="h-4 w-4 rotate-180" />{backToTop}
    </a>
  </div>
</div>

<!-- FINAL CTA -->
<section class="bg-blue-deep">
  <div class="shell flex flex-col items-center gap-4 py-16 text-center lg:py-18">
    <h2 class="max-w-[820px] font-titles text-[26px] leading-[1.15] text-white sm:text-[30px] lg:text-[34px]">{content.cta.title}</h2>
    <p class="max-w-[640px] text-[16px] leading-[1.6] text-blue-tint sm:text-[17px]">{content.cta.lead}</p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      <a href={APPOINTMENT_URL} {...bookAttrs} class={`inline-flex items-center gap-2 rounded-md bg-white px-7 py-3.5 font-bold text-blue-deep hover:bg-blue-pale ${hover}`}>
        <Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}
      </a>
      <a href={PHONE_TEL} class={`inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue-tint px-6 py-3.5 font-bold text-white hover:bg-white/10 ${hover}`}>
        <Icon name="phone" class="h-[18px] w-[18px]" />{l.call}
      </a>
    </div>
  </div>
</section>
