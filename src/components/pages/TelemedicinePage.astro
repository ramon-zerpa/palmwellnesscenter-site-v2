const bookAttrs = { target: "_blank", rel: "noopener" } as const;
const l = content.labels;

const eyebrow = {
  en: { treat: "What We Treat", how: "How It Works", prep: "Before Your Visit", pricing: "Pricing & Coverage", integrated: "Integrated Wellness", steps: "How to Get Started", faq: "FAQ", area: "Where It Works" },
  es: { treat: "Qué Tratamos", how: "Cómo Funciona", prep: "Antes de tu Visita", pricing: "Precios y Cobertura", integrated: "Bienestar Integrado", steps: "Cómo Comenzar", faq: "Preguntas", area: "Dónde Funciona" },
}[lang];

const supervising = {
  en: { name: "Dr. Arnaldo V. Orellana-Molina", cred: "MD - Supervising Physician", bio: "Provides medical oversight that keeps your telemedicine care safe and guideline-aligned." },
  es: { name: "Dr. Arnaldo V. Orellana-Molina", cred: "MD - Médico Supervisor", bio: "Brinda supervisión médica que mantiene tu atención por telemedicina segura y alineada con las guías clínicas." },
}[lang];

const backToTop = lang === "es" ? "Volver arriba" : "Back to top";

// Single hover language: a 2px lift plus ONE soft black shadow. It belongs to
// things the user can act on, or to the single card that fronts an action —
// never to both at once.
const hover = "hover-lift";

const eyebrowCls = "inline-flex w-fit items-center gap-1.5 rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep";
const eyebrowDarkCls = "inline-flex w-fit items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-tint";
const h2Cls = "font-titles text-[26px] leading-[1.15] text-ink sm:text-[30px] lg:text-[34px]";
const leadCls = "text-[16px] leading-[1.6] text-body sm:text-[17px]";
const btnBookCls = `inline-flex items-center gap-2 rounded-md bg-blue px-6 py-3.5 font-bold text-white hover:bg-blue-deep ${hover}`;
const btnCallCls = `inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue bg-white px-6 py-3.5 font-bold text-blue hover:bg-blue-pale ${hover}`;
---

<!-- HERO -->
<section class="relative isolate overflow-hidden bg-bg-alt">
  <div class="hero-ambient" aria-hidden="true">
    <span class="hero-pulse"></span>
  </div>
  <div class="shell relative flex flex-col gap-10 pt-12 pb-26 lg:gap-12 lg:pt-16 lg:pb-32">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_560px] lg:gap-12">
      <div class="flex flex-col items-start gap-5">
        <span class={eyebrowCls}><Icon name="video" class="h-3.5 w-3.5" />{content.hero.eyebrow}</span>
        <h1 class="font-titles text-[32px] leading-[1.08] text-ink sm:text-[38px] lg:text-[46px]">{content.hero.title}</h1>
        <p class="max-w-xl text-[17px] leading-[1.6] text-body sm:text-[18px]">{content.hero.lead}</p>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-3">
          {content.hero.chips.map((c) => (
            <li class="flex items-center gap-2">
              <span class="grid h-[30px] w-[30px] shrink-0 place-items-center rounded-full bg-blue-pale text-blue-deep"><Icon name={c.icon} class="h-4 w-4" /></span>
              <span class="text-[14px] font-semibold text-ink">{c.label}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-3.5">
          <a href={APPOINTMENT_URL} {...bookAttrs} class={btnBookCls}><Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}</a>
          <a href={PHONE_TEL} class={btnCallCls}><Icon name="phone" class="h-[18px] w-[18px]" />{l.call}</a>
        </div>
        <p class="text-[13px] text-muted">{content.hero.note}</p>
      </div>
      <div class="hero-media-frame h-[280px] sm:h-[380px] lg:h-[440px]">
        <div class="hero-media">
          <img src={content.hero.image} width="560" height="440" alt={content.hero.imageAlt} fetchpriority="high" decoding="async" class="hero-media__img object-center" />
          <span class="hero-heart h-12 w-12 lg:h-14 lg:w-14" aria-hidden="true">
            <Icon name="heart" solid class="h-5 w-5 lg:h-6 lg:w-6" />
          </span>
        </div>
      </div>
    </div>
    <dl class={`grid gap-8 rounded-lg border border-line bg-white px-7 py-7 sm:grid-cols-3 lg:px-10 ${hover}`}>
      {content.hero.rail.map((r) => (
        <div class="flex flex-col gap-1">
          <dt class="font-titles text-[26px] font-bold leading-none text-blue-deep lg:text-[30px]">{r.value}</dt>
          <dd class="text-[13px] text-muted">{r.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- ANCHOR NAV — in flow after the hero; sticks flush to the bottom edge of the
     sticky primary nav (header is 70px at lg, 64px below), so no gap appears. -->
<AnchorNav label={l.onThisPage} items={content.subnav} />

<!-- INTRO -->
<section class="bg-white">
  <div class="shell grid items-start gap-10 py-16 lg:grid-cols-[1fr_480px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-5">
      <h2 class={h2Cls}>{content.intro.heading}</h2>
      {content.intro.paras.map((p) => <p class="max-w-[68ch] text-[16px] leading-[1.62] text-body">{p}</p>)}
    </div>
    <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-1">
      {content.intro.compare.map((c, i) => (
        <div class={i === 1
          ? `flex flex-col gap-2.5 rounded-lg bg-blue-deep p-7 ${hover}`
          : `flex flex-col gap-2.5 rounded-lg border border-line bg-bg-alt p-7 ${hover}`}>
          <p class={i === 1 ? "text-[11px] font-bold uppercase tracking-[0.1em] text-blue-tint" : "text-[11px] font-bold uppercase tracking-[0.1em] text-muted"}>{c.tag}</p>
          <p class={i === 1 ? "font-titles text-[30px] font-bold leading-none text-white" : "font-titles text-[30px] font-bold leading-none text-ink"}>{c.value}</p>
          <p class={i === 1 ? "text-[15px] leading-[1.55] text-blue-tint" : "text-[15px] leading-[1.55] text-body"}>{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- WHAT WE TREAT -->
<section id="treat" class="scroll-mt-24 lg:scroll-mt-[184px] bg-bg-alt">
  <div class="shell flex flex-col gap-10 py-16 lg:py-20">
    <div class="flex max-w-[720px] flex-col gap-4">
      <span class={eyebrowCls}><Icon name="video" class="h-3.5 w-3.5" />{eyebrow.treat}</span>
      <h2 class={h2Cls}>{content.treat.heading}</h2>
      <p class={leadCls}>{content.treat.lead}</p>
    </div>
    <ul class="grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {content.treat.items.map((c) => (
        <li class="flex flex-col gap-3.5 bg-white p-7">
          <span class="grid h-12 w-12 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={c.icon} class="h-[22px] w-[22px]" /></span>
          <h3 class="font-titles text-[18px] leading-[1.25] text-ink sm:text-[19px]">{c.title}</h3>
          <p class="text-[14.5px] leading-[1.55] text-body">{c.body}</p>
        </li>
      ))}
    </ul>
    <div class="flex items-start gap-4 rounded-lg border border-danger/25 bg-white p-6 lg:p-7">
      <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-danger/10 text-danger"><Icon name="triangle-alert" class="h-[22px] w-[22px]" /></span>
      <div class="flex flex-col gap-1.5">
        <p class="font-titles text-[17px] font-bold text-ink">{content.treat.disclaimerTitle}</p>
        <p class="max-w-[80ch] text-[14.5px] leading-[1.55] text-body">{content.treat.disclaimerBody}</p>
      </div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS (dark band) -->
<section id="how" class="scroll-mt-24 lg:scroll-mt-[184px] bg-blue-deep">
  <div class="shell flex flex-col gap-9 py-16 lg:py-20">
    <div class="flex max-w-[800px] flex-col gap-4">
      <span class={eyebrowDarkCls}>{eyebrow.how}</span>
      <h2 class="font-titles text-[26px] leading-[1.15] text-white sm:text-[30px] lg:text-[34px]">{content.approach.heading}</h2>
      <p class="text-[16px] leading-[1.6] text-blue-tint sm:text-[17px]">{content.approach.lead}</p>
    </div>
    <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {content.approach.steps.map((s, i) => (
        <li class="flex flex-col gap-3 border-t border-white/15 pt-6">
          <span class="font-titles text-[15px] font-bold text-green-bright">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="font-titles text-[19px] leading-[1.25] text-white">{s.title}</h3>
          <p class="text-[14.5px] leading-[1.55] text-blue-tint">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- BEFORE YOUR VISIT -->
<section class="bg-white">
  <div class="shell grid items-start gap-12 py-16 lg:grid-cols-[1fr_480px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-5">
      <span class={eyebrowCls}><Icon name="monitor-smartphone" class="h-3.5 w-3.5" />{eyebrow.prep}</span>
      <h2 class={h2Cls}>{content.prep.heading}</h2>
      <p class={leadCls}>{content.prep.lead}</p>
      <div class={`flex items-center gap-3 rounded-md bg-bg-alt p-5 ${hover}`}>
        <Icon name="headset" class="h-5 w-5 shrink-0 text-blue" />
        <p class="text-[14px] font-semibold text-body">{content.prep.note}</p>
      </div>
    </div>
    <ol class="flex flex-col gap-px overflow-hidden rounded-lg border border-line bg-line">
      {content.prep.items.map((item, i) => (
        <li class="flex items-start gap-4 bg-white p-6">
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-blue-pale font-titles text-[13px] font-bold text-blue-deep">{i + 1}</span>
          <p class="text-[15px] leading-[1.55] text-ink">{item}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- PRICING -->
<section id="pricing" class="scroll-mt-24 lg:scroll-mt-[184px] bg-bg-alt">
  <div class="shell grid items-center gap-12 py-16 lg:grid-cols-[1fr_460px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-5">
      <span class={eyebrowCls}><Icon name="credit-card" class="h-3.5 w-3.5" />{eyebrow.pricing}</span>
      <h2 class={h2Cls}>{content.pricing.heading}</h2>
      <p class="max-w-[62ch] text-[16px] leading-[1.62] text-body sm:text-[17px]">{content.pricing.body}</p>
      <ul class="grid gap-3.5 sm:grid-cols-2">
        {content.pricing.points.map((p) => (
          <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="check" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-green-dark" />{p}</li>
        ))}
      </ul>
    </div>
    <article class={`flex flex-col gap-4 rounded-lg border border-line bg-white p-7 lg:p-9 ${hover}`}>
      <p class="text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.pricing.cardLabel}</p>
      <ul class="flex flex-col">
        {content.pricing.panels.map((panel, i) => (
          <li class={`flex items-center justify-between gap-4 py-4 ${i > 0 ? "border-t border-line" : ""}`}>
            <span class="flex flex-col gap-0.5">
              <span class="text-[15px] leading-[1.4] text-ink">{panel.name}</span>
              <span class="text-[12.5px] text-muted">{panel.detail}</span>
            </span>
            <span class="shrink-0 font-titles text-[22px] font-bold text-blue-deep">{panel.price}</span>
          </li>
        ))}
      </ul>
      <p class="border-t border-line pt-4 text-[13px] leading-[1.55] text-muted">{content.pricing.note}</p>
    </article>
  </div>
</section>

<!-- INTEGRATED (dark band) -->
<section class="bg-blue-deep">
  <div class="shell flex flex-col gap-9 py-16 lg:py-20">
    <div class="flex max-w-[720px] flex-col gap-4">
      <span class={eyebrowDarkCls}>{eyebrow.integrated}</span>
      <h2 class="font-titles text-[26px] leading-[1.15] text-white sm:text-[30px] lg:text-[34px]">{content.integrated.heading}</h2>
      <p class="text-[16px] leading-[1.6] text-blue-tint sm:text-[17px]">{content.integrated.lead}</p>
    </div>
    <div class="grid overflow-hidden rounded-lg border border-white/15 bg-white/5 sm:grid-cols-2 lg:grid-cols-4">
      {content.integrated.items.map((s, i) => (
        <a href={s.href} class={`group flex flex-col gap-3.5 p-7 hover:bg-white/10 lg:p-8 ${hover} ${i > 0 ? "border-t border-white/15 sm:border-l sm:border-t-0" : ""}`}>
          <span class="grid h-12 w-12 place-items-center rounded-md bg-white/10 text-white"><Icon name={s.icon} class="h-[22px] w-[22px]" /></span>
          <h3 class="font-titles text-[19px] leading-[1.25] text-white sm:text-[20px]">{s.title}</h3>
          <p class="text-[15px] leading-[1.6] text-blue-tint">{s.body}</p>
          <span class="mt-auto inline-flex items-center gap-2 pt-2 text-[14px] font-bold text-white">{l.learn}<Icon name="arrow" class="h-[15px] w-[15px] transition-transform group-hover:translate-x-0.5" /></span>
        </a>
      ))}
    </div>
    <div class="flex flex-col gap-4 pt-9">
      <p class="text-[12px] font-bold uppercase tracking-[0.1em] text-blue-tint">{content.integrated.relatedLabel}</p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {content.integrated.related.map((r) => (
          <a href={r.href} class={`flex items-center justify-between gap-3 rounded-full border border-white/15 bg-white/5 px-4 py-3 text-[14px] font-semibold text-white hover:bg-white/15 ${hover}`}>
            {r.label}<Icon name="arrow" class="h-[15px] w-[15px] shrink-0" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- TRUST + HOURS -->
<section class="bg-white">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[1fr_400px] lg:gap-14 lg:py-20">
    <div class="flex flex-col gap-4">
      <h2 class="font-titles text-[26px] leading-[1.15] text-ink sm:text-[28px] lg:text-[32px]">{content.trust.heading}</h2>
      {content.trust.paras.map((p) => <p class="max-w-[68ch] text-[16px] leading-[1.62] text-body">{p}</p>)}
      <img src={content.trust.image} width="560" height="320" alt={content.trust.imageAlt} loading="lazy" decoding="async" class="mt-2 h-[240px] w-full rounded-lg object-cover object-top lg:h-[300px]" />
    </div>
    <div class="flex flex-col gap-5">
      <div class={`flex flex-col gap-4 rounded-lg border border-line bg-bg-alt p-7 ${hover}`}>
        <p class="flex items-center gap-2 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep">
          <Icon name="clock" class="h-4 w-4" />{content.trust.hoursLabel}
        </p>
        <ul class="flex flex-col">
          {content.trust.hours.map((h, i) => (
            <li class={`flex items-center justify-between gap-4 py-3.5 text-[15px] ${i > 0 ? "border-t border-line" : ""}`}>
              <span class="text-body">{h.day}</span>
              <span class="text-right font-semibold text-ink">{h.time}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class={`flex flex-col gap-3 rounded-lg bg-blue-deep p-7 ${hover}`}>
        <p class="text-[12px] font-bold uppercase tracking-[0.1em] text-blue-tint">{content.trust.locationLabel}</p>
        <p class="whitespace-pre-line text-[16px] font-semibold leading-[1.5] text-white">{content.trust.address}</p>
        <a href={PHONE_TEL} class="font-titles text-[22px] font-bold text-white underline-offset-4 transition-all duration-200 hover:-translate-y-0.5 hover:text-blue-tint">{l.call}</a>
      </div>
      <div class={`flex flex-col gap-1.5 rounded-lg border border-line bg-bg-alt p-7 ${hover}`}>
        <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-blue">{content.trust.supervisorLabel}</p>
        <p class="font-titles text-[18px] font-bold text-ink">{supervising.name}</p>
        <p class="text-[13px] font-semibold leading-[1.4] text-blue">{supervising.cred}</p>
        <p class="text-[14px] leading-[1.55] text-body">{supervising.bio}</p>
      </div>
    </div>
  </div>
</section>

<!-- STEPS -->
<section id="start" class="scroll-mt-24 lg:scroll-mt-[184px] bg-bg-alt">
  <div class="shell flex flex-col gap-9 py-16 lg:py-20">
    <div class="flex flex-col gap-4">
      <span class={eyebrowCls}>{eyebrow.steps}</span>
      <h2 class={h2Cls}>{content.steps.heading}</h2>
