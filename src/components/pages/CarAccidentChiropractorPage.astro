        { icon: "move", title: "Extremity pain", body: "We can develop a treatment plan to reduce pain and inflammation in your arms, legs, hands, and feet." },
        { icon: "gauge", title: "Herniated discs", body: "Chiropractic care can help create more space in the spinal canal, alleviating pressure on the nerves." },
        { icon: "bandage", title: "Soft tissue injuries", body: "Chiropractic adjustments and massage therapy can promote healing and reduce pain in muscles, ligaments, and tendons." },
      ],
    },
    when: {
      heading: "When to see a car accident chiropractor in Tampa",
      paras: [
        "Seeking medical attention after a car accident is important, even if you do not feel immediate pain. Some injuries, such as whiplash or soft tissue injury, may not cause symptoms until hours or days later.",
        "A chiropractic evaluation can identify restricted joints, muscle tension, and alignment issues early, so they can be addressed before they become long-term problems.",
      ],
      itemsLabel: "Consider an evaluation if you notice",
      items: [
        "Neck or back pain and stiffness",
        "Headaches or dizziness after the crash",
        "Limited range of motion when turning or bending",
        "Tingling, numbness, or radiating pain",
      ],
      highlight: "In Florida, you must be seen within 14 days to qualify for PIP coverage.",
      image: "/images/how-to-find-doctor-after-a-car-accident-inner-image.webp",
      imageAlt: "A man holding his neck next to damaged cars after a collision",
    },
    why: {
      eyebrow: "Why choose us",
      heading: "Trust Palm Wellness Center for auto accident injuries",
      lead: "Our team of experienced chiropractors understands the impact a car accident can have on your daily life, and we are dedicated to helping you recover.",
      points: [
        "Noninvasive chiropractic care focused on the source of your pain",
        "Coordinated with physical rehabilitation, massage, and ultrasound under one roof",
        "Medical oversight and clear communication in English and Spanish",
        "Documentation that supports your insurance or personal injury claim",
      ],
    },
    trust: {
      heading: "Professional and compassionate care you can trust",
      paras: [
        "Palm Wellness Center combines chiropractic care, rehabilitation services, massage therapy, and therapeutic treatments under one roof. This coordinated approach supports safer movement and long-term recovery after an auto accident.",
        "Palm Wellness Center proudly serves Tampa and nearby communities from 1004 W Linebaugh Ave Ste A, Tampa, FL 33612.",
      ],
      image: "/images/medical-office-chiropractor-rehabilitating-patient-back.webp",
      imageAlt: "A chiropractor performing an adjustment at Palm Wellness Center in Tampa",
      hoursLabel: "Hours",
      hours: [
        { day: "Monday - Friday", time: "10 AM - 7 PM" },
        { day: "Saturday", time: "10 AM - 12 PM (by appointment)" },
        { day: "Sunday", time: "Closed" },
      ],
      locationLabel: "Visit us",
