      note: "Need directions or a ride? Call (813) 443-5370 and our team will help you plan your visit.",
      contactNote: "Free transportation for eligible patients - ask when you book.",
    },
    cta: {
      title: "See a car accident chiropractor in Tampa",
      lead: "Do not let a car accident injury limit your movement. Call Palm Wellness Center or request an evaluation and start a plan to help you recover.",
    },
    labels: { book: "Book Appointment", call: "(813) 443-5370", learn: "Learn more", onThisPage: "On this page" },
  },
  es: {
    hero: {
      eyebrow: "Quiropráctico de Accidentes de Auto en Tampa",
      title: "Quiropráctico de accidentes de auto en Tampa",
      lead: "Nos especializamos en tratamientos quiroprácticos precisos para lesiones comunes por accidentes de auto, como latigazo cervical, hernias de disco y lesiones de tejidos blandos.",
      chips: [
        { icon: "spine", label: "Latigazo y dolor de cuello" },
        { icon: "gauge", label: "Hernias de disco" },
        { icon: "brain", label: "Dolores de cabeza y migrañas" },
        { icon: "bandage", label: "Lesiones de tejidos blandos" },
        { icon: "languages", label: "Bilingüe EN/ES" },
      ],
      note: "Evaluación quiropráctica · Atención no invasiva · Documentación para el seguro",
      image: "/images/auto-accident-injury-background.webp",
      imageAlt: "Conductora sosteniéndose el cuello tras un accidente de auto antes de la atención quiropráctica en Tampa",
      rail: [
        { value: "3 pasos", label: "Examen, diagnóstico, tratamiento" },
        { value: "PIP", label: "Se acepta (plazo de 14 días)" },
        { value: "EN / ES", label: "Atención bilingüe" },
      ],
    },
    subnav: [
      { label: "3 pasos", href: "#steps" },
      { label: "Lesiones", href: "#injuries" },
      { label: "Cuándo consultar", href: "#when" },
      { label: "Por qué elegirnos", href: "#why" },
      { label: "Preguntas", href: "#faq" },
    ],
    steps: {
      eyebrow: "Encuentra alivio en 3 sencillos pasos",
      heading: "Encuentra alivio en tres sencillos pasos",
      lead: "Entendemos el dolor, la rigidez y la alteración que puede causar una lesión por accidente de auto. Nuestro proceso es claro y se enfoca en encontrar la fuente de tu dolor.",
      items: [
        { title: "Examen", body: "Un examen minucioso comienza con una conversación detallada sobre tu accidente y cualquier dolor que estés experimentando, además de un examen físico completo." },
        { title: "Diagnóstico", body: "Usamos técnicas avanzadas para identificar la fuente de tu dolor, que pueden incluir exámenes quiroprácticos, radiografías si es necesario y otras herramientas de diagnóstico." },
        { title: "Tratamiento", body: "Según tu diagnóstico, creamos un plan de tratamiento personalizado que puede incluir ajustes quiroprácticos, terapia de masajes, ejercicios de rehabilitación y más." },
      ],
    },
    injuries: {
      eyebrow: "Atención personalizada",
      heading: "Atención personalizada para lesiones comunes por accidentes de auto",
      lead: "La atención quiropráctica puede abordar varias lesiones causadas por un choque. Estas son las que tratamos con más frecuencia.",
      items: [
        { icon: "spine", title: "Latigazo cervical", body: "Los ajustes quiroprácticos y la fisioterapia pueden ayudar a mejorar la movilidad y reducir el dolor." },
        { icon: "brain", title: "Dolores de cabeza y migrañas", body: "La atención quiropráctica puede ayudar a mejorar la alineación del cuello y reducir la inflamación que puede contribuir a los dolores de cabeza." },
        { icon: "move", title: "Dolor en las extremidades", body: "Podemos desarrollar un plan para reducir el dolor y la inflamación en brazos, piernas, manos y pies." },
        { icon: "gauge", title: "Hernias de disco", body: "La atención quiropráctica puede ayudar a crear más espacio en el canal espinal, aliviando la presión sobre los nervios." },
        { icon: "bandage", title: "Lesiones de tejidos blandos", body: "Los ajustes quiroprácticos y la terapia de masajes pueden promover la curación y reducir el dolor en músculos, ligamentos y tendones." },
      ],
    },
    when: {
      heading: "Cuándo consultar a un quiropráctico de accidentes de auto en Tampa",
      paras: [
        "Buscar atención médica después de un accidente de auto es importante, incluso si no sientes dolor de inmediato. Algunas lesiones, como el latigazo cervical o las lesiones de tejidos blandos, pueden no causar síntomas hasta horas o días después.",
        "Una evaluación quiropráctica puede identificar articulaciones restringidas, tensión muscular y problemas de alineación a tiempo, para tratarlos antes de que se vuelvan problemas a largo plazo.",
      ],
      itemsLabel: "Considera una evaluación si notas",
      items: [
        "Dolor y rigidez de cuello o espalda",
        "Dolores de cabeza o mareos tras el choque",
        "Rango de movimiento limitado al girar o agacharte",
        "Hormigueo, entumecimiento o dolor irradiado",
      ],
      highlight: "En Florida, debes ser atendido dentro de los 14 días para calificar para la cobertura PIP.",
      image: "/images/how-to-find-doctor-after-a-car-accident-inner-image.webp",
      imageAlt: "Hombre sosteniéndose el cuello junto a autos dañados tras una colisión",
    },
    why: {
      eyebrow: "Por qué elegirnos",
      heading: "Confía en Palm Wellness Center para lesiones por accidentes de auto",
      lead: "Nuestro equipo de quiroprácticos con experiencia entiende el impacto que un accidente de auto puede tener en tu vida diaria, y nos dedicamos a ayudarte a recuperarte.",
      points: [
        "Atención quiropráctica no invasiva enfocada en la fuente de tu dolor",
        "Coordinada con rehabilitación física, masajes y ultrasonido en un solo lugar",
        "Supervisión médica y comunicación clara en inglés y español",
        "Documentación que respalda tu reclamo de seguro o de lesiones personales",
      ],
    },
    trust: {
      heading: "Atención profesional y compasiva en la que puedes confiar",
      paras: [
        "Palm Wellness Center combina atención quiropráctica, servicios de rehabilitación, terapia de masajes y tratamientos terapéuticos bajo un mismo techo. Este enfoque coordinado apoya un movimiento más seguro y una recuperación a largo plazo tras un accidente de auto.",
        "Palm Wellness Center atiende con orgullo a Tampa y comunidades cercanas desde 1004 W Linebaugh Ave Ste A, Tampa, FL 33612.",
      ],
      image: "/images/medical-office-chiropractor-rehabilitating-patient-back.webp",
      imageAlt: "Quiropráctico realizando un ajuste en Palm Wellness Center en Tampa",
      hoursLabel: "Horario",
      hours: [
        { day: "Lunes - Viernes", time: "10 AM - 7 PM" },
        { day: "Sábado", time: "10 AM - 12 PM (con cita previa)" },
        { day: "Domingo", time: "Cerrado" },
      ],
      locationLabel: "Visítanos",
      address: "1004 W Linebaugh Ave Ste A\nTampa, FL 33612",
      supervisorLabel: "Supervisión médica",
    },
    transport: {
      title: "¿Necesitas transporte? Nosotros te ayudamos.",
      body: "Palm Wellness Center ofrece asistencia de transporte para pacientes elegibles en toda el área de la Bahía de Tampa. Si el transporte es una preocupación, avísale a nuestro equipo cuando llames o solicites una cita, y te ayudaremos a coordinar tu visita.",
      image: "/images/patient-transportation-assistance.webp",
      imageAlt: "Miembro del personal ayudando a una paciente a bajar de un vehículo de transporte de cortesía en Tampa Bay",
    },
    faq: {
      heading: "Preguntas frecuentes",
      note: "¿Aún tienes preguntas? Llámanos al (813) 443-5370 y nuestro equipo te explicará tus opciones y qué esperar.",
      items: [
        { q: "¿Quién paga el tratamiento quiropráctico después de un accidente de auto en Florida?", a: "En Florida, el PIP del seguro de auto a menudo cubre la atención quiropráctica tras un accidente, independientemente de quién tenga la culpa, según tu póliza, el momento y la elegibilidad. Podemos ayudarte a entender cómo encaja la atención en tu proceso con el seguro; confirma la cobertura con tu aseguradora o representante legal." },
        { q: "¿Cuáles son las lesiones más comunes en un accidente de auto?", a: "El latigazo cervical, el dolor de cuello y espalda, los dolores de cabeza y migrañas, el dolor en las extremidades, las hernias de disco y las lesiones de tejidos blandos están entre las más comunes." },
        { q: "¿Cuánto tiempo necesitaré atención quiropráctica después de un accidente?", a: "Cada recuperación es diferente. Tu proveedor recomienda un plan según tus lesiones, síntomas y cómo responde tu cuerpo, y lo ajusta a medida que mejoras." },
        { q: "¿Debo consultar al quiropráctico incluso si no siento dolor tras un accidente de auto?", a: "Sí. El latigazo cervical y las lesiones de tejidos blandos a menudo no causan síntomas hasta horas o días después. Una evaluación temprana puede identificar problemas antes de que empeoren." },
        { q: "¿Por qué tantos abogados de lesiones personales remiten a sus pacientes a un quiropráctico de accidentes de auto?", a: "La atención quiropráctica se enfoca en restaurar el movimiento y la función articular, y documenta tus lesiones y tu progreso. Esa combinación respalda tanto tu recuperación como tu reclamo." },
        { q: "¿Los quiroprácticos trabajan con otros médicos?", a: "Sí. En Palm Wellness Center, la atención quiropráctica se coordina con proveedores médicos y servicios de rehabilitación para que tu atención se mantenga conectada." },
        { q: "¿Qué sucede si pierdo el plazo de 14 días para buscar atención médica según la ley PIP de Florida?", a: "El PIP de Florida generalmente requiere que te atiendan dentro de los 14 días posteriores al accidente para calificar para la cobertura. Si no estás seguro de tu plazo, llámanos y te ayudaremos a entender tus opciones." },
      ],
