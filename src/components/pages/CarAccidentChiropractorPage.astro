      supervisorLabel: "Medical supervision",
    },
    transport: {
      title: "Need a ride? We have got you covered.",
      body: "Palm Wellness Center offers transportation assistance for eligible patients throughout the Tampa Bay area. If transportation is a concern, let our team know when you call or request an appointment, and we will help coordinate your visit.",
      image: "/images/patient-transportation-assistance.webp",
      imageAlt: "Clinic staff member assisting a patient from a courtesy transportation SUV in Tampa Bay",
    },
    faq: {
      heading: "Frequently asked questions",
      note: "Still have questions? Call us at (813) 443-5370 and our team will walk you through your options and what to expect.",
      items: [
        { q: "Who pays for chiropractic treatment after a car accident in Florida?", a: "In Florida, auto insurance PIP often covers chiropractic care after an accident regardless of fault, depending on your policy, timing, and eligibility. We can help you understand how care fits into your insurance process; confirm coverage with your carrier or legal representative." },
        { q: "What are the most common injuries from an auto accident?", a: "Whiplash, neck and back pain, headaches and migraines, extremity pain, herniated discs, and soft tissue injuries are among the most common." },
        { q: "How long will I need chiropractic care after an accident?", a: "Every recovery is different. Your provider recommends a plan based on your injuries, symptoms, and how your body responds, and adjusts it as you improve." },
