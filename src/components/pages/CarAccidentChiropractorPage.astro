import { APPOINTMENT_URL, PHONE_TEL } from "../../i18n/utils";
import Icon from "../Icon.astro";
import AnchorNav from "../AnchorNav.astro";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const content = {
  en: {
