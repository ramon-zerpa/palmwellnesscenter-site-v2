import Icon from "../Icon.astro";

interface Props {
  lang: Lang;
  kind: "hipaa" | "privacy";
}
const { lang, kind } = Astro.props;

type Block = { p?: string; ul?: string[]; ol?: string[] };
type Section = { id: string; h: string; blocks: Block[]; card?: boolean };
type Doc = {
  eyebrow: string;
  icon: string;
  title: string;
  subtitle?: string;
  lead: string;
  notice?: string;
  sections: Section[];
};
type Docs = { hipaa: Doc; privacy: Doc };

const docs: Record<Lang, Docs> = {
  en: {
    hipaa: {
      eyebrow: "Legal · HIPAA",
      icon: "shield-check",
      title: "HIPAA Policy",
      subtitle: "Notice of Privacy Practices",
      lead: "How Palm Wellness Center may use and disclose the medical information we keep about you, and the rights you have over it.",
      notice:
        "This notice describes how medical information about you may be used and disclosed, and how you can get access to this information. Please review it carefully.",
      sections: [
        {
          id: "use",
          h: "Use of Data",
          blocks: [
            {
              p: `We understand that your medical information is personal. We are committed to protecting your medical information. This Notice describes how Palm Wellness Center (the "Facility") may use your medical information and disclose it to others outside the Facility. The law requires the Facility to:`,
            },
            {
              ul: [
                "Make sure that medical information that identifies you is kept private;",
                "Inform you of our legal duties and privacy practices concerning your medical information;",
                "Follow the terms of the Notice that is currently in effect; and",
                "Notify you if your medical information is affected by a breach.",
