const doc = docs[lang][kind];

const eyebrowCls =
  "inline-flex w-fit items-center gap-1.5 rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep";
---

<!-- HEADER -->
<section class="border-b border-line bg-bg-alt">
  <div class="shell py-14 lg:py-20">
    <div class="flex max-w-[820px] flex-col gap-5">
      <span class={eyebrowCls}><Icon name={doc.icon} class="h-3.5 w-3.5" />{doc.eyebrow}</span>
      <div class="flex flex-col gap-2">
        <h1 class="font-titles text-[32px] leading-[1.1] text-ink sm:text-[38px] lg:text-[44px]">{doc.title}</h1>
        {doc.subtitle && <p class="font-titles text-[18px] text-blue-deep lg:text-[20px]">{doc.subtitle}</p>}
      </div>
      <p class="max-w-[68ch] text-[16px] leading-[1.7] text-body sm:text-[17px]">{doc.lead}</p>
    </div>
  </div>
</section>

<!-- BODY -->
<section class="bg-white">
  <div class="shell py-14 lg:py-20">
    {doc.notice && (
      <div class="mb-12 flex max-w-[75ch] gap-3 rounded-lg border border-blue-tint bg-blue-pale/50 p-5 lg:p-6">
        <Icon name="info" class="mt-0.5 h-5 w-5 shrink-0 text-blue-deep" />
        <p class="text-[13px] font-semibold uppercase leading-[1.6] tracking-[0.04em] text-blue-deep lg:text-[13.5px]">
          {doc.notice}
        </p>
      </div>
    )}
    <div class="flex max-w-[75ch] flex-col gap-12">
      {doc.sections.map((s) => (
        <section id={s.id} class="scroll-mt-24">
          <h2 class="font-titles text-[22px] leading-[1.2] text-ink lg:text-[26px]">{s.h}</h2>
          <div class={`prose mt-4${s.card ? " rounded-lg border border-line bg-bg-alt p-6 lg:p-7" : ""}`}>
            {s.blocks.map((b) =>
              b.p ? (
                <p set:html={b.p} />
              ) : b.ul ? (
                <ul>{b.ul.map((it) => <li set:html={it} />)}</ul>
              ) : b.ol ? (
                <ol>{b.ol.map((it) => <li set:html={it} />)}</ol>
              ) : null
            )}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>
