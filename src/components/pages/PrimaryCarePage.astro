  faq: "/images/primary-care-vs-urgent-care-inner-img-2.webp",
};

const supervising = {
  en: { name: "Dr. Arnaldo V. Orellana-Molina", cred: "MD - Supervising Physician", bio: "Provides medical oversight that ensures safe, guideline-aligned care across every service." },
  es: { name: "Dr. Arnaldo V. Orellana-Molina", cred: "MD - Médico Supervisor", bio: "Brinda supervisión médica que garantiza una atención segura y alineada con las guías clínicas." },
}[lang];

const backToTop = lang === "es" ? "Volver arriba" : "Back to top";

const eyebrow = {
  en: { services: "Our Services", membership: "Membership", integrated: "Integrated Wellness", choose: "Why Patients Choose", steps: "How to Get Started", faq: "FAQ", area: "Service Area" },
  es: { services: "Nuestros Servicios", membership: "Membresía", integrated: "Bienestar Integrado", choose: "Por Qué Elegirnos", steps: "Cómo Comenzar", faq: "Preguntas", area: "Área de Servicio" },
}[lang];
---

<!-- HERO -->
<section class="bg-bg-alt">
  <div class="shell grid items-center gap-10 py-14 lg:grid-cols-2 lg:py-20">
    <div class="flex flex-col items-start gap-5">
      <span class="inline-flex rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{content.hero.eyebrow}</span>
      <h1 class="text-4xl leading-[1.08] text-ink sm:text-5xl">{content.hero.title}</h1>
      <p class="max-w-xl text-[18px] leading-relaxed text-body">{content.hero.lead}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {content.hero.badges.map((b) => (
          <li class="flex items-center gap-2 text-[13.5px] font-semibold text-ink">
            <Icon name="check" class="h-4 w-4 shrink-0 text-green-dark" />{b}
          </li>
        ))}
      </ul>
      <div class="flex flex-wrap gap-3">
        <a href={APPOINTMENT_URL} {...bookAttrs} class="inline-flex items-center gap-2 rounded-md bg-blue px-6 py-3.5 font-bold text-white transition-colors hover:bg-blue-deep">
          <Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}
        </a>
        <a href={PHONE_TEL} class="inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue bg-white px-6 py-3.5 font-bold text-blue transition-colors hover:bg-blue-pale">
          <Icon name="phone" class="h-[18px] w-[18px]" />{l.call}
        </a>
      </div>
      <p class="text-[13px] text-muted">{content.hero.note}</p>
    </div>
    <div class="relative">
      <img src={content.hero.image} width="560" height="440" alt={content.hero.imageAlt} fetchpriority="high" decoding="async" class="h-[460px] w-full rounded-lg object-cover" />
    </div>
  </div>
</section>

<!-- ANCHOR NAV -->
<nav class="border-b border-line bg-white lg:sticky lg:top-[78px] lg:z-40" aria-label="On this page">
  <div class="shell flex gap-6 overflow-x-auto py-3.5">
    {content.subnav.map((s) => (
      <a href={s.href} class="whitespace-nowrap text-[14px] font-semibold text-body transition-colors hover:text-blue">{s.label}</a>
    ))}
  </div>
</nav>

<!-- INTRO -->
<section class="bg-white" id="about">
  <div class="shell grid items-start gap-10 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
    <div class="flex flex-col gap-5">
      <h2 class="text-3xl leading-tight text-ink sm:text-[2.3rem]">{content.intro.heading}</h2>
      {content.intro.paras.map((p) => <p class="max-w-[68ch] text-[17px] leading-relaxed text-body">{p}</p>)}
      <dl class="mt-2 grid gap-4 border-t border-line pt-6 sm:grid-cols-3">
        {content.intro.stats.map((s) => (
          <div class="flex flex-col gap-1">
            <dt class="text-[20px] font-bold text-blue-deep">{s.value}</dt>
            <dd class="text-[13.5px] uppercase tracking-wide text-muted">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
    <img src={media.intro} width="560" height="520" alt={content.intro.heading} loading="lazy" decoding="async" class="h-[520px] w-full rounded-lg object-cover" />
  </div>
</section>

<!-- SERVICES -->
<section class="scroll-mt-24 bg-bg-alt" id="services">
  <div class="shell grid gap-12 py-16 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="flex flex-col gap-4 lg:sticky lg:top-32 lg:self-start">
      <span class="w-fit rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{eyebrow.services}</span>
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{content.services.heading}</h2>
      <p class="max-w-[42ch] text-[16px] leading-relaxed text-body">{content.services.lead}</p>
      <img src={content.services.image} width="480" height="360" alt={content.services.imageAlt} loading="lazy" decoding="async" class="mt-2 w-full rounded-lg object-cover" />
    </div>
    <ul class="flex flex-col">
      {content.services.items.map((s) => (
        <li class="flex items-start gap-5 border-t border-line py-7 first:border-t-0 first:pt-0">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-md bg-white text-blue-deep"><Icon name={s.icon} class="h-6 w-6" /></span>
          <div class="flex flex-col gap-1.5">
            <h3 class="text-[20px] text-ink">{s.title}</h3>
            <p class="max-w-[60ch] text-[15px] leading-relaxed text-body">{s.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- MEMBERSHIP -->
<section class="scroll-mt-24 bg-white" id="membership">
  <div class="shell flex flex-col gap-10 py-16">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col gap-4">
        <span class="w-fit rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{eyebrow.membership}</span>
        <h2 class="text-3xl text-ink sm:text-[2.1rem]">{content.membership.heading}</h2>
        <p class="text-[17px] leading-relaxed text-body">{content.membership.lead}</p>
      </div>
      <img src={media.membership} width="560" height="340" alt={content.membership.heading} loading="lazy" decoding="async" class="h-[340px] w-full rounded-lg object-cover" />
    </div>
    <div class="grid gap-6 lg:grid-cols-2">
      <article class="flex flex-col gap-5 rounded-lg bg-blue-deep p-8 text-blue-tint">
        <span class="w-fit rounded-full bg-white/15 px-3 py-1 text-[12px] font-bold uppercase tracking-wide text-white">{content.membership.member.tag}</span>
        <p class="flex items-end gap-2">
          <strong class="text-[46px] leading-none text-white">{content.membership.member.price}</strong>
          <span class="pb-1.5 text-[15px]">{content.membership.member.cadence}</span>
        </p>
        <ul class="flex flex-col gap-3 text-[14.5px]">
          {content.membership.member.benefits.map((b) => (
            <li class="flex items-start gap-2.5"><Icon name="check" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-green-bright" />{b}</li>
          ))}
        </ul>
        <a href={APPOINTMENT_URL} {...bookAttrs} class="mt-auto inline-flex items-center justify-center gap-2 rounded-md bg-white px-5 py-3 text-[15px] font-bold text-blue-deep transition-colors hover:bg-blue-pale">
          <Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}
        </a>
      </article>
      <article class="flex flex-col gap-5 rounded-lg border border-line bg-bg-alt p-8">
        <span class="w-fit rounded-full bg-blue-pale px-3 py-1 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{content.membership.nonMember.tag}</span>
        <p class="flex flex-col">
          <strong class="text-[28px] leading-tight text-ink">{content.membership.nonMember.price}</strong>
          <span class="mt-1 text-[15px] text-body">{content.membership.nonMember.cadence}</span>
        </p>
        <ul class="flex flex-col gap-3 text-[14.5px] text-body">
          {content.membership.nonMember.benefits.map((b) => (
            <li class="flex items-start gap-2.5"><Icon name="check" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-green-dark" />{b}</li>
          ))}
        </ul>
        <a href={PHONE_TEL} class="mt-auto inline-flex items-center justify-center gap-2 rounded-md border-[1.5px] border-blue bg-white px-5 py-3 text-[15px] font-bold text-blue transition-colors hover:bg-blue-pale">
          <Icon name="phone" class="h-[18px] w-[18px]" />{l.call}
        </a>
      </article>
    </div>
  </div>
</section>

<!-- INTEGRATED -->
<section class="scroll-mt-24 bg-bg-alt" id="integrated">
  <div class="shell flex flex-col gap-10 py-16">
    <div class="flex max-w-[720px] flex-col gap-4">
      <span class="w-fit rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{eyebrow.integrated}</span>
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{content.integrated.heading}</h2>
      <p class="text-[17px] leading-relaxed text-body">{content.integrated.lead}</p>
    </div>
    <div class="grid gap-px overflow-hidden rounded-lg border border-line bg-line md:grid-cols-3">
      {content.integrated.items.map((s, i) => (
        <a href={s.href} class="group flex flex-col bg-white transition-colors hover:bg-bg-alt">
          <img src={media.integrated[i]} alt={s.title} width="400" height="210" loading="lazy" decoding="async" class="h-[210px] w-full object-cover" />
          <span class="flex flex-1 flex-col gap-3 p-7">
            <span class="grid h-12 w-12 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={s.icon} class="h-6 w-6" /></span>
            <h3 class="text-[19px] text-ink">{s.title}</h3>
            <p class="text-[14.5px] leading-relaxed text-body">{s.body}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-2 text-[14px] font-bold text-blue group-hover:text-blue-deep">{l.learn} {s.title} <Icon name="arrow" class="h-4 w-4" /></span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- WHY -->
<section class="bg-white">
  <div class="shell grid items-center gap-12 py-16 lg:grid-cols-2">
    <img src={content.why.image} width="560" height="460" alt={content.why.imageAlt} loading="lazy" decoding="async" class="h-[480px] w-full rounded-lg object-cover" />
    <div class="flex flex-col gap-5">
      <h2 class="text-3xl text-ink sm:text-[2rem]">{content.why.heading}</h2>
      <p class="text-[16px] leading-relaxed text-body">{content.why.lead}</p>
      <p class="text-[15px] leading-relaxed text-body">{content.why.closing}</p>
    </div>
  </div>
</section>

<!-- TRUST + HOURS -->
<section class="bg-bg-alt">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[1.3fr_0.7fr] lg:gap-14">
    <div class="flex flex-col gap-5">
      <h2 class="text-3xl text-ink sm:text-[2rem]">{content.trust.heading}</h2>
      {content.trust.paras.map((p) => <p class="max-w-[68ch] text-[16px] leading-relaxed text-body">{p}</p>)}
      <img src={media.trust} width="560" height="320" alt={content.trust.heading} loading="lazy" decoding="async" class="mt-1 h-[320px] w-full rounded-lg object-cover" />
    </div>
    <div class="flex flex-col gap-4 rounded-lg border border-line bg-white p-7">
      <p class="flex items-center gap-2 text-[13px] font-bold uppercase tracking-wide text-blue-deep">
        <Icon name="clock" class="h-4 w-4" />{content.trust.hoursLabel}
      </p>
      <ul class="flex flex-col divide-y divide-line">
        {content.trust.hours.map((h) => (
          <li class="flex items-center justify-between gap-4 py-3 text-[15px]">
            <span class="text-body">{h.day}</span>
            <span class="font-semibold text-ink">{h.time}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- TRANSPORT -->
<section class="bg-white">
  <div class="shell grid items-center gap-10 overflow-hidden py-16 lg:grid-cols-2">
    <img src={content.transport.image} width="560" height="360" alt={content.transport.imageAlt} loading="lazy" decoding="async" class="h-[380px] w-full rounded-lg object-cover" />
    <div class="flex flex-col gap-4">
      <h2 class="text-3xl text-ink sm:text-[2rem]">{content.transport.title}</h2>
      <p class="max-w-[62ch] text-[16px] leading-relaxed text-body">{content.transport.body}</p>
      <a href={PHONE_TEL} class="inline-flex w-fit items-center gap-2 rounded-md bg-blue px-6 py-3.5 font-bold text-white transition-colors hover:bg-blue-deep">
        <Icon name="phone" class="h-[18px] w-[18px]" />{l.call}
      </a>
    </div>
  </div>
</section>

<!-- WHY PATIENTS CHOOSE -->
<section class="bg-bg-alt">
  <div class="shell flex flex-col gap-10 py-16">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col gap-4">
        <span class="w-fit rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{eyebrow.choose}</span>
        <h2 class="text-3xl text-ink sm:text-[2.1rem]">{content.choose.heading}</h2>
        <p class="text-[17px] leading-relaxed text-body">{content.choose.lead}</p>
      </div>
      <img src={media.choose} width="560" height="320" alt={content.choose.heading} loading="lazy" decoding="async" class="h-[320px] w-full rounded-lg object-cover" />
    </div>
    <div class="grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
      {content.choose.items.map((it) => (
        <div class="flex flex-col gap-2">
          <p class="flex items-center gap-2 text-[16px] font-bold text-ink"><Icon name="badge-check" class="h-5 w-5 shrink-0 text-blue" />{it.title}</p>
          <p class="text-[14.5px] leading-relaxed text-body">{it.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- TEAM -->
<section class="scroll-mt-24 bg-white" id="team">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[0.6fr_1.4fr] lg:gap-14">
    <div class="flex flex-col items-start gap-4">
      <img src={media.team} width="280" height="220" alt={content.team.name} loading="lazy" decoding="async" class="h-[220px] w-full max-w-[280px] rounded-lg object-cover" />
      <div>
        <h2 class="text-[24px] text-ink">{content.team.name}</h2>
        <p class="mt-1 text-[14px] font-semibold text-blue">{content.team.cred}</p>
      </div>
    </div>
    <div class="flex flex-col gap-5">
      <h3 class="text-[13px] font-bold uppercase tracking-wide text-muted">{content.team.heading}</h3>
      {content.team.bio.map((p) => <p class="max-w-[68ch] text-[16px] leading-relaxed text-body">{p}</p>)}
      <blockquote class="border-t border-line pt-6 text-[19px] font-medium leading-relaxed text-blue-deep">
        "{content.team.quote}"
      </blockquote>
      <div class="flex flex-col gap-1.5 border-t border-line pt-5">
        <p class="text-[19px] font-bold text-ink">{supervising.name}</p>
        <p class="text-[13px] font-semibold text-blue">{supervising.cred}</p>
        <p class="text-[15px] leading-relaxed text-body">{supervising.bio}</p>
      </div>
    </div>
  </div>
</section>

<!-- STEPS -->
<section class="scroll-mt-24 bg-bg-alt" id="start">
  <div class="shell flex flex-col gap-10 py-16">
    <div class="flex flex-col gap-4">
      <span class="w-fit rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{eyebrow.steps}</span>
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{content.steps.heading}</h2>
    </div>
    <ol class="grid gap-6 md:grid-cols-3">
      {content.steps.items.map((s, i) => (
        <li class="flex flex-col gap-3 rounded-lg border border-line bg-white p-7">
          <span class="text-[13px] font-bold uppercase tracking-wide text-blue-deep">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="text-[20px] text-ink">{s.title}</h3>
          <p class="text-[15px] leading-relaxed text-body">{s.body}</p>
        </li>
      ))}
    </ol>
    <p class="text-[13px] text-muted">{content.steps.note}</p>
  </div>
</section>

<!-- FAQ -->
<section class="scroll-mt-24 bg-white" id="faq">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
    <div class="flex flex-col gap-6">
      <span class="w-fit rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{eyebrow.faq}</span>
      <h2 class="text-3xl text-ink sm:text-[2.1rem]">{content.faq.heading}</h2>
      <img src={media.faq} width="480" height="300" alt={content.faq.heading} loading="lazy" decoding="async" class="hidden h-[300px] w-full rounded-lg object-cover lg:block" />
    </div>
    <div class="flex flex-col gap-3">
      {content.faq.items.map((item) => (
        <details class="group border-t border-line pt-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-semibold text-ink">
            <span>{item.q}</span>
            <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-blue transition-transform group-open:rotate-180" />
          </summary>
          <p class="pt-3 text-[15px] leading-relaxed text-body">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- AREA -->
<section class="bg-bg-alt">
  <div class="shell grid gap-10 py-16 lg:grid-cols-2 lg:gap-14">
    <div class="flex flex-col gap-4">
      <span class="w-fit rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{eyebrow.area}</span>
      <h2 class="text-3xl text-ink sm:text-[2rem]">{content.area.heading}</h2>
      <p class="max-w-[60ch] text-[16px] leading-relaxed text-body">{content.area.lead}</p>
      <p class="max-w-[60ch] text-[15px] leading-relaxed text-body">{content.area.note}</p>
    </div>
    <div class="flex flex-col gap-5">
      <ul class="flex flex-wrap content-start gap-3">
        {content.area.places.map((p) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2.5 text-[15px] font-medium text-ink">
            <Icon name="map-pin" class="h-4 w-4 text-blue" />{p}
          </li>
        ))}
      </ul>
      <img src={media.area} width="560" height="260" alt={content.area.heading} loading="lazy" decoding="async" class="h-[260px] w-full rounded-lg object-cover" />
    </div>
  </div>
</section>

<!-- RELATED -->
<section class="bg-white">
  <div class="shell flex flex-col items-center gap-8 py-14">
    <h2 class="text-[22px] text-ink">{content.related.heading}</h2>
    <ul class="flex flex-wrap justify-center gap-3">
      {content.related.links.map((lk) => (
        <li>
          <a href={lk.href} class="inline-flex items-center gap-2 rounded-full border border-line bg-bg-alt px-4 py-2.5 text-[15px] font-semibold text-blue transition-colors hover:bg-blue-pale hover:text-blue-deep">
            {lk.label} <Icon name="arrow" class="h-4 w-4" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<div class="bg-white">
  <div class="shell flex justify-end py-6">
    <a href="#main" class="inline-flex items-center gap-2 text-[14px] font-semibold text-blue transition-colors hover:text-blue-deep">
      <Icon name="chevron-down" class="h-4 w-4 rotate-180" />{backToTop}
    </a>
  </div>
</div>

<!-- FINAL CTA -->
<section class="bg-blue-deep">
  <div class="shell flex flex-col items-center gap-4 py-16 text-center">
    <h2 class="max-w-[820px] text-3xl text-white sm:text-[2.1rem]">{content.cta.title}</h2>
    <p class="max-w-[640px] text-[17px] leading-relaxed text-blue-tint">{content.cta.lead}</p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      <a href={APPOINTMENT_URL} {...bookAttrs} class="inline-flex items-center gap-2 rounded-md bg-white px-7 py-3.5 font-bold text-blue-deep transition-colors hover:bg-blue-pale">
        <Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}
      </a>
      <a href={PHONE_TEL} class="inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue-tint px-6 py-3.5 font-bold text-white transition-colors hover:bg-white/10">
        <Icon name="phone" class="h-[18px] w-[18px]" />{l.call}
      </a>
    </div>
  </div>
</section>
