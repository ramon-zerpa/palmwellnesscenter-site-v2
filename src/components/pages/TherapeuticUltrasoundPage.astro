        <p class="text-[15px] leading-[1.6] text-body">{content.expect.freqPara}</p>
        <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.expect.freqLabel}</p>
        <ul class="flex flex-col gap-3">
          {content.expect.freqItems.map((t) => (
            <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="circle-check" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-blue" />{t}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- SAFETY -->
<section id="safety" class="scroll-mt-24 lg:scroll-mt-[184px] bg-white">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[1fr_440px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-4">
      <span class={eyebrowCls}><Icon name="shield-check" class="h-3.5 w-3.5" />{content.safety.eyebrow}</span>
      <h2 class={h2Cls}>{content.safety.heading}</h2>
      {content.safety.paras.map((p) => <p class="max-w-[62ch] text-[16px] leading-[1.62] text-body">{p}</p>)}
      <p class="max-w-[62ch] text-[15px] leading-[1.6] text-muted">{content.safety.note}</p>
    </div>
    <div class="flex flex-col gap-4 rounded-lg border border-line bg-bg-alt p-7 lg:p-8">
      <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.safety.contraLabel}</p>
      <ul class="flex flex-col gap-3">
        {content.safety.contra.map((t) => (
          <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="triangle-alert" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-danger" />{t}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- REHAB (dark band) -->
<section class="bg-blue-deep">
  <div class="shell flex flex-col gap-10 py-16 lg:py-20">
