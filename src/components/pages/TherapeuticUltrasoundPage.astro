          ))}
        </ul>
      </div>
      <div class="flex flex-col gap-4 rounded-lg border border-line bg-bg-alt p-7 lg:p-8">
        <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.when.helpLabel}</p>
        <ul class="grid gap-3 sm:grid-cols-2">
          {content.when.help.map((it) => (
            <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="circle-check" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-blue" />{it}</li>
          ))}
