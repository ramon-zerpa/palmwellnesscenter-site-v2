        <img src={content.what.image} width="600" height="440" alt={content.what.imageAlt} loading="lazy" decoding="async" class="h-[260px] w-full rounded-lg object-cover sm:h-[340px] lg:absolute lg:inset-0 lg:h-full" />
      </div>
      <div class="flex flex-col gap-4">
        <p class="text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.what.pointsLabel}</p>
        <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          {content.what.points.map((p) => (
            <div class={`flex items-start gap-4 rounded-lg border border-line bg-white p-5 lg:p-6 ${hover}`}>
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={p.icon} class="h-5 w-5" /></span>
              <div class="flex flex-col gap-1">
                <h3 class="font-titles text-[16px] leading-[1.25] text-ink">{p.title}</h3>
                <p class="text-[14px] leading-[1.5] text-body">{p.body}</p>
