      <p class={leadCls}>{content.signs.lead}</p>
    </div>
    <div class="overflow-hidden rounded-lg border border-line">
      <div class="hidden grid-cols-2 bg-blue-deep sm:grid">
        {content.signs.head.map((h, i) => (
          <div class={`px-6 py-4 text-[12px] font-bold uppercase tracking-[0.08em] text-white ${i > 0 ? "border-l border-white/20" : ""}`}>{h}</div>
        ))}
      </div>
      {content.signs.rows.map((r, i) => (
        <div class={`grid gap-1.5 sm:grid-cols-2 sm:gap-0 ${i > 0 ? "border-t border-line" : ""}`}>
          <div class="px-6 pt-5 font-semibold text-ink sm:py-5">{r[0]}</div>
          <div class="px-6 pb-5 text-[15px] leading-[1.55] text-body sm:border-l sm:border-line sm:py-5">{r[1]}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- PERSISTS -->
<section class="bg-white">
  <div class="shell grid items-center gap-10 py-16 lg:grid-cols-[1fr_460px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-5">
      <h2 class={h2Cls}>{content.persists.heading}</h2>
      <p class="max-w-[62ch] text-[16px] leading-[1.62] text-body">{content.persists.lead}</p>
      <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.persists.itemsLabel}</p>
      <ul class="grid gap-3 sm:grid-cols-2">
        {content.persists.items.map((it) => (
          <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="check" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-green-dark" />{it}</li>
        ))}
      </ul>
      <p class="max-w-[62ch] text-[15px] leading-[1.6] text-muted">{content.persists.note}</p>
    </div>
    <img src={content.persists.image} width="460" height="460" alt={content.persists.imageAlt} loading="lazy" decoding="async" class="h-[280px] w-full rounded-lg object-cover sm:h-[380px] lg:h-[440px]" />
  </div>
</section>

<!-- WHAT TO EXPECT -->
<section id="expect" class="scroll-mt-24 lg:scroll-mt-[184px] bg-bg-alt">
  <div class="shell flex flex-col gap-9 py-16 lg:py-20">
    <div class="grid gap-6 lg:grid-cols-[1fr_420px] lg:items-end lg:gap-12">
      <div class="flex flex-col gap-4">
        <span class={eyebrowCls}><Icon name="route" class="h-3.5 w-3.5" />{content.expect.eyebrow}</span>
        <h2 class={h2Cls}>{content.expect.heading}</h2>
