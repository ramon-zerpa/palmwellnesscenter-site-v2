        { q: "¿Cada cuánto debo tener una visita preventiva?", a: "La mayoría de los adultos se beneficia de una visita de bienestar al año. Tu proveedor puede recomendar otra frecuencia según tu edad, tus factores de riesgo y cualquier condición que manejes." },
        { q: "¿Qué pruebas de detección ofrecen?", a: "Los paneles de bienestar, hormonales y metabólicos se hacen en el mismo lugar. Cuando se recomienda una prueba como mamografía, colonoscopía o revisión de la piel, te explicamos por qué y ayudamos a agendarla." },
        { q: "¿Cuánto cuestan los paneles de laboratorio?", a: "La Evaluación Preventiva Anual con Panel Básico cuesta $145, el Perfil Hormonal Completo $189 y el Panel Metabólico Completo $250. Tu proveedor solo ordenará lo que sea clínicamente útil en tu visita." },
        { q: "¿Aceptan seguros y Medicare?", a: "Aceptamos la mayoría de los seguros principales, incluido Medicare. Llama al (813) 443-5370 para verificar tu cobertura antes de tu visita." },
        { q: "¿Puedo hacer un seguimiento preventivo por telemedicina?", a: "Sí: la revisión de laboratorios, los ajustes de medicamentos y los seguimientos pueden hacerse por telemedicina en toda Florida. Algunos exámenes requieren una visita presencial; tu proveedor te lo indicará." },
        { q: "¿Necesito una membresía?", a: "No. Puedes pagar por visita o unirte a la Membresía Médica Mensual ($99 para comenzar y luego $39/mes) para consultas extendidas y mensajería directa con tu proveedor." },
      ],
    },
    area: {
      heading: "Sirviendo con orgullo a Tampa y sus vecindarios",
      lead: "Ubicados en el corazón de Tampa en 1004 W Linebaugh Ave, atendemos a pacientes de todo el condado de Hillsborough y comunidades cercanas.",
      places: ["Seminole Heights", "Forest Hills", "Carrollwood", "Town 'N' Country", "Temple Terrace", "Brandon", "Westchase"],
      note: "El transporte gratuito está disponible para pacientes elegibles en toda la Bahía de Tampa, para que tu visita anual de bienestar sea fácil de mantener.",
      contactNote: "Transporte gratis para pacientes elegibles - pregúntalo al reservar.",
    },
    cta: {
      title: "Adelántate a tu salud este año",
      lead: "Reserva una visita preventiva y vete con una idea clara de tu salud, y un plan para el año que viene.",
    },
    labels: { book: "Reservar cita", call: "(813) 443-5370", learn: "Ver más", onThisPage: "En esta página" },
  },
}[lang];

const bookAttrs = { target: "_blank", rel: "noopener" } as const;
const l = content.labels;

const eyebrow = {
  en: { exams: "What's Included", visit: "Your Visit", labs: "Screenings & Labs", why: "Who It's For", types: "Which Visit Do You Need?", integrated: "Integrated Wellness", steps: "How to Get Started", faq: "FAQ", area: "Service Area" },
  es: { exams: "Qué Incluye", visit: "Tu Visita", labs: "Pruebas y Laboratorio", why: "Para Quién Es", types: "¿Qué Visita Necesitas?", integrated: "Bienestar Integrado", steps: "Cómo Comenzar", faq: "Preguntas", area: "Área de Servicio" },
}[lang];

const supervising = {
  en: { name: "Dr. Arnaldo V. Orellana-Molina", cred: "MD - Supervising Physician", bio: "Provides medical oversight that keeps your preventive care safe and guideline-aligned." },
  es: { name: "Dr. Arnaldo V. Orellana-Molina", cred: "MD - Médico Supervisor", bio: "Brinda supervisión médica que mantiene tu atención preventiva segura y alineada con las guías clínicas." },
}[lang];

const backToTop = lang === "es" ? "Volver arriba" : "Back to top";

// Single hover language: a 2px lift plus ONE soft black shadow. It belongs to
// things the user can act on, or to the single card that fronts an action —
// never to both at once.
const hover = "hover-lift";

const eyebrowCls = "inline-flex w-fit items-center gap-1.5 rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep";
const eyebrowDarkCls = "inline-flex w-fit items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-tint";
const h2Cls = "font-titles text-[26px] leading-[1.15] text-ink sm:text-[30px] lg:text-[34px]";
const leadCls = "text-[16px] leading-[1.6] text-body sm:text-[17px]";
const btnBookCls = `inline-flex items-center gap-2 rounded-md bg-blue px-6 py-3.5 font-bold text-white hover:bg-blue-deep ${hover}`;
const btnCallCls = `inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue bg-white px-6 py-3.5 font-bold text-blue hover:bg-blue-pale ${hover}`;
---

<!-- HERO -->
<section class="relative isolate overflow-hidden bg-bg-alt">
  <div class="hero-ambient" aria-hidden="true">
    <span class="hero-pulse"></span>
  </div>
  <div class="shell relative flex flex-col gap-10 pt-12 pb-26 lg:gap-12 lg:pt-16 lg:pb-32">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_560px] lg:gap-12">
      <div class="flex flex-col items-start gap-5">
        <span class={eyebrowCls}><Icon name="shield-check" class="h-3.5 w-3.5" />{content.hero.eyebrow}</span>
        <h1 class="font-titles text-[32px] leading-[1.08] text-ink sm:text-[38px] lg:text-[46px]">{content.hero.title}</h1>
        <p class="max-w-xl text-[17px] leading-[1.6] text-body sm:text-[18px]">{content.hero.lead}</p>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-3">
          {content.hero.chips.map((c) => (
            <li class="flex items-center gap-2">
              <span class="grid h-[30px] w-[30px] shrink-0 place-items-center rounded-full bg-blue-pale text-blue-deep"><Icon name={c.icon} class="h-4 w-4" /></span>
              <span class="text-[14px] font-semibold text-ink">{c.label}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-3.5">
          <a href={APPOINTMENT_URL} {...bookAttrs} class={btnBookCls}><Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}</a>
          <a href={PHONE_TEL} class={btnCallCls}><Icon name="phone" class="h-[18px] w-[18px]" />{l.call}</a>
        </div>
        <p class="text-[13px] text-muted">{content.hero.note}</p>
      </div>
      <div class="hero-media-frame h-[280px] sm:h-[380px] lg:h-[440px]">
        <div class="hero-media">
          <img src={content.hero.image} width="560" height="440" alt={content.hero.imageAlt} fetchpriority="high" decoding="async" class="hero-media__img object-center" />
          <span class="hero-heart h-12 w-12 lg:h-14 lg:w-14" aria-hidden="true">
            <Icon name="heart" solid class="h-5 w-5 lg:h-6 lg:w-6" />
          </span>
        </div>
      </div>
    </div>
    <dl class={`grid gap-8 rounded-lg border border-line bg-white px-7 py-7 sm:grid-cols-3 lg:px-10 ${hover}`}>
      {content.hero.rail.map((r) => (
        <div class="flex flex-col gap-1">
          <dt class="font-titles text-[26px] font-bold leading-none text-blue-deep lg:text-[30px]">{r.value}</dt>
          <dd class="text-[13px] text-muted">{r.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- ANCHOR NAV — in flow after the hero; sticks flush to the bottom edge of the
     sticky primary nav (header is 70px at lg, 64px below), so no gap appears. -->
<AnchorNav label={l.onThisPage} items={content.subnav} />

<!-- INTRO -->
<section class="bg-white">
  <div class="shell grid items-start gap-10 py-16 lg:grid-cols-[1fr_480px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-5">
      <h2 class={h2Cls}>{content.intro.heading}</h2>
      {content.intro.paras.map((p) => <p class="max-w-[68ch] text-[16px] leading-[1.62] text-body">{p}</p>)}
    </div>
    <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-1">
      {content.intro.compare.map((c, i) => (
        <div class={i === 1
          ? `flex flex-col gap-2.5 rounded-lg bg-blue-deep p-7 ${hover}`
          : `flex flex-col gap-2.5 rounded-lg border border-line bg-bg-alt p-7 ${hover}`}>
          <p class={i === 1 ? "text-[11px] font-bold uppercase tracking-[0.1em] text-blue-tint" : "text-[11px] font-bold uppercase tracking-[0.1em] text-muted"}>{c.tag}</p>
          <p class={i === 1 ? "font-titles text-[34px] font-bold leading-none text-white" : "font-titles text-[34px] font-bold leading-none text-ink"}>{c.value}</p>
          <p class={i === 1 ? "text-[15px] leading-[1.55] text-blue-tint" : "text-[15px] leading-[1.55] text-body"}>{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- WHAT'S INCLUDED -->
<section id="exams" class="scroll-mt-24 lg:scroll-mt-[184px] bg-bg-alt">
  <div class="shell flex flex-col gap-10 py-16 lg:py-20">
    <div class="flex max-w-[720px] flex-col gap-4">
      <span class={eyebrowCls}><Icon name="shield-check" class="h-3.5 w-3.5" />{eyebrow.exams}</span>
      <h2 class={h2Cls}>{content.included.heading}</h2>
      <p class={leadCls}>{content.included.lead}</p>
    </div>
    <ul class="grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {content.included.items.map((c) => (
        <li class="flex flex-col gap-3.5 bg-white p-7">
          <span class="grid h-12 w-12 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={c.icon} class="h-[22px] w-[22px]" /></span>
          <h3 class="font-titles text-[18px] leading-[1.25] text-ink sm:text-[19px]">{c.title}</h3>
          <p class="text-[14.5px] leading-[1.55] text-body">{c.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- YOUR VISIT (dark band) -->
<section id="visit" class="scroll-mt-24 lg:scroll-mt-[184px] bg-blue-deep">
  <div class="shell flex flex-col gap-9 py-16 lg:py-20">
    <div class="flex max-w-[800px] flex-col gap-4">
      <span class={eyebrowDarkCls}>{eyebrow.visit}</span>
      <h2 class="font-titles text-[26px] leading-[1.15] text-white sm:text-[30px] lg:text-[34px]">{content.approach.heading}</h2>
      <p class="text-[16px] leading-[1.6] text-blue-tint sm:text-[17px]">{content.approach.lead}</p>
    </div>
    <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {content.approach.steps.map((s, i) => (
        <li class="flex flex-col gap-3 border-t border-white/15 pt-6">
          <span class="font-titles text-[15px] font-bold text-green-bright">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="font-titles text-[19px] leading-[1.25] text-white">{s.title}</h3>
          <p class="text-[14.5px] leading-[1.55] text-blue-tint">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- SCREENINGS & LABS -->
<section id="labs" class="scroll-mt-24 lg:scroll-mt-[184px] bg-white">
  <div class="shell grid items-center gap-12 py-16 lg:grid-cols-[1fr_460px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-5">
      <span class={eyebrowCls}><Icon name="clipboard-check" class="h-3.5 w-3.5" />{eyebrow.labs}</span>
      <h2 class={h2Cls}>{content.labs.heading}</h2>
      <p class="max-w-[62ch] text-[16px] leading-[1.62] text-body sm:text-[17px]">{content.labs.body}</p>
      <ul class="grid gap-3.5 sm:grid-cols-2">
        {content.labs.points.map((p) => (
          <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="check" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-green-dark" />{p}</li>
        ))}
      </ul>
    </div>
    <article class={`flex flex-col gap-4 rounded-lg border border-line bg-bg-alt p-7 lg:p-9 ${hover}`}>
      <p class="text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.labs.cardLabel}</p>
      <ul class="flex flex-col">
        {content.labs.panels.map((panel, i) => (
          <li class={`flex items-baseline justify-between gap-4 py-3.5 ${i > 0 ? "border-t border-line" : ""}`}>
            <span class="text-[14.5px] leading-[1.45] text-body">{panel.name}</span>
            <span class="shrink-0 font-titles text-[18px] font-bold text-ink">{panel.price}</span>
          </li>
        ))}
      </ul>
      <p class="border-t border-line pt-4 text-[13px] leading-[1.55] text-muted">{content.labs.note}</p>
    </article>
  </div>
</section>

<!-- WHO IT'S FOR + IMAGE -->
<section class="bg-bg-alt">
  <div class="shell grid items-center gap-12 py-16 lg:grid-cols-[560px_1fr] lg:gap-16 lg:py-20">
    <img src={content.who.image} width="560" height="460" alt={content.who.imageAlt} loading="lazy" decoding="async" class="h-[300px] w-full rounded-lg object-cover sm:h-[380px] lg:h-[480px]" />
    <div class="flex flex-col gap-5">
      <span class={eyebrowCls}>{eyebrow.why}</span>
      <h2 class={h2Cls}>{content.who.heading}</h2>
      <p class={leadCls}>{content.who.lead}</p>
      <ul class="grid gap-3.5 sm:grid-cols-2">
        {content.who.points.map((p) => (
          <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="check" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-green-dark" />{p}</li>
        ))}
      </ul>
      <div class={`rounded-md bg-white p-5 ${hover}`}>
        <p class="text-[14.5px] leading-[1.55] text-body">{content.who.closing}</p>
      </div>
    </div>
  </div>
</section>

<!-- WHICH VISIT DO YOU NEED? (3 types) -->
<section class="bg-white">
  <div class="shell flex flex-col gap-10 py-16 lg:py-20">
    <div class="flex max-w-[760px] flex-col gap-4">
      <span class={eyebrowCls}>{eyebrow.types}</span>
      <h2 class={h2Cls}>{content.compareTypes.heading}</h2>
      <p class={leadCls}>{content.compareTypes.lead}</p>
    </div>
    <ul class="grid gap-px overflow-hidden rounded-lg border border-line bg-line md:grid-cols-3">
      {content.compareTypes.items.map((c) => (
        <li class="flex flex-col gap-3.5 bg-white p-7 lg:p-8">
          <span class="grid h-12 w-12 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={c.icon} class="h-[22px] w-[22px]" /></span>
          <h3 class="font-titles text-[19px] leading-[1.25] text-ink">{c.title}</h3>
          <p class="text-[14.5px] leading-[1.55] text-body">{c.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- INTEGRATED (dark band) -->
<section class="bg-blue-deep">
  <div class="shell flex flex-col gap-9 py-16 lg:py-20">
    <div class="flex max-w-[720px] flex-col gap-4">
      <span class={eyebrowDarkCls}>{eyebrow.integrated}</span>
      <h2 class="font-titles text-[26px] leading-[1.15] text-white sm:text-[30px] lg:text-[34px]">{content.integrated.heading}</h2>
      <p class="text-[16px] leading-[1.6] text-blue-tint sm:text-[17px]">{content.integrated.lead}</p>
    </div>
    <div class="grid overflow-hidden rounded-lg border border-white/15 bg-white/5 sm:grid-cols-2 lg:grid-cols-4">
      {content.integrated.items.map((s, i) => (
        <a href={s.href} class={`group flex flex-col gap-3.5 p-7 hover:bg-white/10 lg:p-8 ${hover} ${i > 0 ? "border-t border-white/15 sm:border-l sm:border-t-0" : ""}`}>
          <span class="grid h-12 w-12 place-items-center rounded-md bg-white/10 text-white"><Icon name={s.icon} class="h-[22px] w-[22px]" /></span>
          <h3 class="font-titles text-[19px] leading-[1.25] text-white sm:text-[20px]">{s.title}</h3>
          <p class="text-[15px] leading-[1.6] text-blue-tint">{s.body}</p>
          <span class="mt-auto inline-flex items-center gap-2 pt-2 text-[14px] font-bold text-white">{l.learn}<Icon name="arrow" class="h-[15px] w-[15px] transition-transform group-hover:translate-x-0.5" /></span>
        </a>
      ))}
    </div>
    <div class="flex flex-col gap-4 pt-9">
      <p class="text-[12px] font-bold uppercase tracking-[0.1em] text-blue-tint">{content.integrated.relatedLabel}</p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {content.integrated.related.map((r) => (
          <a href={r.href} class={`flex items-center justify-between gap-3 rounded-full border border-white/15 bg-white/5 px-4 py-3 text-[14px] font-semibold text-white hover:bg-white/15 ${hover}`}>
            {r.label}<Icon name="arrow" class="h-[15px] w-[15px] shrink-0" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- TRUST + HOURS -->
<section class="bg-white">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[1fr_400px] lg:gap-14 lg:py-20">
    <div class="flex flex-col gap-4">
      <h2 class="font-titles text-[26px] leading-[1.15] text-ink sm:text-[28px] lg:text-[32px]">{content.trust.heading}</h2>
      {content.trust.paras.map((p) => <p class="max-w-[68ch] text-[16px] leading-[1.62] text-body">{p}</p>)}
      <img src={content.trust.image} width="560" height="320" alt={content.trust.imageAlt} loading="lazy" decoding="async" class="mt-2 h-[240px] w-full rounded-lg object-cover object-top lg:h-[300px]" />
    </div>
    <div class="flex flex-col gap-5">
      <div class={`flex flex-col gap-4 rounded-lg border border-line bg-bg-alt p-7 ${hover}`}>
        <p class="flex items-center gap-2 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep">
          <Icon name="clock" class="h-4 w-4" />{content.trust.hoursLabel}
        </p>
        <ul class="flex flex-col">
          {content.trust.hours.map((h, i) => (
            <li class={`flex items-center justify-between gap-4 py-3.5 text-[15px] ${i > 0 ? "border-t border-line" : ""}`}>
              <span class="text-body">{h.day}</span>
              <span class="text-right font-semibold text-ink">{h.time}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class={`flex flex-col gap-3 rounded-lg bg-blue-deep p-7 ${hover}`}>
        <p class="text-[12px] font-bold uppercase tracking-[0.1em] text-blue-tint">{content.trust.locationLabel}</p>
        <p class="whitespace-pre-line text-[16px] font-semibold leading-[1.5] text-white">{content.trust.address}</p>
        <a href={PHONE_TEL} class="font-titles text-[22px] font-bold text-white underline-offset-4 transition-all duration-200 hover:-translate-y-0.5 hover:text-blue-tint">{l.call}</a>
      </div>
      <div class={`flex flex-col gap-1.5 rounded-lg border border-line bg-bg-alt p-7 ${hover}`}>
        <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-blue">{content.trust.supervisorLabel}</p>
        <p class="font-titles text-[18px] font-bold text-ink">{supervising.name}</p>
        <p class="text-[13px] font-semibold leading-[1.4] text-blue">{supervising.cred}</p>
        <p class="text-[14px] leading-[1.55] text-body">{supervising.bio}</p>
      </div>
    </div>
  </div>
</section>

<!-- STEPS -->
<section id="start" class="scroll-mt-24 lg:scroll-mt-[184px] bg-bg-alt">
  <div class="shell flex flex-col gap-9 py-16 lg:py-20">
    <div class="flex flex-col gap-4">
      <span class={eyebrowCls}>{eyebrow.steps}</span>
      <h2 class={h2Cls}>{content.steps.heading}</h2>
    </div>
    <ol class="grid gap-5 md:grid-cols-3">
      {content.steps.items.map((s, i) => (
        <li class={`flex flex-col gap-3 rounded-lg border border-line bg-white p-7 lg:p-8 ${hover}`}>
          <span class="text-[13px] font-bold tracking-[0.1em] text-blue-deep">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="font-titles text-[20px] leading-[1.25] text-ink">{s.title}</h3>
          <p class="text-[15px] leading-[1.6] text-body">{s.body}</p>
        </li>
      ))}
    </ol>
    <p class="text-[13px] text-muted">{content.steps.note}</p>
  </div>
</section>

<!-- TRANSPORT -->
<section class="bg-white">
  <div class="shell grid items-center gap-10 py-16 lg:grid-cols-[560px_1fr] lg:gap-16 lg:py-20">
    <img src={content.transport.image} width="560" height="400" alt={content.transport.imageAlt} loading="lazy" decoding="async" class="h-[240px] w-full rounded-lg object-cover sm:h-[320px] lg:h-[400px]" />
    <div class="flex flex-col items-start gap-5">
      <h2 class={h2Cls}>{content.transport.title}</h2>
      <p class="max-w-[62ch] text-[16px] leading-[1.6] text-body sm:text-[17px]">{content.transport.body}</p>
      <a href={PHONE_TEL} class={btnBookCls}><Icon name="phone" class="h-[18px] w-[18px]" />{l.call}</a>
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="scroll-mt-24 lg:scroll-mt-[184px] bg-bg-alt">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[400px_1fr] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-4">
      <span class={eyebrowCls}>{eyebrow.faq}</span>
      <h2 class={h2Cls}>{content.faq.heading}</h2>
      <p class="text-[15px] leading-[1.6] text-body">{content.faq.note}</p>
    </div>
    <div class="flex flex-col">
      {content.faq.items.map((item, i) => (
        <details class={`group ${i > 0 ? "border-t border-line" : ""}`} {...(i === 0 ? { open: true } : {})}>
          <summary class="-mx-4 flex cursor-pointer list-none items-center justify-between gap-4 rounded-md px-4 py-5 text-[17px] font-bold text-ink transition-colors hover:bg-white [&::-webkit-details-marker]:hidden">
            <span>{item.q}</span>
            <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-blue transition-transform group-open:rotate-180" />
          </summary>
          <p class="max-w-[62ch] pb-5 text-[15px] leading-[1.6] text-body">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- SERVICE AREA -->
<section class="bg-white">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[1fr_560px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-4">
      <span class={eyebrowCls}>{eyebrow.area}</span>
      <h2 class="font-titles text-[26px] leading-[1.15] text-ink sm:text-[28px] lg:text-[32px]">{content.area.heading}</h2>
      <p class="max-w-[60ch] text-[16px] leading-[1.62] text-body">{content.area.lead}</p>
      <p class="max-w-[60ch] text-[15px] leading-[1.6] text-muted">{content.area.note}</p>
    </div>
    <div class={`flex flex-col gap-6 rounded-lg border border-line bg-bg-alt p-7 lg:p-8 ${hover}`}>
      <ul class="flex flex-wrap gap-2.5">
        {content.area.places.map((p) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2.5 text-[14px] font-semibold text-ink">
            <Icon name="map-pin" class="h-4 w-4 text-blue" />{p}
          </li>
        ))}
      </ul>
      <div class="flex items-center gap-3 border-t border-line pt-5">
        <Icon name="car" class="h-5 w-5 shrink-0 text-green-dark" />
        <p class="text-[14px] font-semibold text-body">{content.area.contactNote}</p>
      </div>
    </div>
  </div>
</section>

<!-- BACK TO TOP -->
<div class="bg-white">
  <div class="shell flex justify-end py-6">
    <a href="#main" class="inline-flex items-center gap-2 text-[14px] font-semibold text-blue transition-colors hover:text-blue-deep">
      <Icon name="chevron-down" class="h-4 w-4 rotate-180" />{backToTop}
    </a>
  </div>
</div>

<!-- FINAL CTA -->
<section class="bg-blue-deep">
  <div class="shell flex flex-col items-center gap-4 py-16 text-center lg:py-18">
    <h2 class="max-w-[820px] font-titles text-[26px] leading-[1.15] text-white sm:text-[30px] lg:text-[34px]">{content.cta.title}</h2>
    <p class="max-w-[640px] text-[16px] leading-[1.6] text-blue-tint sm:text-[17px]">{content.cta.lead}</p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      <a href={APPOINTMENT_URL} {...bookAttrs} class={`inline-flex items-center gap-2 rounded-md bg-white px-7 py-3.5 font-bold text-blue-deep hover:bg-blue-pale ${hover}`}>
        <Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}
      </a>
      <a href={PHONE_TEL} class={`inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue-tint px-6 py-3.5 font-bold text-white hover:bg-white/10 ${hover}`}>
        <Icon name="phone" class="h-[18px] w-[18px]" />{l.call}
      </a>
    </div>
  </div>
</section>
