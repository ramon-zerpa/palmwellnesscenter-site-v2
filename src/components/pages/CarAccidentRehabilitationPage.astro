      hoursLabel: "Horario",
      hours: [
        { day: "Lunes - Viernes", time: "10 AM - 7 PM" },
        { day: "Sábado", time: "10 AM - 12 PM (con cita previa)" },
        { day: "Domingo", time: "Cerrado" },
      ],
      locationLabel: "Visítanos",
      address: "1004 W Linebaugh Ave Ste A\nTampa, FL 33612",
      supervisorLabel: "Supervisión médica",
    },
    transport: {
      title: "¿Necesitas transporte? Nosotros te ayudamos.",
      body: "Palm Wellness Center ofrece asistencia de transporte para pacientes elegibles en toda el área de la Bahía de Tampa. Si el transporte es una preocupación, avísale a nuestro equipo cuando llames o solicites una cita, y te ayudaremos a coordinar tu visita.",
      image: "/images/patient-transportation-assistance.webp",
      imageAlt: "Miembro del personal ayudando a una paciente a bajar de un vehículo de transporte de cortesía en Tampa Bay",
    },
    faq: {
      heading: "Preguntas frecuentes",
      note: "¿Aún tienes preguntas? Llámanos al (813) 443-5370 y nuestro equipo te explicará tus opciones, cómo agendar y qué esperar.",
      items: [
        { q: "¿Qué es la rehabilitación de accidentes de auto?", a: "Es un programa estructurado de recuperación que te ayuda a restaurar el movimiento, recuperar fuerza y retomar tus actividades diarias tras un accidente de auto. Puede combinar rehabilitación física, atención quiropráctica, terapia manual, masajes, ejercicios terapéuticos, ultrasonido y seguimiento médico." },
        { q: "¿Qué tan pronto debo comenzar rehabilitación tras un accidente de auto?", a: "Lo mejor es comenzar lo antes posible tras el choque. Una evaluación temprana ayuda a documentar tus lesiones, identificar limitaciones de movimiento y comenzar un plan antes de que se instalen la rigidez o los patrones de compensación. Aunque los síntomas aparezcan días después, aún puedes comenzar." },
        { q: "¿Con qué lesiones puede ayudar la rehabilitación de accidentes de auto?", a: "Puede ayudar con latigazo cervical y dolor de cuello, dolor de espalda y tensión en la columna, molestias en el hombro, dolor o inestabilidad en la rodilla, dolores de cabeza, tensión muscular, lesiones de tejidos blandos, síntomas nerviosos, rango de movimiento reducido y dificultad con las tareas diarias." },
        { q: "¿La rehabilitación de accidentes de auto es lo mismo que la fisioterapia?", a: "La fisioterapia puede formar parte de la rehabilitación, pero la rehabilitación es más amplia. En Palm Wellness Center puede combinar atención quiropráctica, terapia manual, masajes, ejercicios terapéuticos, ultrasonido y coordinación médica según tu lesión." },
        { q: "¿Cuánto tiempo toma la rehabilitación tras un accidente de auto?", a: "Cada recuperación es diferente. Algunos pacientes se sienten mejor en pocas visitas, mientras que otros necesitan más tiempo cuando la lesión afecta varias áreas del cuerpo o los síntomas fueron tardíos. Tu proveedor ajusta el plan a medida que avanzas." },
        { q: "¿PIP cubre la rehabilitación de accidentes de auto en Florida?", a: "PIP de Florida puede ayudar a cubrir atención médicamente necesaria tras un accidente de auto, según tu póliza, el momento, la elegibilidad y la necesidad médica. Nuestro equipo puede ayudarte a entender cómo encaja la rehabilitación en tu recuperación; confirma la cobertura con tu aseguradora o representante legal." },
        { q: "¿Qué pasa si mi dolor comenzó días después del accidente?", a: "Los síntomas tardíos son comunes. El dolor, la rigidez o los síntomas nerviosos pueden aparecer días después de un choque. Por eso importa una evaluación temprana, y aún puedes comenzar la rehabilitación aunque los síntomas hayan empezado después." },
        { q: "¿La rehabilitación puede ayudarme a volver al trabajo o a mis actividades diarias?", a: "Sí. El objetivo es ayudarte a volver al trabajo, a conducir, dormir, levantar peso, caminar y a tus tareas diarias con mejor movimiento y menos molestias. Tu plan se ajusta a medida que mejoran tu fuerza y movilidad." },
      ],
    },
    area: {
      eyebrow: "Área de Servicio",
      heading: "Sirviendo con orgullo a Tampa y sus vecindarios",
      lead: "Palm Wellness Center está ubicado en Tampa, FL, y atiende a pacientes de toda el área circundante. Regularmente ayudamos a pacientes a mejorar su movilidad y reducir molestias tras un accidente de auto.",
      places: ["Seminole Heights", "Forest Hills", "Carrollwood", "North Tampa", "Comunidades del área de Tampa Bay"],
      note: "¿Necesitas indicaciones o asistencia de transporte? Llama al (813) 443-5370 y nuestro equipo te ayudará a planificar tu visita.",
      contactNote: "Transporte gratis para pacientes elegibles - pregúntalo al reservar.",
    },
    cta: {
      title: "Programa tu rehabilitación de accidente de auto en Tampa",
      lead: "Si el dolor, la rigidez, una lesión de tejidos blandos, los dolores de cabeza o el movimiento limitado afectan tu recuperación, comienza con una evaluación y un plan según tus metas.",
    },
    labels: { book: "Reservar cita", call: "(813) 443-5370", learn: "Ver más", onThisPage: "En esta página" },
  },
}[lang];

const bookAttrs = { target: "_blank", rel: "noopener" } as const;
const l = content.labels;

const backToTop = lang === "es" ? "Volver arriba" : "Back to top";

// Single hover language: a 2px lift plus ONE soft black shadow. It belongs to
// things the user can act on, or to the single card that fronts an action —
// never to both at once.
const hover = "hover-lift";

const eyebrowCls = "inline-flex w-fit items-center gap-1.5 rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep";
const eyebrowDarkCls = "inline-flex w-fit items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-tint";
const h2Cls = "font-titles text-[26px] leading-[1.15] text-ink sm:text-[30px] lg:text-[34px]";
const leadCls = "text-[16px] leading-[1.6] text-body sm:text-[17px]";
const btnBookCls = `inline-flex items-center gap-2 rounded-md bg-blue px-6 py-3.5 font-bold text-white hover:bg-blue-deep ${hover}`;
const btnCallCls = `inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue bg-white px-6 py-3.5 font-bold text-blue hover:bg-blue-pale ${hover}`;
---

<!-- HERO -->
<section class="relative isolate overflow-hidden bg-bg-alt">
  <div class="hero-ambient" aria-hidden="true">
    <span class="hero-pulse"></span>
  </div>
  <div class="shell relative flex flex-col gap-10 pt-12 pb-26 lg:gap-12 lg:pt-16 lg:pb-32">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_560px] lg:gap-12">
      <div class="flex flex-col items-start gap-5">
        <span class={eyebrowCls}><Icon name="car" class="h-3.5 w-3.5" />{content.hero.eyebrow}</span>
        <h1 class="font-titles text-[32px] leading-[1.08] text-ink sm:text-[38px] lg:text-[46px]">{content.hero.title}</h1>
        <p class="max-w-xl text-[17px] leading-[1.6] text-body sm:text-[18px]">{content.hero.lead}</p>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-3">
          {content.hero.chips.map((c) => (
            <li class="flex items-center gap-2">
              <span class="grid h-[30px] w-[30px] shrink-0 place-items-center rounded-full bg-blue-pale text-blue-deep"><Icon name={c.icon} class="h-4 w-4" /></span>
              <span class="text-[14px] font-semibold text-ink">{c.label}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-3.5">
          <a href={APPOINTMENT_URL} {...bookAttrs} class={btnBookCls}><Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}</a>
          <a href={PHONE_TEL} class={btnCallCls}><Icon name="phone" class="h-[18px] w-[18px]" />{l.call}</a>
        </div>
        <p class="text-[13px] text-muted">{content.hero.note}</p>
      </div>
      <div class="hero-media-frame h-[280px] sm:h-[380px] lg:h-[440px]">
        <div class="hero-media">
          <img src={content.hero.image} width="560" height="440" alt={content.hero.imageAlt} fetchpriority="high" decoding="async" class="hero-media__img object-center" />
          <span class="hero-heart h-12 w-12 lg:h-14 lg:w-14" aria-hidden="true">
            <Icon name="heart-pulse" solid class="h-5 w-5 lg:h-6 lg:w-6" />
          </span>
        </div>
      </div>
    </div>
    <dl class={`grid gap-8 rounded-lg border border-line bg-white px-7 py-7 sm:grid-cols-3 lg:px-10 ${hover}`}>
      {content.hero.rail.map((r) => (
        <div class="flex flex-col gap-1">
          <dt class="font-titles text-[26px] font-bold leading-none text-blue-deep lg:text-[30px]">{r.value}</dt>
          <dd class="text-[13px] text-muted">{r.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- ANCHOR NAV — in flow after the hero; sticks flush to the bottom edge of the
     sticky primary nav (header is 70px at lg, 64px below), so no gap appears. -->
<AnchorNav label={l.onThisPage} items={content.subnav} />

<!-- WHY START EARLY -->
<section id="early" class="scroll-mt-24 lg:scroll-mt-[184px] bg-white">
  <div class="shell grid items-start gap-10 py-16 lg:grid-cols-[1fr_480px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-5">
      <h2 class={h2Cls}>{content.early.heading}</h2>
      {content.early.paras.map((p) => <p class="max-w-[68ch] text-[16px] leading-[1.62] text-body">{p}</p>)}
      <ul class="grid gap-3.5 pt-1 sm:grid-cols-2">
        {content.early.items.map((it) => (
          <li class="flex items-start gap-2.5 text-[15px] leading-[1.5] text-ink"><Icon name="check" class="mt-0.5 h-[17px] w-[17px] shrink-0 text-green-dark" />{it}</li>
        ))}
      </ul>
    </div>
    <aside class="flex items-start gap-4 rounded-lg border border-line bg-bg-alt p-7">
      <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name="clipboard-check" class="h-6 w-6" /></span>
      <p class="text-[16px] font-medium leading-[1.55] text-ink">{content.early.highlight}</p>
    </aside>
  </div>
</section>

<!-- WHAT IT HELPS WITH -->
<section id="helps" class="scroll-mt-24 lg:scroll-mt-[184px] bg-bg-alt">
  <div class="shell flex flex-col gap-10 py-16 lg:py-20">
    <div class="grid gap-6 lg:grid-cols-[1fr_420px] lg:items-end lg:gap-12">
      <div class="flex flex-col gap-4">
        <span class={eyebrowCls}><Icon name="car" class="h-3.5 w-3.5" />{content.helps.eyebrow}</span>
        <h2 class={h2Cls}>{content.helps.heading}</h2>
      </div>
      <p class={leadCls}>{content.helps.lead}</p>
    </div>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {content.helps.items.map((c) => (
        <li class="flex flex-col gap-3 rounded-lg border border-line bg-white p-6">
          <span class="grid h-11 w-11 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={c.icon} class="h-5 w-5" /></span>
          <h3 class="font-titles text-[17px] leading-[1.25] text-ink">{c.title}</h3>
          <p class="text-[14px] leading-[1.5] text-body">{c.body}</p>
        </li>
      ))}
    </ul>
    <p class="text-[13px] text-muted">{content.helps.note}</p>
  </div>
</section>

<!-- WHAT'S INCLUDED -->
<section id="included" class="scroll-mt-24 lg:scroll-mt-[184px] bg-white">
  <div class="shell flex flex-col gap-10 py-16 lg:py-20">
    <div class="grid gap-6 lg:grid-cols-[1fr_420px] lg:items-end lg:gap-12">
      <div class="flex flex-col gap-4">
        <span class={eyebrowCls}><Icon name="list-checks" class="h-3.5 w-3.5" />{content.included.eyebrow}</span>
        <h2 class={h2Cls}>{content.included.heading}</h2>
      </div>
      <p class={leadCls}>{content.included.lead}</p>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {content.included.items.map((t) => (
        <a href={t.href} class={`group flex flex-col gap-4 rounded-lg border border-line bg-white p-7 lg:p-8 ${hover}`}>
          <span class="grid h-12 w-12 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={t.icon} class="h-[22px] w-[22px]" /></span>
          <h3 class="font-titles text-[19px] leading-[1.25] text-ink lg:text-[20px]">{t.title}</h3>
          <p class="text-[15px] leading-[1.6] text-body">{t.body}</p>
          <span class="mt-auto inline-flex items-center gap-2 pt-1 text-[14px] font-bold text-blue">{l.learn}<Icon name="arrow" class="h-[15px] w-[15px] transition-transform group-hover:translate-x-0.5" /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- WHAT TO EXPECT (dark band) -->
<section id="expect" class="scroll-mt-24 lg:scroll-mt-[184px] bg-blue-deep">
  <div class="shell flex flex-col gap-9 py-16 lg:py-20">
    <div class="flex max-w-[720px] flex-col gap-4">
      <span class={eyebrowDarkCls}>{content.expect.eyebrow}</span>
      <h2 class="font-titles text-[26px] leading-[1.15] text-white sm:text-[30px] lg:text-[34px]">{content.expect.heading}</h2>
      <p class="text-[16px] leading-[1.6] text-blue-tint sm:text-[17px]">{content.expect.lead}</p>
    </div>
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {content.expect.steps.map((s, i) => (
        <li class={`flex flex-col gap-3 rounded-lg border border-white/15 bg-white/5 p-7 lg:p-8 ${hover}`}>
          <span class="text-[13px] font-bold tracking-[0.1em] text-green-bright">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="font-titles text-[19px] leading-[1.25] text-white lg:text-[20px]">{s.title}</h3>
          <p class="text-[14.5px] leading-[1.6] text-blue-tint">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- WHEN RECOVERY TAKES LONGER -->
<section class="bg-white">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[1fr_480px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-5">
      <h2 class={h2Cls}>{content.linger.heading}</h2>
      {content.linger.paras.map((p) => <p class="max-w-[68ch] text-[16px] leading-[1.62] text-body">{p}</p>)}
    </div>
    <div class="flex flex-col gap-4 rounded-lg border border-line bg-bg-alt p-7 lg:p-8">
      <p class="text-[13px] font-bold uppercase tracking-[0.1em] text-blue-deep">{content.linger.factorsLabel}</p>
      <ul class="flex flex-wrap gap-2.5">
        {content.linger.factors.map((f) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2.5 text-[14px] font-semibold text-ink">
            <Icon name="triangle-alert" class="h-4 w-4 text-blue" />{f}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- COMPARISON -->
<section class="bg-bg-alt">
  <div class="shell flex flex-col gap-9 py-16 lg:py-20">
    <div class="grid gap-6 lg:grid-cols-[1fr_460px] lg:items-end lg:gap-12">
      <div class="flex flex-col gap-4">
        <span class={eyebrowCls}><Icon name="route" class="h-3.5 w-3.5" />{content.compare.eyebrow}</span>
        <h2 class={h2Cls}>{content.compare.heading}</h2>
      </div>
      <p class={leadCls}>{content.compare.lead}</p>
    </div>
    <div class="overflow-hidden rounded-lg border border-line bg-white">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr>
            <th scope="col" class="w-1/2 p-5 text-[13px] font-bold uppercase tracking-[0.08em] text-muted lg:p-6">{content.compare.colLeft}</th>
            <th scope="col" class="w-1/2 bg-blue-pale/40 p-5 text-[13px] font-bold uppercase tracking-[0.08em] text-blue-deep lg:p-6">{content.compare.colRight}</th>
          </tr>
        </thead>
        <tbody>
          {content.compare.rows.map((r) => (
            <tr class="border-t border-line">
              <td class="p-5 text-[15px] leading-[1.5] text-body lg:p-6">{r.left}</td>
              <td class="bg-blue-pale/40 p-5 text-[15px] font-semibold leading-[1.5] text-ink lg:p-6">{r.right}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[14px] text-muted">
      {content.compare.note}
      <span class="font-semibold text-ink">{content.compare.linksLabel}</span>
      {content.compare.links.map((lk) => (
        <a href={lk.href} class="font-semibold text-blue underline-offset-4 hover:text-blue-deep hover:underline">{lk.label}</a>
      ))}
    </p>
  </div>
</section>

<!-- INSURANCE (dark band) -->
<section id="insurance" class="scroll-mt-24 lg:scroll-mt-[184px] bg-blue-deep">
  <div class="shell grid items-center gap-10 py-16 lg:grid-cols-[1fr_440px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-5">
      <span class={eyebrowDarkCls}><Icon name="shield" class="h-3.5 w-3.5" />{content.insurance.eyebrow}</span>
      <h2 class="font-titles text-[26px] leading-[1.15] text-white sm:text-[30px] lg:text-[34px]">{content.insurance.heading}</h2>
      {content.insurance.paras.map((p) => <p class="max-w-[68ch] text-[16px] leading-[1.62] text-blue-tint">{p}</p>)}
      <p class="max-w-[68ch] border-t border-white/15 pt-5 text-[13px] leading-[1.55] text-blue-tint">{content.insurance.note}</p>
    </div>
    <aside class="flex flex-col items-start gap-4 rounded-lg border border-white/15 bg-white/5 p-7 lg:p-8">
      <span class="grid h-12 w-12 place-items-center rounded-md bg-white/10 text-white"><Icon name="clipboard-check" class="h-[22px] w-[22px]" /></span>
      <p class="font-titles text-[19px] font-bold leading-[1.3] text-white lg:text-[20px]">{lang === "es" ? "Atención vinculada a tu lesión del accidente" : "Care connected to your accident injury"}</p>
      <p class="text-[15px] leading-[1.6] text-blue-tint">{lang === "es" ? "La rehabilitación puede formar parte de tu plan cuando es médicamente apropiada y está relacionada con la lesión del accidente de auto." : "Rehabilitation may be part of your plan when it is medically appropriate and connected to your auto accident injury."}</p>
      <a href={APPOINTMENT_URL} {...bookAttrs} class="inline-flex items-center justify-center gap-2 self-stretch rounded-md bg-white px-5 py-3.5 text-[15px] font-bold text-blue-deep transition-colors hover:bg-blue-pale">
        <Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}
      </a>
    </aside>
  </div>
</section>

<!-- TEAM -->
<section id="team" class="scroll-mt-24 lg:scroll-mt-[184px] bg-white">
  <div class="shell flex flex-col gap-10 py-16 lg:py-20">
    <div class="flex max-w-[720px] flex-col gap-4">
      <span class={eyebrowCls}>{content.team.eyebrow}</span>
      <h2 class={h2Cls}>{content.team.heading}</h2>
      <p class={leadCls}>{content.team.lead}</p>
    </div>
    <ul class="grid gap-6 md:grid-cols-3">
      {content.team.members.map((m) => (
        <li class={`flex flex-col gap-4 rounded-lg border border-line bg-bg-alt p-7 lg:p-8 ${hover}`}>
          <span class="grid h-[74px] w-[74px] place-items-center rounded-full bg-blue-deep font-titles text-[26px] font-bold text-white">{m.initials}</span>
          <div class="flex flex-col gap-1">
            <h3 class="font-titles text-[19px] font-bold leading-[1.2] text-ink lg:text-[20px]">{m.name}</h3>
            <p class="text-[13px] font-semibold leading-[1.4] text-blue">{m.cred}</p>
          </div>
          <p class="text-[15px] leading-[1.6] text-body">{m.bio}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- TRUST + HOURS -->
<section class="bg-bg-alt">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[1fr_400px] lg:gap-14 lg:py-20">
    <div class="flex flex-col gap-4">
      <h2 class="font-titles text-[26px] leading-[1.15] text-ink sm:text-[28px] lg:text-[32px]">{content.trust.heading}</h2>
      {content.trust.paras.map((p) => <p class="max-w-[68ch] text-[16px] leading-[1.62] text-body">{p}</p>)}
      <img src={content.trust.image} width="560" height="320" alt={content.trust.imageAlt} loading="lazy" decoding="async" class="mt-2 h-[240px] w-full rounded-lg object-cover object-center lg:h-[300px]" />
    </div>
    <div class="flex flex-col gap-5">
      <div class={`flex flex-col gap-4 rounded-lg border border-line bg-white p-7 ${hover}`}>
        <p class="flex items-center gap-2 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep">
          <Icon name="clock" class="h-4 w-4" />{content.trust.hoursLabel}
        </p>
        <ul class="flex flex-col">
          {content.trust.hours.map((h, i) => (
            <li class={`flex items-center justify-between gap-4 py-3.5 text-[15px] ${i > 0 ? "border-t border-line" : ""}`}>
              <span class="text-body">{h.day}</span>
              <span class="text-right font-semibold text-ink">{h.time}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class={`flex flex-col gap-3 rounded-lg bg-blue-deep p-7 ${hover}`}>
        <p class="text-[12px] font-bold uppercase tracking-[0.1em] text-blue-tint">{content.trust.locationLabel}</p>
        <p class="whitespace-pre-line text-[16px] font-semibold leading-[1.5] text-white">{content.trust.address}</p>
        <a href={PHONE_TEL} class="font-titles text-[22px] font-bold text-white underline-offset-4 transition-all duration-200 hover:-translate-y-0.5 hover:text-blue-tint">{l.call}</a>
      </div>
      <div class={`flex flex-col gap-1.5 rounded-lg border border-line bg-white p-7 ${hover}`}>
        <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-blue">{content.trust.supervisorLabel}</p>
        <p class="font-titles text-[18px] font-bold text-ink">Dr. Arnaldo V. Orellana-Molina</p>
        <p class="text-[13px] font-semibold leading-[1.4] text-blue">{lang === "es" ? "MD - Médico Supervisor" : "MD - Supervising Physician"}</p>
        <p class="text-[14px] leading-[1.55] text-body">{lang === "es" ? "Brinda supervisión médica que mantiene cada plan seguro y alineado con las guías clínicas." : "Provides medical oversight that keeps every care plan safe and guideline-aligned."}</p>
      </div>
    </div>
  </div>
</section>

<!-- TRANSPORT -->
<section class="bg-white">
  <div class="shell grid items-center gap-10 py-16 lg:grid-cols-[560px_1fr] lg:gap-16 lg:py-20">
    <img src={content.transport.image} width="560" height="400" alt={content.transport.imageAlt} loading="lazy" decoding="async" class="h-[240px] w-full rounded-lg object-cover sm:h-[320px] lg:h-[400px]" />
    <div class="flex flex-col items-start gap-5">
      <h2 class={h2Cls}>{content.transport.title}</h2>
      <p class="max-w-[62ch] text-[16px] leading-[1.6] text-body sm:text-[17px]">{content.transport.body}</p>
      <a href={PHONE_TEL} class={btnBookCls}><Icon name="phone" class="h-[18px] w-[18px]" />{l.call}</a>
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="scroll-mt-24 lg:scroll-mt-[184px] bg-bg-alt">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[400px_1fr] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-4">
      <span class={eyebrowCls}>{lang === "es" ? "Preguntas" : "FAQ"}</span>
      <h2 class={h2Cls}>{content.faq.heading}</h2>
      <p class="text-[15px] leading-[1.6] text-body">{content.faq.note}</p>
    </div>
    <div class="flex flex-col">
      {content.faq.items.map((item, i) => (
        <details class={`group ${i > 0 ? "border-t border-line" : ""}`} {...(i === 0 ? { open: true } : {})}>
          <summary class="-mx-4 flex cursor-pointer list-none items-center justify-between gap-4 rounded-md px-4 py-5 text-[17px] font-bold text-ink transition-colors hover:bg-white [&::-webkit-details-marker]:hidden">
            <span>{item.q}</span>
            <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-blue transition-transform group-open:rotate-180" />
          </summary>
          <p class="max-w-[62ch] pb-5 text-[15px] leading-[1.6] text-body">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- SERVICE AREA -->
<section class="bg-white">
  <div class="shell grid gap-10 py-16 lg:grid-cols-[1fr_560px] lg:gap-16 lg:py-20">
    <div class="flex flex-col gap-4">
      <span class={eyebrowCls}>{content.area.eyebrow}</span>
      <h2 class="font-titles text-[26px] leading-[1.15] text-ink sm:text-[28px] lg:text-[32px]">{content.area.heading}</h2>
      <p class="max-w-[60ch] text-[16px] leading-[1.62] text-body">{content.area.lead}</p>
      <p class="max-w-[60ch] text-[15px] leading-[1.6] text-muted">{content.area.note}</p>
    </div>
    <div class={`flex flex-col gap-6 rounded-lg border border-line bg-bg-alt p-7 lg:p-8 ${hover}`}>
      <ul class="flex flex-wrap gap-2.5">
        {content.area.places.map((p) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2.5 text-[14px] font-semibold text-ink">
            <Icon name="map-pin" class="h-4 w-4 text-blue" />{p}
          </li>
        ))}
      </ul>
      <div class="flex items-center gap-3 border-t border-line pt-5">
        <Icon name="car" class="h-5 w-5 shrink-0 text-green-dark" />
        <p class="text-[14px] font-semibold text-body">{content.area.contactNote}</p>
      </div>
    </div>
  </div>
</section>

<!-- BACK TO TOP -->
<div class="bg-white">
  <div class="shell flex justify-end py-6">
    <a href="#main" class="inline-flex items-center gap-2 text-[14px] font-semibold text-blue transition-colors hover:text-blue-deep">
      <Icon name="chevron-down" class="h-4 w-4 rotate-180" />{backToTop}
    </a>
  </div>
</div>

<!-- FINAL CTA -->
<section class="bg-blue-deep">
  <div class="shell flex flex-col items-center gap-4 py-16 text-center lg:py-18">
    <h2 class="max-w-[820px] font-titles text-[26px] leading-[1.15] text-white sm:text-[30px] lg:text-[34px]">{content.cta.title}</h2>
    <p class="max-w-[640px] text-[16px] leading-[1.6] text-blue-tint sm:text-[17px]">{content.cta.lead}</p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      <a href={APPOINTMENT_URL} {...bookAttrs} class={`inline-flex items-center gap-2 rounded-md bg-white px-7 py-3.5 font-bold text-blue-deep hover:bg-blue-pale ${hover}`}>
        <Icon name="calendar-check" class="h-[18px] w-[18px]" />{l.book}
      </a>
      <a href={PHONE_TEL} class={`inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue-tint px-6 py-3.5 font-bold text-white hover:bg-white/10 ${hover}`}>
        <Icon name="phone" class="h-[18px] w-[18px]" />{l.call}
      </a>
    </div>
  </div>
</section>
