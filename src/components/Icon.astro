---
import { lucideInner } from "../lib/lucide";

interface Props { name: string; class?: string; solid?: boolean; }
const { name, class: cls = "h-6 w-6", solid = false } = Astro.props;
const inner = lucideInner(name);
---
<svg
  class={cls}
  viewBox="0 0 24 24"
  fill={solid ? "currentColor" : "none"}
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
