---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import Icon from "./Icon.astro";
import RichSection from "./RichSection.astro";

export interface Block { t: string; text?: string; html?: string; items?: any[]; buttons?: any[]; src?: string; alt?: string; color?: string; lines?: string[]; icon?: string; rows?: string[][]; embed?: string; title?: string; }
interface SecStyle { bg: string; align: string; imgSide: string; hc?: string; bgImg?: string; pair?: string; layout?: string; }
interface Props { lang: Lang; blocks: Block[]; styles?: Record<string, SecStyle>; }
const { lang, blocks, styles = {} } = Astro.props;
const t = useTranslations(lang);
const aboutBandTitle = lang === "es" ? "Da el Primer Paso Hacia Sentirte Mejor" : "Take the First Step Toward Feeling Better";
const norm = (s: string) =>
  (s || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]/g, "");
const currentPath = Astro.url.pathname;
const pathIs = (...paths: string[]) => paths.includes(currentPath);
const headingIs = (heading: string, names: string[]) => names.includes(heading);
const heroConfig: Record<string, { bg: string; variant: "light" | "dark"; position?: string }> = {
  "/physical-rehabilitation/": { bg: "/images/top-physical-rehabilitation-clinic-in-tampa-bay-min.jpg", variant: "light", position: "center right" },
  "/es/fisioterapia/": { bg: "/images/top-physical-rehabilitation-clinic-in-tampa-bay-min.jpg", variant: "light", position: "center right" },
  "/car-accident-rehabilitation/": { bg: "/images/auto-accident-rehabilitation-in-tampa-fl.webp", variant: "light", position: "center right" },
  "/es/rehabilitacion-de-accidentes-automovilisticos/": { bg: "/images/auto-accident-rehabilitation-in-tampa-fl.webp", variant: "light", position: "center right" },
  "/slip-and-fall-injury-treatment/": { bg: "/images/what-happens-when-you-slip-and-fall-on-your-back.webp", variant: "light", position: "center right" },
  "/es/rehabilitacion-de-lesiones-por-resbalones-y-caidas/": { bg: "/images/what-happens-when-you-slip-and-fall-on-your-back.webp", variant: "light", position: "center right" },
  "/chiropractor/": { bg: "/images/what-to-do-after-chiropractic-adjustment.webp", variant: "light", position: "center right" },
  "/es/quiropractico/": { bg: "/images/what-to-do-after-chiropractic-adjustment.webp", variant: "light", position: "center right" },
  "/whiplash-treatment-tampa/": { bg: "/images/how-to-fix-a-pinched-nerve-in-the-neck.webp", variant: "light", position: "center right" },
  "/es/tratamiento-latigazo-cervical-tampa/": { bg: "/images/how-to-fix-a-pinched-nerve-in-the-neck.webp", variant: "light", position: "center right" },
  "/primary-care/": { bg: "/images/comprehensive-primary-care-that-works-with-your-body.webp", variant: "light", position: "center right" },
  "/es/atencion-primaria/": { bg: "/images/comprehensive-primary-care-that-works-with-your-body.webp", variant: "light", position: "center right" },
  "/medical-weight-loss/": { bg: "/images/medical-weight-loss-program.webp", variant: "light", position: "center right" },
  "/es/perdida-de-peso-medica/": { bg: "/images/medical-weight-loss-program.webp", variant: "light", position: "center right" },
  "/massage-therapy/": { bg: "/images/massage-therapy-session.webp", variant: "dark", position: "center center" },
  "/es/terapia-de-masajes/": { bg: "/images/massage-therapy-session.webp", variant: "dark", position: "center center" },
  "/therapeutic-ultrasound-treatment/": { bg: "/images/ultrasound-therapy-on-patient-shoulder.webp", variant: "dark", position: "center bottom" },
  "/es/tratamiento-de-ultrasonido-terapeutico/": { bg: "/images/ultrasound-therapy-on-patient-shoulder.webp", variant: "dark", position: "center bottom" },
  "/therapeutic-exercises/": { bg: "/images/therapist-examining-patient.jpg", variant: "dark", position: "center center" },
  "/es/ejercicios-terapeuticos/": { bg: "/images/therapist-examining-patient.jpg", variant: "dark", position: "center center" },
};
const hero = heroConfig[currentPath];
const physicalRehabPage = pathIs("/physical-rehabilitation/", "/es/fisioterapia/");
const carAccidentRehab = pathIs("/car-accident-rehabilitation/", "/es/rehabilitacion-de-accidentes-automovilisticos/");
const whiplashPage = pathIs("/whiplash-treatment-tampa/", "/es/tratamiento-latigazo-cervical-tampa/");
const slipAndFall = pathIs("/slip-and-fall-injury-treatment/", "/es/rehabilitacion-de-lesiones-por-resbalones-y-caidas/");
const massageTherapy = pathIs("/massage-therapy/", "/es/terapia-de-masajes/");
const ultrasoundTherapy = pathIs("/therapeutic-ultrasound-treatment/", "/es/tratamiento-de-ultrasonido-terapeutico/");
const compactDarkHero = massageTherapy || ultrasoundTherapy;
const leftAlignedDarkHero = massageTherapy;
const therapeuticExercises = pathIs("/therapeutic-exercises/", "/es/ejercicios-terapeuticos/");
const chiropractorPage = pathIs("/chiropractor/", "/es/quiropractico/");
const primaryCarePage = pathIs("/primary-care/", "/es/atencion-primaria/");
const medicalWeightLossPage = pathIs("/medical-weight-loss/", "/es/perdida-de-peso-medica/");
const aboutPage = pathIs("/about-us/", "/es/acerca-de-nosotros/");
const heroStyle = hero
  ? hero.variant === "dark"
    ? `background-image: linear-gradient(rgba(0,0,0,0.68), rgba(0,0,0,0.68)), url('${hero.bg}'); background-size: cover; background-position: ${hero.position || "center"};`
    : `background-image: linear-gradient(90deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.94) 44%, rgba(255,255,255,0.76) 70%, rgba(255,255,255,0.92) 100%), url('${hero.bg}'); background-size: cover; background-position: ${hero.position || "center right"};`
  : undefined;

// Hero region = everything before the first body heading OR band (a CTA band can lead the body).
const bodyStartsWithH1 = pathIs("/therapeutic-ultrasound-treatment/", "/es/tratamiento-de-ultrasonido-terapeutico/", "/massage-therapy/", "/es/terapia-de-masajes/", "/therapeutic-exercises/", "/es/ejercicios-terapeuticos/");
const firstSplit = blocks.findIndex((b) => b.t === "h2" || b.t === "band" || (bodyStartsWithH1 && b.t === "h1"));
const heroRegion = firstSplit === -1 ? blocks : blocks.slice(0, firstSplit);
const heroImg = heroRegion.find((b) => b.t === "img");
const heroBadges = heroRegion.find((b) => b.t === "badges");
const heroCta = heroRegion.find((b) => b.t === "cta");
const heroH1 = heroRegion.find((b) => b.t === "h1");
const heroH3s = heroRegion.filter((b) => b.t === "h3");
const heroH4s = heroRegion.filter((b) => b.t === "h4");
const heroParas = heroRegion.filter((b) => b.t === "p");
const modernLightHero = hero?.variant === "light" && !physicalRehabPage;
const modernHeroTitle = modernLightHero ? heroParas[0] : undefined;
const darkParagraphTitle = hero?.variant === "dark" && !heroH1 ? heroParas[0] : undefined;
const darkParagraphOnlyHero = !!darkParagraphTitle && heroParas.length === 1 && !heroBadges && !heroCta && heroH3s.length === 0 && heroH4s.length === 0;
const heroTitleText = modernHeroTitle?.html || heroH1?.text || darkParagraphTitle?.html || "";
const heroImgIndex = heroImg ? heroRegion.indexOf(heroImg) : heroRegion.length;
const displayHeroParas = modernLightHero
  ? heroParas.filter((p) => p !== modernHeroTitle && heroRegion.indexOf(p) < heroImgIndex)
  : heroParas.filter((p) => p !== darkParagraphTitle);
let bodyBlocks = firstSplit === -1 ? [] : blocks.slice(firstSplit);
if (modernLightHero && heroH1) {
  const introIndex = heroRegion.indexOf(heroH1);
  const introTail = heroRegion.slice(introIndex).map((b) => b === heroH1 ? { ...b, t: "h2" } : b);
  const introBlocks = heroImg ? [introTail[0], heroImg, ...introTail.slice(1)] : introTail;
  bodyBlocks = [...introBlocks, ...bodyBlocks];
}
if (physicalRehabPage && heroImg && bodyBlocks.length > 0) {
  bodyBlocks = [bodyBlocks[0], heroImg, ...bodyBlocks.slice(1)];
}

interface Section { kind: "h1" | "h2" | "band"; heading: string; band?: Block; blocks: Block[]; }
const sections: Section[] = [];
for (const b of bodyBlocks) {
  if (b.t === "h1" && bodyStartsWithH1) sections.push({ kind: "h1", heading: b.text || "", blocks: [] });
  else if (b.t === "h2") sections.push({ kind: "h2", heading: b.text || "", blocks: [] });
  else if (b.t === "band") sections.push({ kind: "band", heading: "", band: b, blocks: [] });
  else if (sections.length) sections[sections.length - 1].blocks.push(b);
}
if (carAccidentRehab) {
  const expectSection = sections.find((sec) => headingIs(sec.heading, ["What to Expect During Rehabilitation", "Qué esperar durante la rehabilitación"]));
  const startSection = sections.find((sec) => headingIs(sec.heading, ["How to Get Started After a Car Accident", "Cómo comenzar después de un accidente de auto"]));
  const movedImages = expectSection?.blocks.filter((b) => b.t === "img") ?? [];
  if (expectSection && startSection && movedImages.length > 0) {
    expectSection.blocks = expectSection.blocks.filter((b) => b.t !== "img");
    startSection.blocks = [...movedImages, ...startSection.blocks];
  }
}
if (slipAndFall) {
  const integratedSection = sections.find((sec) => headingIs(sec.heading, ["Integrated Wellness Services", "Servicios de bienestar integrados"]));
  const whyIntegratedSection = sections.find((sec) => headingIs(sec.heading, ["Why Integrated Care Matters", "Por qué es importante la atención integrada"]));
  const carServiceIdx = integratedSection?.blocks.findIndex((b) => b.t === "h3" && headingIs(b.text || "", ["Car Accident Rehabilitation", "Rehabilitación de Accidentes de Auto", "Rehabilitación de accidentes automovilísticos"])) ?? -1;
  if (integratedSection && whyIntegratedSection && carServiceIdx >= 0) {
    const moved = integratedSection.blocks.slice(carServiceIdx, carServiceIdx + 2);
    integratedSection.blocks.splice(carServiceIdx, 2);
    whyIntegratedSection.blocks = [...moved, ...whyIntegratedSection.blocks];
  }
}
if (ultrasoundTherapy) {
  const headacheSection = sections.find((sec) => headingIs(sec.heading, ["The Use of therapeutic Ultrasound in the Treatment of Chronic Headaches and Migraines", "El uso de la terapia de ultrasonido en el tratamiento de dolores de cabeza crónicos y migrañas"]));
  const celluliteSection = sections.find((sec) => headingIs(sec.heading, ["The Use of therapeutic Ultrasound in the Treatment of Cellulite and Skin Tightening", "El uso de la terapia de ultrasonido en el tratamiento de la celulitis y el estiramiento de la piel"]));
  const gynecologySection = sections.find((sec) => headingIs(sec.heading, ["The Use of therapeutic Ultrasound in the Treatment of Gynecological Conditions", "El uso de la terapia de ultrasonido en el tratamiento de afecciones ginecológicas"]));
  const celluliteImage = headacheSection?.blocks.find((b) => b.t === "img" && (b.src || "").includes("cellulite"));
  if (headacheSection && celluliteImage) {
    headacheSection.blocks = headacheSection.blocks.filter((b) => b !== celluliteImage);
  }
  if (celluliteSection && celluliteImage) {
    celluliteSection.blocks = [celluliteImage, ...celluliteSection.blocks];
  }
  if (celluliteSection && gynecologySection) {
    celluliteSection.blocks = [...celluliteSection.blocks, { t: "h2", text: gynecologySection.heading }, ...gynecologySection.blocks];
    const idx = sections.indexOf(gynecologySection);
    if (idx >= 0) sections.splice(idx, 1);
  }
}
if (therapeuticExercises) {
  const whatSection = sections.find((sec) => headingIs(sec.heading, ["What are therapeutic exercises?", "¿QUÉ SON LOS EJERCICIOS TERAPÉUTICOS?"]));
  const childHeadings = ["movement basics.", "core of rehabilitation.", "simple & effective.", "FUNDAMENTOS DEL MOVIMIENTO.", "NÚCLEO DE LA REHABILITACIÓN.", "SIMPLE Y EFICAZ."];
  if (whatSection) {
    const nextSections = sections.filter((sec) => childHeadings.includes(sec.heading));
    for (const child of nextSections) {
      whatSection.blocks = [...whatSection.blocks, { t: "h2", text: child.heading }, ...child.blocks];
      const idx = sections.indexOf(child);
      if (idx >= 0) sections.splice(idx, 1);
    }
  }
  const benefitsSection = sections.find((sec) => headingIs(sec.heading, ["Benefits of therapeutic exercises", "BENEFICIOS DE LOS EJERCICIOS TERAPÉUTICOS"]));
  const shoulderSection = sections.find((sec) => headingIs(sec.heading, ["Shoulder Exercises After Fracture", "Ejercicios de hombro después de una fractura"]));
  const neckSection = sections.find((sec) => headingIs(sec.heading, ["Chronic Neck Pain Treatment in Tampa", "Tratamiento del dolor de cuello crónico en Tampa"]));
  if (benefitsSection) {
    if (shoulderSection) {
      benefitsSection.blocks = [...benefitsSection.blocks, { t: "h2", text: shoulderSection.heading }, ...shoulderSection.blocks];
      const idx = sections.indexOf(shoulderSection);
      if (idx >= 0) sections.splice(idx, 1);
    }
    if (neckSection) {
      benefitsSection.blocks = [...benefitsSection.blocks, { t: "h2", text: neckSection.heading }, ...neckSection.blocks];
      const idx = sections.indexOf(neckSection);
      if (idx >= 0) sections.splice(idx, 1);
    }
  }
}
if (primaryCarePage) {
  const readySection = sections.find((sec) => headingIs(sec.heading, ["Ready to Experience Integrated Primary Care?", "¿Listo para Experimentar la Atención Primaria Integrada?"]));
  const relatedSection = sections.find((sec) => headingIs(sec.heading, ["Related Services", "Servicios Relacionados"]));
  if (readySection && relatedSection) {
    readySection.blocks = [...readySection.blocks, { t: "h2", text: relatedSection.heading }, ...relatedSection.blocks];
    const idx = sections.indexOf(relatedSection);
    if (idx >= 0) sections.splice(idx, 1);
  }
}
if (medicalWeightLossPage) {
  const servicesSection = sections.find((sec) => headingIs(sec.heading, ["Our Weight Loss Services", "Nuestros Servicios de Pérdida de Peso"]));
  const programSection = sections.find((sec) => headingIs(sec.heading, ["Medical Weight Loss Program", "Programa de Pérdida de Peso Médica"]));
  const labIdx = servicesSection?.blocks.findIndex((b) => b.t === "h3" && headingIs(b.text || "", ["Lab Testing & Health Monitoring", "Pruebas de Laboratorio y Monitoreo de Salud"])) ?? -1;
  if (servicesSection && programSection && labIdx >= 0) {
    const moved = servicesSection.blocks.splice(labIdx);
    programSection.blocks = [...moved, ...programSection.blocks];
  }
  const readySection = sections.find((sec) => headingIs(sec.heading, ["Ready for the Next Step in Your Weight Loss Plan?", "¿Listo para el Siguiente Paso en Tu Plan de Pérdida de Peso?"]));
  const relatedSection = sections.find((sec) => headingIs(sec.heading, ["Related Services", "Servicios Relacionados"]));
  if (readySection && relatedSection) {
    readySection.blocks = [...readySection.blocks, { t: "h2", text: relatedSection.heading }, ...relatedSection.blocks];
    const idx = sections.indexOf(relatedSection);
    if (idx >= 0) sections.splice(idx, 1);
  }
}
if (aboutPage) {
  const leadershipSection = sections.find((sec) => headingIs(sec.heading, ["Our Leadership Team", "Nuestro Equipo de Liderazgo"]));
  const licensesSection = sections.find((sec) => headingIs(sec.heading, ["Our Licenses & Credentials", "Nuestras Licencias y Credenciales"]));
  const physicianIdx = leadershipSection?.blocks.findIndex((b) => b.t === "h3" && (b.text || "").startsWith("Dr. Arnaldo")) ?? -1;
  if (leadershipSection && licensesSection && physicianIdx >= 0) {
    const physicianBlocks = leadershipSection.blocks.splice(physicianIdx, 2);
    licensesSection.blocks = [...physicianBlocks, ...licensesSection.blocks];
  }
}

function btnClass(kind: string) {
  if (kind === "phone") return "inline-flex items-center gap-2 rounded border-2 border-blue px-5 py-2.5 text-[14px] font-bold text-blue transition-colors hover:bg-blue hover:text-white";
  return "inline-flex items-center gap-2 rounded bg-green px-5 py-3 text-[14px] font-bold text-white transition-colors hover:bg-green-dark";
}
function heroBtnClass(kind: string) {
  if (hero?.variant === "dark" && kind === "phone") return "inline-flex items-center gap-2 rounded border-2 border-white/80 px-5 py-2.5 text-[14px] font-bold text-white transition-colors hover:bg-white hover:text-blue";
  return btnClass(kind);
}

const plans = sections.map((sec) => {
  if (sec.kind === "band") return { isBand: true as const, band: sec.band! };
  const inner = sec.blocks;
  const physicalRehab = physicalRehabPage;
  const carWhy = carAccidentRehab && headingIs(sec.heading, ["Why Patients Choose Palm Wellness Center for Rehabilitation", "Por qué los pacientes eligen Palm Wellness Center para su rehabilitación"]);
  const carSymptoms = carAccidentRehab && headingIs(sec.heading, ["When Symptoms Don’t Fully Improve After an Accident", "Cuando los síntomas no mejoran completamente después de un accidente"]);
  const carInjuries = carAccidentRehab && headingIs(sec.heading, ["Common Auto Accident Injuries We Help Rehabilitate", "Lesiones comunes por accidentes de auto que ayudamos a rehabilitar"]);
  const carStart = carAccidentRehab && headingIs(sec.heading, ["How to Get Started After a Car Accident", "Cómo comenzar después de un accidente de auto"]);
  const slipTreatmentServices = slipAndFall && headingIs(sec.heading, ["Our Slip and Fall Treatment Services", "Nuestros servicios de tratamiento de resbalones y caídas"]);
  const slipIntegratedServices = slipAndFall && headingIs(sec.heading, ["Integrated Wellness Services", "Servicios de bienestar integrados"]);
  const slipIntegratedWhy = slipAndFall && headingIs(sec.heading, ["Why Integrated Care Matters", "Por qué es importante la atención integrada"]);
  const massageWhat = massageTherapy && headingIs(sec.heading, ["What is massage therapy?", "¿QUÉ ES LA TERAPIA DE MASAJE?"]);
  const massageTechniques = massageTherapy && headingIs(sec.heading, ["Different massage therapy techniques", "DIFERENTES TÉCNICAS DE TERAPIA DE MASAJE"]);
  const massageBenefits = massageTherapy && headingIs(sec.heading, ["Benefits from massage therapy tampa fl", "BENEFICIOS DE LA TERAPIA DE MASAJE"]);
  const massageRisks = massageTherapy && headingIs(sec.heading, ["ARE THERE SIDE EFFECTS AND RISKS associated with MASSAGE THERAPY?", "¿EXISTEN EFECTOS SECUNDARIOS Y RIESGOS EN LA TERAPIA DE MASAJE?"]);
  const massageFaq = massageTherapy && headingIs(sec.heading, ["Massage therapy tampa fl frequently asked questions", "PREGUNTAS FRECUENTES SOBRE TERAPIA DE MASAJES"]);
  const massageServices = massageTherapy && headingIs(sec.heading, ["Physical Rehabilitation Treatments and Techniques We Offer", "Tratamientos y Técnicas de Rehabilitación Física que Ofrecemos"]);
  const ultrasoundWhat = ultrasoundTherapy && headingIs(sec.heading, ["What is therapeutic ultrasound treatment?", "¿QUÉ ES EL TRATAMIENTO TERAPÉUTICO POR ULTRASONIDO?"]);
  const ultrasoundImprove = ultrasoundTherapy && headingIs(sec.heading, ["How therapeutic Ultrasound Works to Improve Healing and Recovery", "Cómo funciona la terapia de ultrasonido para mejorar la curación y la recuperación"]);
  const ultrasoundWound = ultrasoundTherapy && headingIs(sec.heading, ["The Use of therapeutic Ultrasound for Wound Healing and Tissue Repair", "El uso de la terapia de ultrasonido para la cicatrización de heridas y la reparación de tejidos"]);
  const ultrasoundSports = ultrasoundTherapy && headingIs(sec.heading, ["The Use of therapeutic Ultrasound in the Management of Sports Injuries and Sore Muscles", "El Uso de la Terapia de Ultrasonido en el Manejo de Lesiones Deportivas y Dolores Musculares"]);
  const ultrasoundHeadache = ultrasoundTherapy && headingIs(sec.heading, ["The Use of therapeutic Ultrasound in the Treatment of Chronic Headaches and Migraines", "El uso de la terapia de ultrasonido en el tratamiento de dolores de cabeza crónicos y migrañas"]);
  const ultrasoundCellulite = ultrasoundTherapy && headingIs(sec.heading, ["The Use of therapeutic Ultrasound in the Treatment of Cellulite and Skin Tightening", "El uso de la terapia de ultrasonido en el tratamiento de la celulitis y el estiramiento de la piel"]);
  const ultrasoundConditions = ultrasoundTherapy && headingIs(sec.heading, ["Conditions that benefit from therapeutic ultrasound", "CONDICIONES QUE SE BENEFICIAN DEL TRATAMIENTO TERAPÉUTICO POR ULTRASONIDO"]);
  const ultrasoundTendonitis = ultrasoundTherapy && headingIs(sec.heading, ["Therapeutic Ultrasound for Tendonitis", "Terapia de Ultrasonido para la Tendinitis"]);
  const ultrasoundTypes = ultrasoundTherapy && headingIs(sec.heading, ["Types of Therapeutic ultrasound", "TIPOS DE TERAPIA DE ULTRASONIDO"]);
  const ultrasoundBenefits = ultrasoundTherapy && headingIs(sec.heading, ["Benefits of therapeutic ultrasound treatment", "BENEFICIOS DEL TRATAMIENTO CON ULTRASONIDO TERAPÉUTICO"]);
  const ultrasoundRisks = ultrasoundTherapy && headingIs(sec.heading, ["The potential risks and side effects of ultrasound therapy", "Riesgos y efectos secundarios de la terapia de ultrasonido"]);
  const ultrasoundPerformed = ultrasoundTherapy && headingIs(sec.heading, ["How is therapeutic ultrasound treatment performed?", "¿CÓMO SE REALIZA EL TRATAMIENTO con ULTRASONIDO TERAPÉUTICO?"]);
  const ultrasoundFaq = ultrasoundTherapy && headingIs(sec.heading, ["Frequently Asked Questions About Ultrasound Therapy", "Preguntas frecuentes sobre la terapia de ultrasonido"]);
  const ultrasoundSafe = ultrasoundTherapy && headingIs(sec.heading, ["Is therapeutic ultrasound treatment safe?", "¿ES SEGURO EL TRATAMIENTO DE ULTRASONIDO?"]);
  const customUltrasound = ultrasoundWhat || ultrasoundImprove || ultrasoundWound || ultrasoundSports || ultrasoundHeadache || ultrasoundCellulite || ultrasoundConditions || ultrasoundTypes || ultrasoundBenefits || ultrasoundRisks || ultrasoundPerformed || ultrasoundFaq || ultrasoundSafe;
  const exercisesWhat = therapeuticExercises && headingIs(sec.heading, ["What are therapeutic exercises?", "¿QUÉ SON LOS EJERCICIOS TERAPÉUTICOS?"]);
  const exercisesBenefits = therapeuticExercises && headingIs(sec.heading, ["Benefits of therapeutic exercises", "BENEFICIOS DE LOS EJERCICIOS TERAPÉUTICOS"]);
  const exercisesStages = therapeuticExercises && headingIs(sec.heading, ["stages of therapeutic exercises", "CLASIFICACIÓN DE LOS EJERCICIOS TERAPÉUTICOS SEGÚN LA AYUDA requerida"]);
  const exercisesTypes = therapeuticExercises && headingIs(sec.heading, ["Types of therapeutic exercises", "TIPOS DE EJERCICIOS TERAPÉUTICOS"]);
  const exercisesFactors = therapeuticExercises && headingIs(sec.heading, ["Factors that affect the effectiveness of therapeutic exercises", "FACTORES QUE CONTRIBUYEN A LA SEGURIDAD DE LOS EJERCICIOS TERAPÉUTICOS"]);
  const exercisesIntro = therapeuticExercises && headingIs(sec.heading, ["Therapeutic Exercises in Tampa for Strength, Balance, and Mobility", "Ejercicios terapéuticos en Tampa para fuerza, equilibrio y movilidad"]);
  const exercisesWhy = therapeuticExercises && headingIs(sec.heading, ["Why Patients Choose Palm Wellness Center for Therapeutic Exercises", "Por qué los pacientes eligen Palm Wellness Center para ejercicios terapéuticos"]);
  const exercisesDefinition = therapeuticExercises && headingIs(sec.heading, ["What Are Therapeutic Exercises?", "¿Qué son los ejercicios terapéuticos?"]);
  const exercisesHelp = therapeuticExercises && headingIs(sec.heading, ["When Therapeutic Exercises May Help", "Cuándo pueden ayudar los ejercicios terapéuticos"]);
  const exercisesMovement = therapeuticExercises && headingIs(sec.heading, ["What You Feel vs. What May Be Affecting Movement", "Lo que siente vs. lo que puede estar afectando el movimiento"]);
  const exercisesSupport = therapeuticExercises && headingIs(sec.heading, ["How Therapeutic Exercises Support Rehabilitation", "Cómo los ejercicios terapéuticos apoyan la rehabilitación"]);
  const exercisesAccidents = therapeuticExercises && headingIs(sec.heading, ["Therapeutic Exercises After Accidents and Falls", "Ejercicios terapéuticos después de accidentes y caídas"]);
  const exercisesExpect = therapeuticExercises && headingIs(sec.heading, ["What to Expect During Therapeutic Exercise Care", "Qué esperar durante la atención con ejercicios terapéuticos"]);
  const exercisesCombined = therapeuticExercises && headingIs(sec.heading, ["Therapeutic Exercises Combined With Other Treatments", "Ejercicios terapéuticos combinados con otros tratamientos"]);
  const exercisesRecovery = therapeuticExercises && headingIs(sec.heading, ["When Recovery Takes Longer Than Expected", "Cuando la recuperación tarda más de lo esperado"]);
  const exercisesTransport = therapeuticExercises && headingIs(sec.heading, ["Transportation Assistance", "Asistencia de transporte"]);
  const exercisesFinal = therapeuticExercises && headingIs(sec.heading, ["Start Therapeutic Exercises in Tampa", "Comience ejercicios terapéuticos en Tampa"]);
  const exercisesTeam = therapeuticExercises && headingIs(sec.heading, ["Experienced Medical and Rehabilitation Team", "Equipo médico y de rehabilitación con experiencia"]);
  const customExercises = exercisesWhat || exercisesBenefits || exercisesStages || exercisesTypes || exercisesFactors || exercisesIntro || exercisesWhy || exercisesDefinition || exercisesHelp || exercisesMovement || exercisesSupport || exercisesAccidents || exercisesExpect || exercisesCombined || exercisesRecovery || exercisesTransport || exercisesTeam;
  const chiroServices = chiropractorPage && headingIs(sec.heading, ["Chiropractic Care Services", "Servicios de atención quiropráctica"]);
