    </div>
  </section>
) : p.isBand ? (
  <section class:list={[p.band.color === "green" ? "bg-green text-white" : "bg-blue-deep text-white"]}>
    {therapeuticExercises && p.band.color === "blue" ? (
      <div class="container py-9 lg:py-10" data-aos="fade-up">
        <div class="grid items-center gap-7 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
          <h2 class="max-w-md text-3xl leading-tight text-white sm:text-[2.1rem]" set:html={p.band.lines?.[0] || ""} />
          <div class="max-w-2xl">
            {(p.band.lines ?? []).slice(1).map((line: string) => <p class="leading-relaxed text-white/90" set:html={line} />)}
            {p.band.buttons && p.band.buttons.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-3">
                {p.band.buttons.map((b: any) => (
                  <a href={b.href} target={b.href.startsWith("http") ? "_blank" : undefined} rel={b.href.startsWith("http") ? "noopener" : undefined}
                     class:list={["inline-flex items-center gap-2 rounded-full px-6 py-2.5 font-bold transition-colors", b.kind === "phone" ? "border-2 border-white text-white hover:bg-white/10" : "bg-white text-blue hover:bg-white/90"]}>
                    {b.kind === "phone" && <Icon name="phone" class="h-4 w-4" />}{b.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    ) : (
      <div class="container py-10">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between" data-aos="fade-up">
          <div class="max-w-2xl">
            {aboutPage && p.band.color === "green" ? (
              <>
                <h2 class="text-2xl text-white sm:text-[1.7rem]">{aboutBandTitle}</h2>
                <p class="mt-2 leading-relaxed text-white/90" set:html={(p.band.lines ?? []).length > 1 ? p.band.lines![1] : p.band.lines?.[0] || ""} />
              </>
            ) : carAccidentRehab && (p.band.lines?.[0] || "").startsWith("Even if you feel fine") ? (
              <>
                <h2 class="text-2xl text-white sm:text-[1.65rem]">Why Waiting Can Make Injuries Worse</h2>
                <p class="mt-2 text-[15px] font-bold leading-relaxed text-white" set:html={p.band.lines![0]} />
              </>
            ) : carAccidentRehab && (p.band.lines?.[0] || "").startsWith("Palm Wellness Center provides") ? (
              <>
                <h2 class="text-2xl text-white sm:text-[1.65rem]">Patient-Focused Care You Can Trust</h2>
                <p class="mt-2 text-[15px] font-bold leading-relaxed text-white" set:html={p.band.lines![0]} />
              </>
            ) : (
              (p.band.lines ?? []).map((line: string, i: number) => i === 0
                ? <h2 class="text-2xl text-white sm:text-[1.7rem]" set:html={line} />
                : <p class="mt-2 leading-relaxed text-white/90" set:html={line} />)
            )}
          </div>
          {p.band.buttons && p.band.buttons.length > 0 && (
            <div class="flex flex-wrap gap-3 lg:shrink-0">
              {p.band.buttons.map((b: any) => (
                <a href={b.href} target={b.href.startsWith("http") ? "_blank" : undefined} rel={b.href.startsWith("http") ? "noopener" : undefined}
                   class:list={["inline-flex items-center gap-2 rounded-full px-6 py-2.5 font-bold transition-colors",
                     b.kind === "phone" ? "border-2 border-white text-white hover:bg-white/10"
                     : (p.band.color === "green" ? "bg-white text-green-dark hover:bg-white/90" : "bg-white text-blue hover:bg-white/90")]}>
                  {b.kind === "phone" && <Icon name="phone" class="h-4 w-4" />}{b.label}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    )}
  </section>
) : (
  <section class:list={[p.photo ? (p.lightPhoto ? "bg-white bg-cover bg-center" : "bg-blue-deep bg-cover bg-center text-white") : p.band ? (p.bg === "band-green" ? "bg-green text-white" : "bg-blue-deep text-white") : p.bg === "exercise-blue" ? "bg-[#afcbff]" : p.bg === "exercise-blush" ? "bg-[#fceeee]" : p.bg === "ultrasound-gradient" ? "bg-gradient-to-r from-[#78a74b] to-[#1f63ad] text-white" : p.bg === "ultrasound-deep" ? "bg-[#2d6fb5] text-white" : p.bg === "ultrasound-light" ? "bg-[#afcbff]" : p.bg === "ultrasound-gray" ? "bg-[#e6e6e6]" : p.bg === "massage-deep" ? "bg-[#1f5b9e] text-white" : p.bg === "massage-gray" ? "bg-[#dfe3e8]" : p.bg === "massage-blue" ? "bg-[#b8d2fb]" : p.bg === "tint" ? "bg-blue-tint" : p.bg === "blush" ? "bg-pink-pale" : p.bg === "alt" ? "bg-bg-alt" : "bg-white", (p.massageTherapy && ["massage-blue", "massage-gray", "massage-deep"].includes(p.bg)) || (p.ultrasoundTherapy && ["ultrasound-gradient", "ultrasound-deep", "ultrasound-light"].includes(p.bg)) || (p.therapeuticExercises && ["exercise-blush", "exercise-blue"].includes(p.bg)) ? "relative overflow-hidden" : ""]} style={p.photo ? (p.lightPhoto ? `background-image: linear-gradient(rgba(255,255,255,0.88),rgba(255,255,255,0.88)), url('${p.bgImg}');` : p.medicalWhy ? `background-image: linear-gradient(90deg,rgba(18,82,150,0.93),rgba(18,82,150,0.84)), url('${p.bgImg}');` : `background-image: linear-gradient(90deg,rgba(0,0,0,0.3),rgba(22,78,147,0.3)), linear-gradient(rgba(0,0,0,0.82),rgba(0,0,0,0.82)), url('${p.bgImg}');`) : undefined}>
    {((p.massageTherapy && ["massage-blue", "massage-gray", "massage-deep"].includes(p.bg)) || (p.ultrasoundTherapy && ["ultrasound-gradient", "ultrasound-deep", "ultrasound-light"].includes(p.bg)) || (p.therapeuticExercises && ["exercise-blush", "exercise-blue"].includes(p.bg))) && (
      <div class="pointer-events-none absolute inset-x-0 top-0 h-9 bg-white" style="clip-path: polygon(0 0,100% 0,100% 58%,76% 44%,50% 64%,25% 48%,0 60%);"></div>
    )}
    {((p.massageTherapy && ["massage-blue", "massage-gray"].includes(p.bg)) || (p.ultrasoundTherapy && ["ultrasound-deep", "ultrasound-light"].includes(p.bg)) || (p.therapeuticExercises && ["exercise-blush", "exercise-blue"].includes(p.bg))) && (
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-9 bg-white" style="clip-path: polygon(0 42%,25% 58%,50% 38%,76% 55%,100% 42%,100% 100%,0 100%);"></div>
    )}
    <div class:list={["container", p.whiplashPage && p.introWithImage ? "source-wide pt-0 pb-0" : p.massageTherapy || p.ultrasoundTherapy || p.therapeuticExercises || p.chiropractorPage || p.primaryCarePage || p.medicalWeightLossPage || p.aboutPage ? "source-wide py-16" : p.slipIntroProvider ? "pt-14 pb-0" : p.rehabVisitSection ? "source-wide py-20" : p.rehabServicesGrid ? "source-wide py-16" : "py-14", p.physicalRehab ? "[&_p]:text-[16px] [&_p_a]:underline [&_p_a]:decoration-1 [&_p_a]:underline-offset-2" : ""]}>
      <RichSection p={p} />
    </div>
  </section>
))}
