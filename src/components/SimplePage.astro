---
import Layout from "../layouts/Layout.astro";
import TopBar from "./TopBar.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";
import { newPages } from "../data/newPages";
import { APPOINTMENT_URL, PHONE_TEL } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props { lang: Lang; path: string; }
const { lang, path } = Astro.props;
const page = newPages[path];
const bookLabel = lang === "es" ? "Reservar cita" : "Book Appointment";
const bookAttrs = { target: "_blank", rel: "noopener" } as const;
---

<Layout lang={lang} path={path} title={page.title} description={page.desc}>
  <TopBar lang={lang} />
  <Header lang={lang} path={path} />
  <main id="main">
    <!-- Hero -->
    <section class="bg-bg-alt">
      <div class="container flex flex-col items-start gap-4 py-14 lg:py-16">
        <span class="rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-wide text-blue-deep">{page.eyebrow}</span>
        <h1 class="max-w-3xl text-4xl leading-[1.12] text-ink sm:text-5xl">{page.h1}</h1>
        <p class="max-w-2xl text-[18px] leading-relaxed text-body">{page.lead}</p>
        <div class="mt-2 flex flex-wrap gap-3">
          <a href={APPOINTMENT_URL} {...bookAttrs} class="inline-flex items-center gap-2 rounded-md bg-blue px-6 py-3.5 font-bold text-white transition-colors hover:bg-blue-deep">
            <Icon name="calendar-check" class="h-[18px] w-[18px]" />{bookLabel}
          </a>
          <a href={PHONE_TEL} class="inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue bg-white px-6 py-3.5 font-bold text-blue transition-colors hover:bg-blue-pale">
            <Icon name="phone" class="h-[18px] w-[18px]" />(813) 443-5370
          </a>
        </div>
      </div>
    </section>

    <!-- Body + benefits -->
    <section class="bg-white">
      <div class="container grid gap-12 py-16 lg:grid-cols-2">
        <div class="prose max-w-none">
          <p class="text-[17px] leading-relaxed text-body">{page.body}</p>
        </div>
        <ul class="flex flex-col gap-6">
          {page.benefits.map((b) => (
            <li class="flex items-start gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blue-pale text-blue-deep"><Icon name={b.icon} class="h-6 w-6" /></span>
              <span>
                <strong class="block text-[18px] text-ink">{b.title}</strong>
                <span class="block text-[15px] text-body">{b.body}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-bg-alt">
      <div class="container flex flex-col items-center gap-10 py-16">
        <h2 class="text-3xl text-ink sm:text-[2.1rem]">{lang === "es" ? "Preguntas frecuentes" : "Frequently asked questions"}</h2>
        <div class="flex w-full max-w-[900px] flex-col gap-3">
          {page.faq.map((item) => (
            <details class="group rounded-md bg-white">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-[17px] font-semibold text-ink">
                <span>{item.q}</span>
                <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-blue transition-transform group-open:rotate-180" />
              </summary>
              <p class="px-6 pb-5 text-body">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-blue-deep">
      <div class="container flex flex-col items-center gap-4 py-14 text-center">
        <h2 class="max-w-[760px] text-3xl text-white sm:text-[2rem]">{lang === "es" ? "Da el primer paso para sentirte mejor." : "Take the first step toward feeling better."}</h2>
        <div class="mt-2 flex flex-wrap justify-center gap-3">
          <a href={APPOINTMENT_URL} {...bookAttrs} class="inline-flex items-center gap-2 rounded-md bg-white px-7 py-3.5 font-bold text-blue-deep transition-colors hover:bg-blue-pale">
            <Icon name="calendar-check" class="h-[18px] w-[18px]" />{bookLabel}
          </a>
          <a href={PHONE_TEL} class="inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue-tint px-6 py-3.5 font-bold text-white transition-colors hover:bg-white/10">
            <Icon name="phone" class="h-[18px] w-[18px]" />(813) 443-5370
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
