---
import type { Lang } from "../i18n/ui";
import { useTranslations, route, PHONE_TEL, FAX_DISPLAY, SOCIAL } from "../i18n/utils";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const tagline =
  lang === "es"
    ? "Atención primaria integrada, pérdida de peso médica y rehabilitación: todo bajo un mismo techo en Tampa, Florida."
    : "Integrated primary care, medical weight loss, and rehabilitation - all under one roof in Tampa, Florida.";

const services = lang === "es"
  ? [
      { label: "Atención Primaria", href: "/es/atencion-primaria/" },
      { label: "Pérdida de Peso Médica", href: "/es/perdida-de-peso-medica/" },
      { label: "Terapia IV", href: "/es/terapia-iv/" },
      { label: "Rehabilitación", href: "/es/fisioterapia/" },
      { label: "Telemedicina", href: "/es/atencion-primaria/telemedicina/" },
    ]
  : [
      { label: "Primary Care", href: "/primary-care/" },
      { label: "Medical Weight Loss", href: "/medical-weight-loss/" },
      { label: "IV Therapy", href: "/iv-therapy/" },
      { label: "Rehabilitation", href: "/physical-rehabilitation/" },
      { label: "Telemedicine", href: "/primary-care/telemedicine/" },
    ];

const company = lang === "es"
  ? [
      { label: "Acerca de Nosotros", href: "/es/acerca-de-nosotros/" },
      { label: "Blog", href: "/es/blog-de-noticias/" },
      { label: "Contacto", href: "/es/contacto/" },
    ]
  : [
      { label: "About Us", href: "/about-us/" },
      { label: "Blog", href: "/news-blog/" },
      { label: "Contact", href: "/contact/" },
    ];

const legal = [
  { label: t("footer.hipaa"), href: route(lang, "hipaa") },
  { label: t("footer.privacy"), href: route(lang, "privacy") },
];
const year = 2026;
const hoursLines = t("footer.hours").split("\n");
const companyTitle = lang === "es" ? "Empresa" : "Company";
const phoneLabel = lang === "es" ? "Teléfono:" : "Phone:";
const linkCls = "text-[14px] text-footer-text transition-colors hover:text-white";
---

<footer class="bg-footer-bg text-footer-text">
  <div class="shell grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.25fr_1fr_0.8fr_1.45fr]">
    <div>
      <p class="font-titles text-[23px] leading-tight text-white">Palm Wellness Center</p>
      <p class="mt-5 max-w-[34ch] text-[14px] leading-relaxed">{tagline}</p>
      <div class="mt-5 flex flex-col items-start gap-3">
        <div class="flex flex-wrap gap-3">
          <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" class="inline-flex h-10 items-center rounded-full bg-blue-pale px-3.5 text-[13px] font-bold text-blue-deep transition-colors hover:bg-white">Facebook</a>
          <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex h-10 items-center rounded-full bg-blue-pale px-3.5 text-[13px] font-bold text-blue-deep transition-colors hover:bg-white">Instagram</a>
        </div>
        <a href="https://palmwellnesscenter.blob.core.windows.net/brand/palm-wellness-center-brand-hub.html" target="_blank" rel="noopener noreferrer" class="inline-flex h-10 items-center rounded-full bg-blue-pale px-3.5 text-[13px] font-bold text-blue-deep transition-colors hover:bg-white">Brand Hub</a>
      </div>
    </div>

    <div>
      <h3 class="mb-5 text-[16px] text-white">{t("footer.services")}</h3>
      <ul class="flex flex-col gap-3">
        {services.map((s) => (
          <li><a href={s.href} class={linkCls}>{s.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mb-5 text-[16px] text-white">{companyTitle}</h3>
      <ul class="flex flex-col gap-3">
        {company.map((c) => (
          <li><a href={c.href} class={linkCls}>{c.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mb-5 text-[16px] text-white">{t("footer.contact")}</h3>
      <ul class="flex flex-col gap-3 text-[14px]">
        <li>1004 W Linebaugh Ave Ste A,<br />Tampa, FL 33612</li>
        <li><span class="font-semibold text-white">{phoneLabel} </span><a href={PHONE_TEL} class={linkCls}>{t("cta.phone")}</a></li>
        <li><span class="font-semibold text-white">Fax: </span>{FAX_DISPLAY}</li>
        <li>{hoursLines.map((l, i) => (<>{i > 0 && <br />}{l}</>))}</li>
        <li>{t("footer.licensesLabel")}<br />{t("footer.licenses")}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="shell flex flex-col items-center gap-3 py-4 text-center text-[13px] text-footer-muted lg:grid lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] lg:items-center lg:gap-4">
      <span class="lg:text-left">© {year} {t("footer.copyright")}</span>
      <span class="flex items-center justify-center gap-4">
        {legal.map((item) => <a href={item.href} class="font-semibold text-blue-tint transition-colors hover:text-white">{item.label}</a>)}
      </span>
      <span class="lg:justify-self-end lg:text-right">Website Design By: <a href="https://www.truewebmaster.com/" target="_blank" rel="noopener noreferrer" class="font-semibold text-blue-tint transition-colors hover:text-white">True Webmaster</a></span>
    </div>
  </div>
</footer>
