---
import type { Lang } from "../i18n/ui";
import { useTranslations, route, PHONE_TEL, FAX_DISPLAY, SOCIAL } from "../i18n/utils";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const tagline =
  lang === "es"
    ? "Atención primaria integrada, pérdida de peso médica y rehabilitación: todo bajo un mismo techo en Tampa, Florida."
    : "Integrated primary care, medical weight loss, and rehabilitation - all under one roof in Tampa, Florida.";

const services = lang === "es"
  ? [
      { label: "Atención Primaria", href: "/es/atencion-primaria/" },
      { label: "Pérdida de Peso Médica", href: "/es/perdida-de-peso-medica/" },
      { label: "Terapia IV", href: "/es/terapia-iv/" },
      { label: "Rehabilitación", href: "/es/fisioterapia/" },
      { label: "Telemedicina", href: "/es/atencion-primaria/telemedicina/" },
    ]
  : [
      { label: "Primary Care", href: "/primary-care/" },
      { label: "Medical Weight Loss", href: "/medical-weight-loss/" },
      { label: "IV Therapy", href: "/iv-therapy/" },
      { label: "Rehabilitation", href: "/physical-rehabilitation/" },
      { label: "Telemedicine", href: "/primary-care/telemedicine/" },
    ];

const company = lang === "es"
  ? [
      { label: "Acerca de Nosotros", href: "/es/acerca-de-nosotros/" },
      { label: "Blog", href: "/es/blog-de-noticias/" },
      { label: "Contacto", href: "/es/contacto/" },
      { label: t("footer.hipaa"), href: route(lang, "hipaa") },
      { label: t("footer.privacy"), href: route(lang, "privacy") },
    ]
  : [
      { label: "About Us", href: "/about-us/" },
      { label: "Blog", href: "/news-blog/" },
      { label: "Contact", href: "/contact/" },
      { label: t("footer.hipaa"), href: route(lang, "hipaa") },
      { label: t("footer.privacy"), href: route(lang, "privacy") },
    ];

const year = 2026;
const hoursLines = t("footer.hours").split("\n");
const companyTitle = lang === "es" ? "Empresa" : "Company";
const linkCls = "text-[14px] text-footer-text transition-colors hover:text-white";
---

<footer class="bg-footer-bg text-footer-text">
  <div class="shell grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <span class="inline-flex rounded-md bg-white p-2.5">
        <img src="/images/logo.webp" width="120" height="60" alt="Palm Wellness Center" class="h-[46px] w-auto" loading="lazy" />
      </span>
      <p class="mt-5 max-w-[34ch] text-[14px] leading-relaxed">{tagline}</p>
      <div class="mt-5 flex gap-3">
        <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-11 w-11 items-center justify-center rounded-full bg-[#1e3e63] text-white transition-colors hover:bg-[#265083]">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0022 12z"/></svg>
        </a>
        <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-11 w-11 items-center justify-center rounded-full bg-[#1e3e63] text-white transition-colors hover:bg-[#265083]">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 01-1.38-.9 3.7 3.7 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 1.8c-3.15 0-3.5.01-4.74.07-1.14.05-1.76.24-2.17.4-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.16.41-.35 1.03-.4 2.17-.06 1.24-.07 1.59-.07 4.74s.01 3.5.07 4.74c.05 1.14.24 1.76.4 2.17.21.55.47.94.88 1.35.41.41.8.67 1.35.88.41.16 1.03.35 2.17.4 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c1.14-.05 1.76-.24 2.17-.4.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.16-.41.35-1.03.4-2.17.06-1.24.07-1.59.07-4.74s-.01-3.5-.07-4.74c-.05-1.14-.24-1.76-.4-2.17a3.6 3.6 0 00-.88-1.35 3.6 3.6 0 00-1.35-.88c-.41-.16-1.03-.35-2.17-.4-1.24-.06-1.59-.07-4.74-.07zm0 3.06a4.98 4.98 0 110 9.96 4.98 4.98 0 010-9.96zm0 8.22a3.24 3.24 0 100-6.48 3.24 3.24 0 000 6.48zm6.34-8.42a1.16 1.16 0 11-2.32 0 1.16 1.16 0 012.32 0z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <h3 class="mb-5 text-[16px] text-white">{t("footer.services")}</h3>
      <ul class="flex flex-col gap-3">
        {services.map((s) => (
          <li><a href={s.href} class={linkCls}>{s.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mb-5 text-[16px] text-white">{t("footer.contact")}</h3>
      <ul class="flex flex-col gap-3 text-[14px]">
        <li>1004 W Linebaugh Ave Ste A,<br />Tampa, FL 33612</li>
        <li><a href={PHONE_TEL} class={linkCls}>{t("cta.phone")}</a></li>
        <li>{FAX_DISPLAY}</li>
        <li>{hoursLines.map((l, i) => (<>{i > 0 && <br />}{l}</>))}</li>
        <li>{t("footer.licensesLabel")}<br />{t("footer.licenses")}</li>
      </ul>
    </div>

    <div>
      <h3 class="mb-5 text-[16px] text-white">{companyTitle}</h3>
      <ul class="flex flex-col gap-3">
        {company.map((c) => (
          <li><a href={c.href} class={linkCls}>{c.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="shell flex flex-col items-center justify-between gap-2 py-4 text-[13px] text-footer-muted sm:flex-row">
      <span>© {year} {t("footer.copyright")}</span>
      <span>{lang === "es" ? "Atención bilingüe · English / Español" : "Bilingual care · English / Español"}</span>
    </div>
  </div>
</footer>
