---
import type { Lang } from "../i18n/ui";
import { APPOINTMENT_URL, PHONE_TEL, route } from "../i18n/utils";
import Icon from "./Icon.astro";
import PostTableOfContents from "./blog/PostTableOfContents.astro";
import PostShare from "./blog/PostShare.astro";
import PostRecent from "./blog/PostRecent.astro";
import { getBlogRecentPosts } from "../data/blogArchive";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  lang: Lang;
  title: string;
  date?: Date | string;
  updatedDate?: Date | string;
  description?: string;
  image?: string;
  /** Filename slug, used to exclude this post from "Recent Posts". */
  slug?: string;
  headings?: Heading[];
  Content: any;
}

const { lang, title, date, updatedDate, description, image, slug, headings = [], Content } =
  Astro.props;

const content = {
  en: {
    home: "Home",
    blog: "News & Blog",
    published: "Published",
    updated: "Updated",
    byline: "By Palm Wellness Center",
    tocLabel: "Table of Contents",
    shareLabel: "Share",
    copyLabel: "Copy link",
    copiedLabel: "Link copied",
    emailLabel: "Share by email",
    recentHeading: "Recent Posts",
    readMore: "Read More",
    backToBlog: "Back to Blog",
    ctaHeading: "Ready to feel better?",
    ctaBody: "Schedule your visit at Palm Wellness Center today.",
    book: "Book an appointment",
    call: "(813) 443-5370",
  },
  es: {
    home: "Inicio",
    blog: "Noticias y Blog",
    published: "Publicado",
    updated: "Actualizado",
    byline: "Por Palm Wellness Center",
    tocLabel: "Tabla de contenidos",
    shareLabel: "Compartir",
    copyLabel: "Copiar enlace",
    copiedLabel: "Enlace copiado",
    emailLabel: "Compartir por correo",
    recentHeading: "Publicaciones Recientes",
    readMore: "Leer más",
    backToBlog: "Volver al Blog",
    ctaHeading: "¿Listo para sentirte mejor?",
    ctaBody: "Agenda tu cita en Palm Wellness Center hoy.",
    book: "Reservar cita",
    call: "(813) 443-5370",
  },
}[lang];

const locale = lang === "es" ? "es-ES" : "en-US";
function fmt(d?: Date | string): string {
  if (!d) return "";
  const dt = d instanceof Date ? d : new Date(String(d) + "T00:00:00");
  if (isNaN(dt.getTime())) return "";
  return dt.toLocaleDateString(locale, {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
}
function iso(d?: Date | string): string {
  if (!d) return "";
  if (d instanceof Date) return d.toISOString().slice(0, 10);
  return String(d);
}

const dateStr = fmt(date);
const updatedStr = updatedDate && fmt(updatedDate) !== dateStr ? fmt(updatedDate) : "";
const blogHref = route(lang, "blog");
const homeHref = lang === "es" ? "/es/inicio/" : "/";
const bookAttrs = { target: "_blank", rel: "noopener" } as const;
const hover = "hover-lift";
const shareUrl = Astro.url.href;

// Every legacy post ends with the same boilerplate block ("Related posts" then
// "Palm Wellness Center / Transportation / Services / Contact"). Stop the table
// of contents at the first of those headings so it only lists real sections.
const LEGACY_TAIL =
  /^(related posts|publicaciones relacionadas|palm wellness center|transportation available|transporte disponible)$/i;
const tocItems: { id: string; label: string; depth: number }[] = [];
for (const heading of headings) {
  if (heading.depth === 2 && LEGACY_TAIL.test(heading.text.trim())) break;
  if (heading.depth === 2) tocItems.push({ id: heading.slug, label: heading.text, depth: 2 });
}

const recentPosts = await getBlogRecentPosts(lang, { excludeSlug: slug, limit: 5 });
---

<article>
  <div class="shell pt-14 pb-8 sm:pt-16 lg:pt-24 lg:pb-12">
    <nav class="text-[13px] text-muted" aria-label="Breadcrumb">
      <a href={homeHref} class="hover:text-blue">{content.home}</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <a href={blogHref} class="hover:text-blue">{content.blog}</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span aria-current="page" class="text-ink">{title}</span>
    </nav>

    <div class="mt-6 grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-14">
      <div class="min-w-0">
        <div class="flex flex-col gap-4">
          <h1 class="font-titles text-[30px] leading-[1.12] text-ink sm:text-[38px] lg:text-[44px]">
            {title}
          </h1>
          {description && (
            <p class="max-w-[68ch] text-[17px] leading-[1.6] text-body sm:text-[18px]">
              {description}
            </p>
          )}
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[14px] text-muted">
            {dateStr && (
              <span>
                {content.published}: <time datetime={iso(date)}>{dateStr}</time>
              </span>
            )}
            {updatedStr && (
              <span>
                · {content.updated}: <time datetime={iso(updatedDate)}>{updatedStr}</time>
              </span>
            )}
            <span class="text-ink">· {content.byline}</span>
          </div>
          <PostShare
            title={title}
            url={shareUrl}
            shareLabel={content.shareLabel}
            copyLabel={content.copyLabel}
            copiedLabel={content.copiedLabel}
            emailLabel={content.emailLabel}
          />
        </div>

        {image && (
          <figure class="mt-8 overflow-hidden rounded-lg">
            <img
              src={image}
              alt={title}
              width="1000"
              height="563"
              fetchpriority="high"
              decoding="async"
              class="aspect-[16/9] w-full object-cover"
            />
          </figure>
        )}

        <div class="mt-8">
          <PostTableOfContents items={tocItems} label={content.tocLabel} />
        </div>

        <div class="prose mt-8 max-w-none">
          <Content />
        </div>

        <div class="mt-12 rounded-lg bg-blue-deep p-8 text-center text-white sm:p-10">
          <h2 class="font-titles text-[22px] leading-[1.2] text-white sm:text-[26px]">
            {content.ctaHeading}
          </h2>
          <p class="mx-auto mt-2 max-w-[560px] text-[15px] leading-[1.6] text-blue-tint">
            {content.ctaBody}
          </p>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
            <a
              href={APPOINTMENT_URL}
              {...bookAttrs}
              class={`inline-flex items-center gap-2 rounded-md bg-white px-7 py-3.5 font-bold text-blue-deep hover:bg-blue-pale ${hover}`}
            >
              <Icon name="calendar-check" class="h-[18px] w-[18px]" />{content.book}
            </a>
            <a
              href={PHONE_TEL}
              class={`inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue-tint px-6 py-3.5 font-bold text-white hover:bg-white/10 ${hover}`}
            >
              <Icon name="phone" class="h-[18px] w-[18px]" />{content.call}
            </a>
          </div>
        </div>

        <div class="mt-8">
          <a
            href={blogHref}
            class="inline-flex items-center gap-1.5 text-[15px] font-semibold text-blue hover:text-green-dark"
          >
            <Icon name="arrow" class="h-4 w-4 rotate-180" />{content.backToBlog}
          </a>
        </div>
      </div>

      <aside class="mt-12 lg:mt-0" aria-label={content.recentHeading}>
        <PostRecent
          posts={recentPosts.map((p) => ({
            title: p.title,
            url: p.url,
            description: p.description,
            heroImage: p.heroImage,
          }))}
          heading={content.recentHeading}
          readMore={content.readMore}
        />
      </aside>
    </div>
  </div>
</article>

<style>
  /* Article body headings stay dark charcoal (readability) and keep the sticky
     header from covering the anchor target when the TOC links are used. */
  :global(.prose h2),
  :global(.prose h3) {
    color: var(--color-ink);
    scroll-margin-top: 96px;
  }
</style>
