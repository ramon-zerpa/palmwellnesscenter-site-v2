---
import type { Lang } from "../i18n/ui";
import { useTranslations, route, APPOINTMENT_URL, PHONE_TEL } from "../i18n/utils";
import Icon from "./Icon.astro";
import { getCollection } from "astro:content";

interface Props {
  lang: Lang; title: string; date?: Date | string; image?: string; Content: any;
  /** Slug of the current post, used to exclude it from "Recent Posts". */
  slug?: string;
}
const { lang, title, date, image, Content, slug } = Astro.props;
const t = useTranslations(lang);
const blogHref = route(lang, "blog");

function fmtDate(d?: Date | string) {
  if (!d) return "";
  const dt = d instanceof Date ? d : new Date(String(d) + "T00:00:00");
  if (isNaN(dt.getTime())) return "";
  return dt.toLocaleDateString(lang === "es" ? "es-ES" : "en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
}
const isoDate = date ? (date instanceof Date ? date.toISOString().slice(0, 10) : String(date)) : "";
const dateStr = fmtDate(date);

/* ---- Recent Posts sidebar (same lang, newest first, excluding current) ---- */
const allPosts = await getCollection("blog", (e) => e.data.lang === lang && !e.data.draft);
const recentPosts = allPosts
  .map((e) => {
    const s = String(e.id).split("/").pop()!;
    const url = e.data.path || (e.data.lang === "en" ? `/${s}/` : `/es/${s}/`);
    return { ...e.data, slug: s, url };
  })
  .filter((p) => (slug ? p.slug !== slug : p.title !== title))
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime())
  .slice(0, 5);
function recentExcerpt(p: any): string {
  const txt = p.description || "";
  return txt.length > 120 ? txt.slice(0, 117) + "…" : txt;
}
const recentHeading = lang === "es" ? "Publicaciones Recientes" : "Recent Posts";
---

<article>
  <header class="bg-bg-alt">
    <div class="container max-w-4xl py-10 lg:py-12">
      <nav class="text-[13px] text-muted" aria-label="Breadcrumb">
        <a href={lang === "en" ? "/" : "/es/inicio/"} class="hover:text-blue">{lang === "es" ? "Inicio" : "Home"}</a>
        <span class="mx-1.5">/</span>
        <a href={blogHref} class="hover:text-blue">Blog</a>
      </nav>
      <h1 class="mt-3 text-3xl leading-tight text-blue sm:text-4xl">{title}</h1>
      {dateStr && <p class="mt-3 text-[14px] text-muted">{t("blog.published")}: <time datetime={isoDate}>{dateStr}</time></p>}
    </div>
  </header>

  <div class="container max-w-6xl py-10 lg:grid lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start lg:gap-12">
    <div class="min-w-0">
      {image && (
        <img src={image} alt={title} width="1000" height="560" fetchpriority="high" decoding="async" class="mb-8 w-full rounded-lg object-cover" />
      )}

      <div class="prose">
        <Content />
      </div>

      <div class="mt-12 rounded-lg bg-blue-deep p-8 text-center text-white">
        <p class="text-xl font-bold" style="font-family:var(--font-titles)">
          {lang === "es" ? "¿Listo para sentirte mejor?" : "Ready to feel better?"}
        </p>
        <p class="mt-2 text-white/85">
          {lang === "es" ? "Agenda tu cita en Palm Wellness Center hoy." : "Schedule your visit at Palm Wellness Center today."}
        </p>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
          <a href={APPOINTMENT_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-green px-7 py-3 font-bold text-white transition-colors hover:bg-green-dark"><Icon name="calendar" class="h-4 w-4" />{t("cta.request")}</a>
          <a href={PHONE_TEL} class="inline-flex items-center gap-2 rounded-full border-2 border-white/70 px-7 py-2.5 font-bold text-white transition-colors hover:bg-white hover:text-blue-deep"><Icon name="phone" class="h-4 w-4" />{t("cta.phone")}</a>
        </div>
      </div>

      <div class="mt-8">
        <a href={blogHref} class="inline-flex items-center gap-1.5 text-[15px] font-semibold text-blue hover:text-green-dark">← {t("blog.backToBlog")}</a>
      </div>
    </div>

    {recentPosts.length > 0 && (
      <aside class="mt-12 lg:mt-0" aria-label={recentHeading}>
        <h2 class="border-b-2 border-line pb-2 text-xl text-blue" style="font-family:var(--font-titles)">{recentHeading}</h2>
        <ul class="mt-5 space-y-7">
          {recentPosts.map((p) => (
            <li>
              <a href={p.url} class="text-[15px] font-bold leading-snug text-blue hover:text-green-dark" style="font-family:var(--font-titles)">{p.title}</a>
              {p.heroImage && (
                <a href={p.url} class="mt-2 block overflow-hidden rounded-md">
                  <img src={p.heroImage} alt={p.title} width="320" height="180" loading="lazy" decoding="async" class="aspect-[16/9] w-full object-cover" />
                </a>
              )}
              {recentExcerpt(p) && <p class="mt-2 text-[13px] leading-relaxed text-body">{recentExcerpt(p)}</p>}
              <a href={p.url} class="mt-2 inline-flex items-center rounded bg-green px-3 py-1.5 text-[12px] font-semibold uppercase tracking-wide text-white transition-colors hover:bg-green-dark">{t("blog.readMore")}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</article>

<style>
  /* Article body headings render in dark charcoal, matching the source post.
     The base layer sets all h1–h6 to brand blue; the markdown rendered inside
     <Content /> is not Astro-scoped, so :global() is required to reach it.
     Scoped to .prose (used only by this component), so the site-wide heading
     color is untouched — only the article body changes. */
  :global(.prose h2),
  :global(.prose h3) {
    color: var(--color-ink);
  }
</style>
