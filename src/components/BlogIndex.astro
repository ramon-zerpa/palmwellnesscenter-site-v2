---
import type { Lang } from "../i18n/ui";
import { APPOINTMENT_URL, PHONE_TEL } from "../i18n/utils";
import Icon from "./Icon.astro";
import {
  getBlogPaginationItems,
  type BlogArchivePost,
  type BlogPaginationItem,
} from "../data/blogArchive";

interface Props {
  lang: Lang;
  posts: BlogArchivePost[];
  currentPage: number;
  totalPages: number;
  totalPosts: number;
  basePath: string;
}

const { lang, posts, currentPage, totalPages, totalPosts, basePath } = Astro.props;

const content = {
  en: {
    eyebrow: "Health & Recovery Blog",
    title: "Health News and Advice Blog",
    lead: "Welcome to the Palm Wellness Center blog, where you'll find valuable information about physical rehabilitation for patients and visitors who want to make a positive change in their lives.",
    browse: "Browse the latest guides",
    listingEyebrow: "Latest articles",
    listingHeading: "Latest health guides",
    listingIntro:
      "Practical answers about recovery, chiropractic care, physical therapy, massage, and injury prevention so you can understand the next step for your health.",
    readMore: "Read guide",
    guidesAvailable: (n: number) => `${n} ${n === 1 ? "guide" : "guides"} available`,
    previous: "Previous",
    next: "Next",
    pageOf: (cur: number, total: number) => `Page ${cur} of ${total}`,
    paginationLabel: "Blog pagination",
    goPrev: "Go to previous page",
    goNext: "Go to next page",
    goToPage: (n: number) => `Go to page ${n}`,
    breadcrumbHome: "Home",
    ctaHeading: "Need advice tailored to your health?",
    ctaBody:
      "Our team can help you turn general guidance into a clear next step for your recovery and wellness.",
    book: "Book an appointment",
    call: "(813) 443-5370",
  },
  es: {
    eyebrow: "Blog de Salud y Recuperación",
    title: "Blog de Noticias y Consejos de Salud",
    lead: "Bienvenido al blog de Palm Wellness Center, donde encontrarás información valiosa sobre rehabilitación física para pacientes y visitantes que desean lograr un cambio positivo en sus vidas.",
    browse: "Ver las últimas guías",
    listingEyebrow: "Artículos recientes",
    listingHeading: "Guías de salud recientes",
    listingIntro:
      "Respuestas prácticas sobre recuperación, quiropráctica, fisioterapia, masajes y prevención de lesiones para que entiendas el siguiente paso para tu salud.",
    readMore: "Leer guía",
    guidesAvailable: (n: number) => `${n} ${n === 1 ? "guía" : "guías"} disponibles`,
    previous: "Anterior",
    next: "Siguiente",
    pageOf: (cur: number, total: number) => `Página ${cur} de ${total}`,
    paginationLabel: "Paginación del blog",
    goPrev: "Ir a la página anterior",
    goNext: "Ir a la página siguiente",
    goToPage: (n: number) => `Ir a la página ${n}`,
    breadcrumbHome: "Inicio",
    ctaHeading: "¿Necesitas orientación para tu salud?",
    ctaBody:
      "Nuestro equipo puede ayudarte a convertir la información general en un siguiente paso claro para tu recuperación y bienestar.",
    book: "Reservar cita",
    call: "(813) 443-5370",
  },
}[lang];

const homeHref = lang === "es" ? "/es/inicio/" : "/";
const bookAttrs = { target: "_blank", rel: "noopener" } as const;
const hover = "hover-lift";

function fmtDate(d: Date) {
  return d.toLocaleDateString(lang === "es" ? "es-ES" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
}

function excerpt(post: BlogArchivePost): string {
  const txt = post.description || "";
  return txt.length > 150 ? txt.slice(0, 147) + "…" : txt;
}

const pageHref = (page: number) => (page === 1 ? basePath : `${basePath}${page}/`);
const paginationItems: BlogPaginationItem[] = getBlogPaginationItems(currentPage, totalPages);
const eyebrowCls =
  "inline-flex w-fit items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-tint";
const directionCls = `inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-md border border-line bg-white px-4 text-[14px] font-bold text-blue hover:border-blue hover:bg-blue hover:text-white ${hover}`;
const directionDisabledCls =
  "pointer-events-none inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-md border border-line bg-white px-4 text-[14px] font-bold text-body/40";
---

<!-- HERO (full-bleed) -->
<section class="relative isolate overflow-hidden bg-blue-deep">
  <img
    src="/images/medical-office-chiropractor-rehabilitating-patient-back.webp"
    width="1920"
    height="1080"
    alt=""
    aria-hidden="true"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover object-[62%_center]"
  />
  <div
    class="absolute inset-0 bg-gradient-to-r from-blue-deep via-blue-deep/92 to-blue-deep/55"
    aria-hidden="true"
  ></div>
  <div class="shell relative flex flex-col gap-5 py-16 lg:py-24">
    <nav class="text-[13px] text-blue-tint" aria-label="Breadcrumb">
      <a href={homeHref} class="text-white hover:text-blue-tint">{content.breadcrumbHome}</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span aria-current="page">{content.title}</span>
    </nav>
    <span class={eyebrowCls}>
      <Icon name="newspaper" class="h-3.5 w-3.5" />{content.eyebrow}
    </span>
    <h1 class="max-w-3xl font-titles text-[32px] leading-[1.08] text-white sm:text-[40px] lg:text-[48px]">
      {content.title}
    </h1>
    <p class="max-w-2xl text-[16px] leading-[1.6] text-blue-tint sm:text-[17px]">{content.lead}</p>
    <a
      href="#latest"
      class={`mt-1 inline-flex w-fit items-center gap-2 rounded-md bg-white px-6 py-3.5 font-bold text-blue-deep hover:bg-blue-pale ${hover}`}
    >
      <Icon name="book-open" class="h-[18px] w-[18px]" />{content.browse}
    </a>
  </div>
</section>

<!-- LISTING -->
<section id="latest" class="scroll-mt-24 bg-bg-alt">
  <div class="shell flex flex-col gap-10 py-16 lg:py-20">
    <div class="grid items-end gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div class="flex flex-col gap-4">
        <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-blue-pale px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.1em] text-blue-deep">
          {content.listingEyebrow}
        </span>
        <h2 class="font-titles text-[26px] leading-[1.15] text-ink sm:text-[30px] lg:text-[34px]">
          {content.listingHeading}
        </h2>
      </div>
      <div class="flex flex-col items-start gap-4">
        <p class="max-w-[60ch] text-[16px] leading-[1.6] text-body">{content.listingIntro}</p>
        <span class="inline-flex items-center rounded-full border border-line bg-white px-3 py-1.5 text-[12px] font-bold uppercase tracking-[0.06em] text-blue-deep">
          {content.guidesAvailable(totalPosts)}
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <article class={`group flex flex-col overflow-hidden rounded-lg border border-line bg-white ${hover}`}>
          {p.heroImage && (
            <a href={p.url} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
              <img
                src={p.heroImage}
                alt={p.title}
                width="480"
                height="300"
                loading="lazy"
                decoding="async"
                class="aspect-[16/10] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              />
            </a>
          )}
          <div class="flex flex-1 flex-col p-6">
            <time
              datetime={p.pubDate.toISOString().slice(0, 10)}
              class="text-[12px] font-bold uppercase tracking-[0.06em] text-muted"
            >
              {fmtDate(p.pubDate)}
            </time>
            <h3 class="mt-2 font-titles text-[19px] leading-[1.25] text-ink">
              <a href={p.url} class="hover:text-blue">{p.title}</a>
            </h3>
            <p class="mt-2 flex-1 text-[14.5px] leading-[1.6] text-body">{excerpt(p)}</p>
            <a
              href={p.url}
              class="mt-4 inline-flex min-h-11 items-center gap-1.5 rounded-md border-[1.5px] border-blue px-4 text-[14px] font-bold text-blue hover:bg-blue hover:text-white"
            >
              {content.readMore}<Icon name="arrow" class="h-4 w-4" />
            </a>
          </div>
        </article>
      ))}
    </div>

    {totalPages > 1 && (
      <nav class="mt-2 flex flex-col items-center justify-center gap-4 sm:flex-row" aria-label={content.paginationLabel}>
        {currentPage > 1 && (
          <a href={pageHref(currentPage - 1)} class={directionCls} aria-label={content.goPrev}>
            <Icon name="chevron-left" class="h-4 w-4" />
            <span class="hidden sm:inline">{content.previous}</span>
          </a>
        )}
        {currentPage <= 1 && (
          <span class={directionDisabledCls}>
            <Icon name="chevron-left" class="h-4 w-4" />
            <span class="hidden sm:inline">{content.previous}</span>
          </span>
        )}

        <span class="text-[14px] font-bold text-ink sm:hidden" aria-current="page">
          {content.pageOf(currentPage, totalPages)}
        </span>

        <div class="hidden flex-wrap items-center justify-center gap-2 sm:flex">
          {paginationItems.map((item: BlogPaginationItem) =>
            item.type === "ellipsis" ? (
              <span class="flex h-11 min-w-11 items-center justify-center text-body/70" aria-hidden="true">
                …
              </span>
            ) : item.page === currentPage ? (
              <span
                class="flex h-11 min-w-11 items-center justify-center rounded-md border border-blue-deep bg-blue-deep px-3 text-[14px] font-bold text-white"
                aria-current="page"
              >
                {item.page}
              </span>
            ) : (
              <a
                href={pageHref(item.page)}
                class={`flex h-11 min-w-11 items-center justify-center rounded-md border border-line bg-white px-3 text-[14px] font-bold text-blue hover:border-blue hover:bg-blue hover:text-white ${hover}`}
                aria-label={content.goToPage(item.page)}
              >
                {item.page}
              </a>
            ),
          )}
        </div>

        {currentPage < totalPages && (
          <a href={pageHref(currentPage + 1)} class={directionCls} aria-label={content.goNext}>
            <span class="hidden sm:inline">{content.next}</span>
            <Icon name="chevron-right" class="h-4 w-4" />
          </a>
        )}
        {currentPage >= totalPages && (
          <span class={directionDisabledCls}>
            <span class="hidden sm:inline">{content.next}</span>
            <Icon name="chevron-right" class="h-4 w-4" />
          </span>
        )}
      </nav>
    )}
  </div>
</section>

<!-- CTA -->
<section class="bg-blue-deep">
  <div class="shell flex flex-col items-center gap-4 py-16 text-center lg:py-20">
    <h2 class="max-w-[820px] font-titles text-[26px] leading-[1.15] text-white sm:text-[30px] lg:text-[34px]">
      {content.ctaHeading}
    </h2>
    <p class="max-w-[640px] text-[16px] leading-[1.6] text-blue-tint sm:text-[17px]">{content.ctaBody}</p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      <a
        href={APPOINTMENT_URL}
        {...bookAttrs}
        class={`inline-flex items-center gap-2 rounded-md bg-white px-7 py-3.5 font-bold text-blue-deep hover:bg-blue-pale ${hover}`}
      >
        <Icon name="calendar-check" class="h-[18px] w-[18px]" />{content.book}
      </a>
      <a
        href={PHONE_TEL}
        class={`inline-flex items-center gap-2 rounded-md border-[1.5px] border-blue-tint px-6 py-3.5 font-bold text-white hover:bg-white/10 ${hover}`}
      >
        <Icon name="phone" class="h-[18px] w-[18px]" />{content.call}
      </a>
    </div>
  </div>
</section>
