---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import type { BlogArchivePost } from "../data/blogArchive";

interface Props {
  lang: Lang;
  posts: BlogArchivePost[];
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { lang, posts, currentPage, totalPages, basePath } = Astro.props;
const t = useTranslations(lang);

function fmtDate(d?: Date) {
  if (!d) return "";
  return d.toLocaleDateString(lang === "es" ? "es-ES" : "en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
}

function excerpt(p: BlogArchivePost): string {
  const txt = p.description || "";
  return txt.length > 160 ? txt.slice(0, 157) + "..." : txt;
}

const heading = lang === "es" ? "Blog de Noticias y Consejos de Salud" : "Health News and Advice Blog";
const heroSubtext = lang === "es"
  ? "Bienvenido al blog de Palm Wellness Center, donde encontrara informacion valiosa sobre rehabilitacion fisica para pacientes y visitantes que desean lograr un cambio positivo en sus vidas."
  : "Welcome to the Palm Wellness Center blog, where you'll find valuable information about physical rehabilitation for patients and visitors who want to make a positive change in their lives.";

const pageHref = (page: number) => page === 1 ? basePath : `${basePath}${page}/`;
const previousHref = currentPage > 1 ? pageHref(currentPage - 1) : "";
const nextHref = currentPage < totalPages ? pageHref(currentPage + 1) : "";

function paginationItems() {
  if (totalPages <= 7) {
    return Array.from({ length: totalPages }, (_, index) => ({ type: "page", page: index + 1, key: `page-${index + 1}` }));
  }

  const pages = new Set([1, totalPages, currentPage - 1, currentPage, currentPage + 1]);
  const validPages = Array.from(pages)
    .filter((page) => page >= 1 && page <= totalPages)
    .sort((a, b) => a - b);

  const items: Array<{ type: "page" | "ellipsis"; page?: number; key: string }> = [];
  validPages.forEach((page, index) => {
    const previous = validPages[index - 1];
    if (previous && page - previous > 1) {
      items.push({ type: "ellipsis", key: `ellipsis-${previous}-${page}` });
    }
    items.push({ type: "page", page, key: `page-${page}` });
  });
  return items;
}

const pages = paginationItems();
---

<section class="relative overflow-hidden bg-blue-deep">
  <img
    src="/images/medical-office-chiropractor-rehabilitating-patient-back.webp"
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-blue-deep/80"></div>
  <div class="container relative py-16 text-center lg:py-20">
    <h1 class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">{heading}</h1>
    <p class="mx-auto mt-4 max-w-3xl text-[15px] leading-relaxed text-white/80">{heroSubtext}</p>
  </div>
</section>

<section class="bg-white">
  <div class="container py-14">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <article class="group flex flex-col overflow-hidden rounded-lg border border-line bg-white transition-shadow hover:shadow-md" data-aos="fade-up">
          {p.heroImage && (
            <a href={p.url} class="block overflow-hidden">
              <img src={p.heroImage} alt={p.title} width="400" height="240" loading="lazy" decoding="async" class="aspect-[5/3] w-full object-cover transition-transform duration-300 group-hover:scale-105" />
            </a>
          )}
          <div class="flex flex-1 flex-col p-5">
            {p.pubDate && <time datetime={p.pubDate.toISOString().slice(0,10)} class="text-[12px] font-semibold uppercase tracking-wide text-green-dark">{fmtDate(p.pubDate)}</time>}
            <h2 class="mt-2 text-lg leading-snug text-blue"><a href={p.url} class="hover:text-green-dark">{p.title}</a></h2>
            <p class="mt-2 flex-1 text-[14px] leading-relaxed text-body">{excerpt(p)}</p>
            <a href={p.url} class="mt-3 inline-flex items-center gap-1 text-[14px] font-semibold text-blue hover:text-green-dark">{t("blog.readMore")} -&gt;</a>
          </div>
        </article>
      ))}
    </div>

    {totalPages > 1 && (
      <nav class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row" aria-label={lang === "es" ? "Paginacion del blog" : "Blog pagination"}>
        <a
          href={previousHref || undefined}
          aria-disabled={!previousHref}
          class:list={[
            "inline-flex min-h-11 items-center justify-center rounded border px-4 text-[14px] font-bold transition-colors",
            previousHref ? "border-blue text-blue hover:bg-blue hover:text-white" : "pointer-events-none border-line text-body/40",
          ]}
        >
          {lang === "es" ? "Anterior" : "Previous"}
        </a>
        <div class="flex flex-wrap items-center justify-center gap-2">
          {pages.map((item) => (
            item.type === "ellipsis" ? (
              <span class="flex h-10 min-w-10 items-center justify-center px-1 text-body/70" aria-hidden="true">...</span>
            ) : (
              <a
                href={pageHref(item.page!)}
                aria-current={item.page === currentPage ? "page" : undefined}
                class:list={[
                  "flex h-10 min-w-10 items-center justify-center rounded border px-3 text-[14px] font-bold transition-colors",
                  item.page === currentPage
                    ? "border-green bg-green text-white"
                    : "border-line text-blue hover:border-blue hover:bg-blue hover:text-white",
                ]}
              >
                {item.page}
              </a>
            )
          ))}
        </div>
        <a
          href={nextHref || undefined}
          aria-disabled={!nextHref}
          class:list={[
            "inline-flex min-h-11 items-center justify-center rounded border px-4 text-[14px] font-bold transition-colors",
            nextHref ? "border-blue text-blue hover:bg-blue hover:text-white" : "pointer-events-none border-line text-body/40",
          ]}
        >
          {lang === "es" ? "Siguiente" : "Next"}
        </a>
      </nav>
    )}
  </div>
</section>
