---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PrimaryCarePage from "../../components/pages/PrimaryCarePage.astro";

const path = "/primary-care/";
---

<Layout
  lang="en"
  path={path}
  title="Primary Care in Tampa - Palm Wellness Center"
  description="Integrated primary care in Tampa with chronic condition management, preventive care, and telemedicine. Extended visits, bilingual providers, and a membership from $99, then $39/month."
>
  <TopBar lang="en" />
  <Header lang="en" path={path} />
  <main id="main">
    <PrimaryCarePage lang="en" />
  </main>
  <Footer lang="en" />
</Layout>
