---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ContactPage from "../../components/ContactPage.astro";
const lang = "es";
const path = "/es/contacto/";
---
<Layout lang={lang} path={path}
  title="Contacto - Palm Wellness Center in Tampa Florida"
  description="Contacta a Palm Wellness Center en Tampa, FL. Llama al (813) 443-5370 o envíanos un mensaje para agendar quiropráctica, fisioterapia, atención primaria o pérdida de peso médica.">
  <TopBar lang={lang} />
  <Header lang={lang} path={path} />
  <main id="main"><ContactPage lang={lang} /></main>
  <Footer lang={lang} />
</Layout>
