---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import WhiplashTreatmentPage from "../../components/pages/WhiplashTreatmentPage.astro";

const path = "/es/tratamiento-latigazo-cervical-tampa/";
---

<Layout
  lang="es"
  path={path}
  title="Tratamiento de Latigazo Cervical en Tampa, FL | Dolor de Cuello"
  description="¿Dolor o rigidez de cuello después de un accidente de auto? Reciba tratamiento de latigazo cervical en Tampa enfocado en movilidad, alivio y recuperación."
>
  <TopBar lang="es" />
  <Header lang="es" path={path} />
  <main id="main">
    <WhiplashTreatmentPage lang="es" />
  </main>
  <Footer lang="es" />
</Layout>
