---
import Layout from "../../../layouts/Layout.astro";
import TopBar from "../../../components/TopBar.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import PrimaryCarePage from "../../../components/pages/PrimaryCarePage.astro";

const path = "/es/atencion-primaria/";
---

<Layout
  lang="es"
  path={path}
  title="Atención Primaria en Tampa - Palm Wellness Center"
  description="Atención primaria integrada en Tampa con manejo de enfermedades crónicas, atención preventiva y telemedicina. Consultas extendidas, proveedores bilingües y membresía desde $99, luego $39/mes."
>
  <TopBar lang="es" />
  <Header lang="es" path={path} />
  <main id="main">
    <PrimaryCarePage lang="es" />
  </main>
  <Footer lang="es" />
</Layout>
