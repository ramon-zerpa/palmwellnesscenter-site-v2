---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogIndex from "../../components/BlogIndex.astro";
import { getBlogArchivePage } from "../../data/blogArchive";

const lang = "es";
const path = "/es/blog-de-noticias/";
const archive = await getBlogArchivePage(lang);
---
<Layout lang={lang} path={path}
  title="Blog de Noticias - Palm Wellness Center"
  description="Noticias de salud, consejos de recuperacion y bienestar de Palm Wellness Center en Tampa - quiropractica, fisioterapia, masajes, ultrasonido y recuperacion de lesiones.">
  <TopBar lang={lang} />
  <Header lang={lang} path={path} />
  <main id="main"><BlogIndex lang={lang} basePath={path} {...archive} /></main>
  <Footer lang={lang} />
</Layout>
