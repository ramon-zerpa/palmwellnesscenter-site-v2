---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CityCarAccidentRehabPage from "../../components/pages/CityCarAccidentRehabPage.astro";

const path = "/car-accident-rehabilitation/carrollwood/";
---

<Layout
  lang="en"
  path={path}
  title="Auto Accident Rehabilitation Carrollwood - Palm Wellness Center"
  description="Recover fast with personalized auto injury rehabilitation at Palm Wellness Center in Carrollwood. Call now to schedule chiropractic, massage, and more!"
>
  <TopBar lang="en" />
  <Header lang="en" path={path} />
  <main id="main">
    <CityCarAccidentRehabPage lang="en" city="carrollwood" />
  </main>
  <Footer lang="en" />
</Layout>
