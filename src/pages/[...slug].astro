---
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BlogPost from "../components/BlogPost.astro";
import type { Lang } from "../i18n/ui";
import { route } from "../i18n/utils";
import { getCollection, render } from "astro:content";
import { createArticleSchema, createBreadcrumbSchema } from "../lib/structured-data";

// This catch-all now only builds the blog posts (md under src/content/blog).
// The legacy rich pages and their `richpages.json` renderer were retired once
// every entry was migrated to a dedicated page or removed from the site.
export async function getStaticPaths() {
  const trim = (s: string) => s.replace(/^\/|\/$/g, "");
  const posts = await getCollection("blog");
  return posts.map((entry) => {
    const slug = String(entry.id).split("/").pop();
    const url = entry.data.path || (entry.data.lang === "en" ? `/${slug}/` : `/es/${slug}/`);
    return { params: { slug: trim(url as string) }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;
const lang: Lang = data.lang;
// Derive the URL from the file's slug + language, so the CMS editor only sets a
// slug and never a raw path.
const postSlug = String(entry.id).split("/").pop() as string;
const path: string = data.path || (lang === "en" ? `/${postSlug}/` : `/es/${postSlug}/`);
const altPath = data.altPath || undefined;
const seoTitle = data.seoTitle || data.title;
const description = data.description;
const socialDescription = data.socialDescription || description;
const og = data.heroImage;

const structuredData = [
  createArticleSchema({
    headline: data.title,
    description: description || "",
    path,
    image: data.heroImage || undefined,
    authorName: "Palm Wellness Center",
    publishedAt: data.pubDate,
    updatedAt: data.updatedDate,
  }),
  createBreadcrumbSchema([
    { name: lang === "es" ? "Inicio" : "Home", path: lang === "es" ? "/es/inicio/" : "/" },
    { name: lang === "es" ? "Noticias y Blog" : "News & Blog", path: route(lang, "blog") },
    { name: data.title, path },
  ]),
];
---

<Layout lang={lang} path={path} altPath={altPath} title={seoTitle} description={description} socialDescription={socialDescription} ogImage={og} ogType="article" structuredData={structuredData}>
  <TopBar lang={lang} />
  <Header lang={lang} path={path} altPath={altPath} />
  <main id="main">
    <BlogPost lang={lang} title={data.title} date={data.pubDate} updatedDate={data.updatedDate} description={description} image={data.heroImage} slug={postSlug} headings={headings} Content={Content} />
  </main>
  <Footer lang={lang} />
</Layout>
