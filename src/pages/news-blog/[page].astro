---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogIndex from "../../components/BlogIndex.astro";
import { getBlogArchivePage, getBlogTotalPages } from "../../data/blogArchive";

const lang = "en";
const basePath = "/news-blog/";

export async function getStaticPaths() {
  const totalPages = await getBlogTotalPages("en");
  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) }, props: { page } };
  });
}

const page = Number(Astro.props.page);
const path = `${basePath}${page}/`;
const esTotalPages = await getBlogTotalPages("es");
const altPath = page <= esTotalPages ? `/es/blog-de-noticias/${page}/` : "/es/blog-de-noticias/";
const archive = await getBlogArchivePage(lang, page);
---
<Layout lang={lang} path={path} altPath={altPath}
  title={`News Blog - Page ${page} - Palm Wellness Center`}
  description="Health news, recovery tips, and wellness advice from Palm Wellness Center in Tampa.">
  <TopBar lang={lang} />
  <Header lang={lang} path={path} altPath={altPath} />
  <main id="main"><BlogIndex lang={lang} basePath={basePath} {...archive} /></main>
  <Footer lang={lang} />
</Layout>
